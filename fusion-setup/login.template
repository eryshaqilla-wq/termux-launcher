#!/data/data/com.termux/files/usr/bin/bash
if [ $# -eq 0 ]; then
    printf "\033]0;Dashboard\007"
    printf "\033]2;Dashboard\007"
fi
# ==============================================================================
# PROJECT FUSION - ADAPTIVE LOGIN SELECTOR (ROOT / NON-ROOT COMPATIBLE)
# ==============================================================================

export PREFIX="/data/data/com.termux/files/usr"
export HOME="/data/data/com.termux/files/home"
export PATH="$HOME/.local/bin:$PREFIX/bin:$PREFIX/bin/applets:$PATH"

if [ -f "$PREFIX/etc/profile" ]; then
    . "$PREFIX/etc/profile"
fi

FUSION_DIR="$HOME/.fusion"
LINUX_CONF="$FUSION_DIR/linux_entry.sh"
LINUX_NAME_CONF="$FUSION_DIR/linux_name.txt"
HAS_LINUX_CONF="$FUSION_DIR/has_linux.txt"
LINUX_ROOTFS_CONF="$FUSION_DIR/linux_rootfs.txt"

# Cek apakah integrasi Linux diaktifkan
HAS_LINUX="1"
if [ -f "$HAS_LINUX_CONF" ]; then
    HAS_LINUX=$(cat "$HAS_LINUX_CONF" 2>/dev/null | tr -d '[:space:]')
fi

# Nama Linux jika aktif (dengan auto-detect fallback jika belum disetup)
LINUX_NAME=""
if [ -f "$LINUX_NAME_CONF" ]; then
    LINUX_NAME=$(cat "$LINUX_NAME_CONF" 2>/dev/null | head -n1 | tr -d '\r\n')
fi

# Auto-detect nama container jika kosong atau masih default generik
if [ -z "$LINUX_NAME" ] || [ "$LINUX_NAME" = "Linux" ]; then
    if command -v su >/dev/null 2>&1 && su -c "id" >/dev/null 2>&1; then
        # Cek Droidspaces container
        DS_FOUND=$(su -c "ls -1 /data/local/Droidspaces/Containers/ 2>/dev/null || ls -1 /data/local/Droidspaces/spaces/ 2>/dev/null || true" | grep -v '^\.' | head -n1)
        if [ -n "$DS_FOUND" ]; then
            LINUX_NAME="$DS_FOUND"
        elif su -c "[ -d '/data/local/nhsystem/kali-arm64' ] || [ -d '/data/local/nhsystem/kalifs' ]" 2>/dev/null; then
            LINUX_NAME="NetHunter"
        else
            LINUX_NAME="Linux"
        fi
    elif command -v proot-distro >/dev/null 2>&1; then
        PR_FOUND=$(proot-distro list 2>/dev/null | awk '/installed/ {print $2}' | head -n1)
        [ -n "$PR_FOUND" ] && LINUX_NAME="$PR_FOUND" || LINUX_NAME="PRoot"
    else
        LINUX_NAME="Linux"
    fi
fi

LINUX_ROOTFS=""
if [ -f "$LINUX_ROOTFS_CONF" ]; then
    LINUX_ROOTFS=$(cat "$LINUX_ROOTFS_CONF" 2>/dev/null | tr -d '[:space:]')
fi

# Helper Termux IPC Socket Bionic (Bebas Seccomp Bad system call)
ipc_send() {
    local cmd="$*"
    local py=""
    if command -v python3 >/dev/null 2>&1; then
        py="python3"
    elif command -v python >/dev/null 2>&1; then
        py="python"
    fi

    if [ -n "$py" ]; then
        "$py" -c "import socket,sys; s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM); s.settimeout(0.3); s.connect('\0termux_ipc'); s.sendall(sys.argv[1].encode()+b'\n'); s.close()" "$cmd" 2>/dev/null || true
    elif [ -x "$PREFIX/bin/termux-ipc" ]; then
        "$PREFIX/bin/termux-ipc" $cmd >/dev/null 2>&1
    fi
}

# JIKA ADA ARGUMEN EKSEKUSI (misal: login -c "..." atau login cmd ...):
# Langsung jalankan tanpa tertahan di menu selector
if [ "$1" = "-c" ]; then
    shift
    if [ -x "$PREFIX/bin/zsh" ]; then
        exec "$PREFIX/bin/zsh" -c "$*"
    else
        exec "$PREFIX/bin/bash" -c "$*"
    fi
fi
if [ $# -gt 0 ]; then
    if [ -x "$PREFIX/bin/bashnh" ]; then
        exec "$PREFIX/bin/bashnh" "$@"
    else
        exec "$@"
    fi
fi

# JIKA TANPA LINUX: Langsung luncurkan Termux Shell secara cepat & bersih
if [ "$HAS_LINUX" = "0" ]; then
    printf "\033]0;home\007"
    printf "\033]2;home\007"
    stty sane 2>/dev/null
    stty echo 2>/dev/null
    printf "\e[?25h"
    clear
    command -v fastfetch >/dev/null 2>&1 && fastfetch
    if [ -x "$PREFIX/bin/zsh" ]; then
        exec -a "-zsh" "$PREFIX/bin/zsh" "$@"
    else
        exec -a "-bash" "$PREFIX/bin/bash" "$@"
    fi
fi

# ==========================================
# JIKA ADA LINUX: TAMPILKAN MENU SELECTOR
# ==========================================
while true; do

    action_clean=0

    printf "\033]0;Dashboard\007"
    printf "\033]2;Dashboard\007"
    printf "\e[0m\e[r\e[?1049l\e[2J\e[3J\e[H" 
    command -v fastfetch >/dev/null 2>&1 && fastfetch

    # Auto Wakelock
    _termux_pid=$(pidof com.termux 2>/dev/null || pgrep -o -f "com.termux" 2>/dev/null || echo "$$")
    _wakelock_flag="${PREFIX:-/data/data/com.termux/files/usr}/tmp/.termux_wakelock"
    if [ ! -f "$_wakelock_flag" ] || [ "$(cat "$_wakelock_flag" 2>/dev/null)" != "$_termux_pid" ]; then
        if command -v termux-wake-lock >/dev/null 2>&1; then
            termux-wake-lock >/dev/null 2>&1
            echo "$_termux_pid" > "$_wakelock_flag" 2>/dev/null
        fi
    fi

    echo ""
    printf "Tekan \e[1;35mESC\e[0m untuk Clear RAM\n"

    selected=${selected:-1}

    trap 'printf "\e[?1000l\e[?1006l\e[?25h\033]0;home\007"; stty sane 2>/dev/null; clear; exit' INT TERM
    printf "\033]0;Dashboard\007"
    printf "\033]2;Dashboard\007"
    stty sane 2>/dev/null
    stty -echo 2>/dev/null
    printf "\e[?1000l\e[?1006l\e[?25l"
    while read -rsn1 -t 0.05 _discard; do :; done

    # Toast Notifikasi RAM
    if [ -n "$CLEAN_TOAST" ]; then
        ipc_send "TOAST $CLEAN_TOAST"
        ipc_send VIBRATE
        unset CLEAN_TOAST
    fi

    # Loop penangkap tombol
    while true; do
        lines=$(tput lines 2>/dev/null || echo 24)
        menu_start_row=$((lines - 5))

        printf "\e[%d;1H" "$menu_start_row"
        printf "\e[J"

        printf "\e[1;37mPilih System:\e[0m\n\n"

        if [ $selected -eq 1 ]; then
            printf "  \e[1;35m>\e[0m \e[1;37m1. %s\e[0m\n" "$LINUX_NAME"
        else
            printf "    \e[90m1. %s\e[0m\n" "$LINUX_NAME"
        fi

        if [ $selected -eq 2 ]; then
            printf "  \e[1;35m>\e[0m \e[1;37m2. Termux\e[0m\n\n"
        else
            printf "    \e[90m2. Termux\e[0m\n\n"
        fi

        read -rsn1 key
        case "$key" in
            $'\e')
                read -rsn1 -t 0.08 key2
                if [ "$key2" = "[" ]; then
                    read -rsn1 -t 0.08 key3
                    case "$key3" in
                        'A') [ $selected -gt 1 ] && selected=$((selected - 1)) ;;
                        'B') [ $selected -lt 2 ] && selected=$((selected + 1)) ;;
                        'C') break ;; # Kanan = Enter
                    esac
                elif [ -z "$key2" ]; then
                    action_clean=1
                    break
                fi
                ;;
            "1") selected=1; break ;;
            "2") selected=2; break ;;
            "c"|"C") action_clean=1; break ;;
            "") break ;; # Enter
        esac
    done

    # Aksi Clean RAM
    if [ $action_clean -eq 1 ]; then
        free_before=$(free -m 2>/dev/null | awk '/Mem:/ {print $4}')
        if command -v su >/dev/null 2>&1 && su -c "id" >/dev/null 2>&1; then
            unset LD_PRELOAD
            su -c "sync; echo 3 > /proc/sys/vm/drop_caches; am kill-all >/dev/null 2>&1 || true" >/dev/null 2>&1
        else
            sync 2>/dev/null || true
        fi
        free_after=$(free -m 2>/dev/null | awk '/Mem:/ {print $4}')
        delta=$((free_after - free_before))
        if [ $delta -gt 0 ]; then
            toast_msg="RAM+${delta} = ${free_after}"
        else
            toast_msg="RAM = ${free_after}"
        fi

        stty sane 2>/dev/null
        stty -echo 2>/dev/null
        printf "\e[?1000l\e[?1006l\e[?25l"
        while read -rsn1 -t 0.05 _discard; do :; done

        CLEAN_TOAST="$toast_msg" exec "$0"
    fi

    # Keluar loop untuk eksekusi pilihan
    break

done

# Kembalikan terminal normal
printf "\e[?1000l\e[?1006l"
stty sane 2>/dev/null
stty echo 2>/dev/null
printf "\e[?25h\e[2J\e[3J\e[H"

# ==========================================
# EKSEKUSI PILIHAN (1: LINUX, 2: TERMUX)
# ==========================================
if [ $selected -eq 1 ]; then
    unset LD_PRELOAD
    unset LD_LIBRARY_PATH

    # Jalankan konfigurasi entrypoint yang sudah disiapkan saat setup
    if [ -x "$LINUX_CONF" ]; then
        "$LINUX_CONF" "$@"
        EXIT_CODE=$?
        if [ $EXIT_CODE -ne 0 ]; then
            echo -e "\n\e[1;31m[!] Sesi Linux berakhir atau gagal (Exit Code: $EXIT_CODE).\e[0m"
            echo -e "\e[90mBeralih ke Termux shell...\e[0m"
            sleep 1
        fi
    elif [ -x "$PREFIX/bin/bashnh" ]; then
        exec "$PREFIX/bin/bashnh" "$@"
    elif command -v bashnh >/dev/null 2>&1; then
        exec bashnh "$@"
    else
        # Auto-fallback cerdas tanpa hardcoded Debian
        echo "Menjalankan Linux ($LINUX_NAME)..."
        if command -v su >/dev/null 2>&1 && su -c "id" >/dev/null 2>&1; then
            unset LD_PRELOAD
            if [ -x "/data/local/Droidspaces/bin/droidspaces" ] && [ -n "$LINUX_NAME" ] && [ "$LINUX_NAME" != "NetHunter" ]; then
                if [ -x "$PREFIX/bin/termux-ipc-bridge" ]; then
                    if ! pgrep -f termux-ipc-bridge >/dev/null 2>&1; then
                        "$PREFIX/bin/termux-ipc-bridge" </dev/null >/dev/null 2>&1 &
                    fi
                fi
                if ! su -c "/data/local/Droidspaces/bin/droidspaces pid --name='$LINUX_NAME' >/dev/null 2>&1"; then
                    echo -e "\e[38;2;139;233;253m● Menyalakan container $LINUX_NAME...\e[0m"
                    su -c "/data/local/Droidspaces/bin/droidspaces --name='$LINUX_NAME' start" >/dev/null 2>&1 || true
                fi
                su -c "/data/local/Droidspaces/bin/droidspaces --name=\"$LINUX_NAME\" enter"
            elif su -c "[ -d '/data/local/nhsystem/kali-arm64' ]" 2>/dev/null; then
                su -mm -c "chroot /data/local/nhsystem/kali-arm64 /usr/bin/env -i HOME=/root TERM=xterm-256color PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin USER=root LOGNAME=root AUTO_TITLE=true /bin/zsh -l"
            else
                su
            fi
        else
            SLUG_NAME="$LINUX_NAME"
            [ -f "$FUSION_DIR/distro_slug.txt" ] && SLUG_NAME=$(cat "$FUSION_DIR/distro_slug.txt" 2>/dev/null | tr -d '[:space:]')
            proot-distro login "${SLUG_NAME:-debian}" 2>/dev/null || true
        fi
    fi
fi

# Fallback aman: Selalu berikan shell Termux yang aktif (Zsh jika ada, fallback Bash)
printf "\033]0;home\007"
printf "\033]2;home\007"
if [ -x "$PREFIX/bin/zsh" ]; then
    exec -a "-zsh" "$PREFIX/bin/zsh" "$@"
else
    exec -a "-bash" "$PREFIX/bin/bash" "$@"
fi

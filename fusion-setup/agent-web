function checkProfileSessionInfo(prof) {
    if (!prof) return { hasSession: false };
    const dirs = getAllSessionDirs();
    let filePath = null;
    for (const d of dirs) {
        const candidate = path.join(d, `${prof}.json`);
        if (fs.existsSync(candidate)) { filePath = candidate; break; }
    }
    if (!filePath && (prof === 'shaqilla' || prof === 'default')) {
        const legacy = '/root/wallet/x_session.json';
        if (fs.existsSync(legacy)) filePath = legacy;
    }
    if (!filePath) return { hasSession: false };
    try {
        const raw = JSON.parse(fs.readFileSync(filePath, 'utf8'));
        const cookies = raw.cookies || [];
        const auth = cookies.find(c => c.name === 'auth_token' && (c.domain.includes('x.com') || c.domain.includes('twitter.com')));
        if (!auth || !auth.value || auth.value.length < 20) return { hasSession: false };
        if (auth.expires && auth.expires > 0 && auth.expires * 1000 < Date.now()) return { hasSession: false };
        const twid = cookies.find(c => c.name === 'twid');
        let handle = null;
        if (twid && twid.value) {

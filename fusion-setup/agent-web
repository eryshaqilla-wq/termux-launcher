    } else if (eventsStr.includes('{{PASSWORD}}') || eventsStr.includes('{{PWD}}')) {
        console.log(`[Modul Makro] ⚠️ Resep butuh {{PASSWORD}}, tetapi Vault tidak memiliki password untuk URL ini (jalankan dengan --pwd "..." jika ada).`);
    }

    const statusFile = '/root/wallet/.agy_recipe_status.json';
    try { if (fs.existsSync(statusFile)) fs.unlinkSync(statusFile); } catch (_) {}

    const triggerJs = `(function() {
        if (window.__AGY_RECIPE_TRIGGERED__) return 'ALREADY_RUNNING';
        if (!window.AgyBatchRunner || typeof window.AgyBatchRunner.run !== 'function') return 'NOT_READY';
        window.__AGY_ACTIVE_PASSWORD__ = ${JSON.stringify(password || '')};
        var events = ${JSON.stringify(recipeEvents)};
        window.__AGY_RECIPE_TRIGGERED__ = true;
        window.__AGY_RECIPE_STATUS__ = 'RUNNING';
        try {
            if (window.GhostBridge && window.GhostBridge.writeWalletFile) {
                window.GhostBridge.writeWalletFile('.agy_recipe_status.json', JSON.stringify({status:'STARTED', recipe:'${safeName}', time:Date.now()}));
            }
        } catch(_) {}
        window.AgyBatchRunner.run(events, '${safeName}', '1', false, function(result) {
            window.__AGY_RECIPE_STATUS__ = 'COMPLETED';
            window.__AGY_RECIPE_RESULT__ = result;
            try {
                if (window.GhostBridge && window.GhostBridge.writeWalletFile) {
                    window.GhostBridge.writeWalletFile('.agy_recipe_status.json', JSON.stringify({status:'COMPLETED', result:result, time:Date.now()}));
                }
            } catch(_) {}
        }, 'raw', ${loopCount});
        return 'STARTED';
    })()`;

    for (let attempt = 1; attempt <= 15; attempt++) {
        await sleep(1500);
        try {
            const cleanJs = triggerJs.replace(/\r?\n/g, ' ').replace(/"/g, '\\"');

}

async function waitForRecipeCompletion(timeoutMs = 180000) {
    const start = Date.now();
    const statusFile = '/root/wallet/.agy_recipe_status.json';

    const checkJs = `(function() {
        var txt = (document.body && document.body.innerText) ? document.body.innerText : '';
        var status = 'RUNNING';
        if (txt.includes('口令错误') || txt.includes('密码错误') || txt.includes('Wrong password') || txt.includes('Password incorrect') || txt.includes('Kode salah') || txt.includes('Password salah') || txt.includes('口令不对')) {
            status = 'INVALID_PASSWORD';
        } else if (window.__AGY_RECIPE_STATUS__ === 'COMPLETED') {
            status = 'COMPLETED';
        } else if (!window.AgyBatchRunner || !window.AgyBatchRunner.isRunning) {
            status = 'STOPPED';
        }
        try {
            if (window.GhostBridge && window.GhostBridge.writeWalletFile) {
                window.GhostBridge.writeWalletFile('.agy_recipe_status.json', JSON.stringify({status: status, time: Date.now()}));
            }
        } catch(_) {}
    })()`;

    while (Date.now() - start < timeoutMs) {
        await sleep(1500);
        try {
            const cleanCheck = checkJs.replace(/\r?\n/g, ' ').replace(/"/g, '\\"');
            runIpc(`eval "${cleanCheck}"`);
            await sleep(300);

            let status = null;
            if (fs.existsSync(statusFile)) {
                try {
                    const parsed = JSON.parse(fs.readFileSync(statusFile, 'utf8'));
                    status = parsed.status;
                } catch (_) {}
            }

            if (status === 'INVALID_PASSWORD') {
                console.log(`[Modul Makro] ❌ ERROR: [AGY_ERROR: INVALID_PASSWORD] Password ditolak oleh situs web!`);
                return 'INVALID_PASSWORD';
            } else if (status === 'COMPLETED' || status === 'STOPPED') {
                const isCompleted = status === 'COMPLETED';
                console.log(`[Modul Makro] Alur makro selesai (${isCompleted ? 'COMPLETED' : 'STOPPED'})!`);
                return true;
            }
        } catch (_) {}
    }
    console.log(`[Modul Makro] Batas waktu pemantauan (${timeoutMs / 1000}s) tercapai.`);
    return false;
}


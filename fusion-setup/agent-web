                temperature: 0.1
            });
            const resp = await new Promise((resolve, reject) => {
                const req = https.request("https://api.deepseek.com/chat/completions", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Authorization": `Bearer ${apiKey}`,
                        "Content-Length": Buffer.byteLength(payload)
                    },
                    timeout: 12000
                }, res => {
                    let data = "";
                    res.on("data", chunk => data += chunk);
                    res.on("end", () => resolve(data));
                });
                req.on("error", reject);
                req.on("timeout", () => req.destroy(new Error("Timeout")));
                req.write(payload);
                req.end();
            });
            const parsed = JSON.parse(resp);
            const content = parsed.choices?.[0]?.message?.content;
            if (content) {
                const match = content.match(/\{[\s\S]*\}/);
                if (match) return { success: true, recipe: JSON.parse(match[0]), engine: "DeepSeek" };
            }
        }
    } catch (_) {}

    // 3. Coba AGY Ephemeral Runner dari Pool Akun
    try {
        const agyRes = await new Promise((resolve) => {
            const baseHome = process.env.HOME || '/root';
            const accDirs = [path.join(baseHome, '.agy-accounts'), '/root/.agy-accounts', '/data/data/com.termux/files/home/.agy-accounts'];
            const accDir = accDirs.find(d => fs.existsSync(d));
            let tokenSource = null;
            if (accDir) {
                try {
                    const accFiles = fs.readdirSync(accDir).filter(f => f.endsWith('.json'));
                    const actFile = path.join(accDir, '.active');
                    const actName = fs.existsSync(actFile) ? fs.readFileSync(actFile, 'utf8').trim() : '';
                    const workers = accFiles.filter(f => !f.startsWith(actName));
                    const chosen = workers.length > 0 ? workers[0] : accFiles[0];
                    if (chosen) tokenSource = path.join(accDir, chosen);
                } catch (_) {}
            }
            if (!tokenSource) {
                const legacy = [path.join(baseHome, '.gemini/antigravity-cli/antigravity-oauth-token'), '/root/.gemini/antigravity-cli/antigravity-oauth-token'];
                tokenSource = legacy.find(p => fs.existsSync(p));
            }
            if (!tokenSource || !fs.existsSync(tokenSource)) return resolve(null);

            const tmpDir = path.join('/tmp', `agy_web_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`);
            const cliDir = path.join(tmpDir, '.gemini', 'antigravity-cli');
            try {
                fs.mkdirSync(cliDir, { recursive: true });
                fs.copyFileSync(tokenSource, path.join(cliDir, 'antigravity-oauth-token'));
                fs.chmodSync(path.join(cliDir, 'antigravity-oauth-token'), 0o600);
                const settingsCandidates = [path.join(baseHome, '.gemini/antigravity-cli/settings.json'), '/root/.gemini/antigravity-cli/settings.json'];
                const foundSettings = settingsCandidates.find(s => fs.existsSync(s));
                if (foundSettings) { try { fs.symlinkSync(foundSettings, path.join(cliDir, 'settings.json')); } catch (_) {} }
            } catch (_) { return resolve(null); }

            const fullPrompt = `[SYSTEM: ${systemPrompt}]\n\n${userPrompt}`;
            const child = spawn('agy', ['-p', fullPrompt, '--effort', 'low', '--disable-slash-commands'], {
                env: { ...process.env, HOME: tmpDir, AGY_EPHEMERAL: '1' },
                timeout: 25000
            });
            let out = '';
            child.stdout.on('data', chunk => out += chunk);
            child.on('close', () => {
                try { fs.rmSync(tmpDir, { recursive: true, force: true }); } catch (_) {}
                resolve(out.replace(/\x1B\[[0-9;]*[a-zA-Z]/g, '').trim() || null);
            });
            child.on('error', () => {
                try { fs.rmSync(tmpDir, { recursive: true, force: true }); } catch (_) {}
                resolve(null);
            });
        });

        if (agyRes) {
            const match = agyRes.match(/\{[\s\S]*\}/);
            if (match) return { success: true, recipe: JSON.parse(match[0]), engine: "AGY-Pool" };
        }
    } catch (_) {}

    return { success: false, error: "Semua AI Engine offline atau gagal mensintesis resep" };
}

async function handleSynthesizeRecipe(url, extraFlags = []) {

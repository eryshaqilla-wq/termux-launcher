                const nextArg = args[idx + 1];
                if (nextArg && /^\d+$/.test(nextArg)) {
                    concurrency = parseInt(nextArg, 10);
                } else if (flag === '-p' && nextArg && !nextArg.startsWith('-') && !proxyFile) {
                    // Jika Tuan mengetik -p tapi diikutkan nama file proxy (misal: -p proxy.txt atau -p p)
                    const rpf = resolveProxyFilePath(nextArg);
                    if (rpf.found || nextArg.toLowerCase().endsWith('.txt')) {
                        proxyFile = nextArg;
                        concurrency = 1;
                    } else {
                        concurrency = 2;
                    }
                } else {
                    concurrency = 2; // Default ke 2 jika Tuan hanya mengetik flag tanpa angka
                }
                break;
            }
        }

        // 4. Validasi & resolusi file proxy jika ditentukan
        if (proxyFile) {
            const rpf = resolveProxyFilePath(proxyFile);
            if (rpf.found) {
                proxyFile = rpf.path;
                if (!proxy) proxy = 'auto';
            } else {
                console.error(`\n\x1b[1m\x1b[31m✗ Error:\x1b[0m \x1b[97mFile proxy "${rpf.raw}" (atau "${rpf.raw}.txt") tidak ditemukan!\x1b[0m`);
                console.error(`  \x1b[90mPastikan file ada di folder saat ini atau gunakan path lengkap (contoh: /root/proxy.txt atau --p p).\x1b[0m\n`);
                process.exit(1);
            }
        }

        let rotateProxy = args.includes('--rotate-proxy') || args.includes('--rotate') || args.includes('-r');
        let showSniff = args.includes('--sniff') || args.includes('-v') || args.includes('--verbose') || args.includes('--debug');
        let turbo = args.includes('--turbo');
        let noJit = args.includes('--no-jit');
        let jit = args.includes('--jit') || (turbo && !noJit);
        let wire = args.includes('--wire');
        let doze = args.includes('--doze');
        let snap = args.includes('--snap') || args.includes('--session-save');
        let restore = args.includes('--restore') || args.includes('--session-load');
        let burst = 1;
        const bIdx = args.findIndex(a => a === '--burst' || a === '-b');
        if (bIdx !== -1) {
            const nextVal = args[bIdx + 1];
            burst = (nextVal && /^\d+$/.test(nextVal)) ? parseInt(nextVal, 10) : 3;
        } else if (wire) {
            burst = 3;
        }

        // ⚡ Burst mengadopsi arsitektur multi-tab parallel (-p) secara default untuk isolasi DOM & reCAPTCHA sempurna
        if (burst > 1 && concurrency === 1) {
            concurrency = burst;
        }

        const showAllRows = args.includes('--all-rows') || args.includes('-v') || args.includes('--verbose') || args.includes('--detail');

        const cr = new ChainResolver();
        const chainArg = cr.extractChainFromArgs(args);
        const firstW = wallet || (wallets ? (typeof wallets === 'string' ? wallets.split(',')[0].trim() : '') : '');
        const resolved = cr.resolve(chainArg, url, firstW);

        // 4. Validasi keberadaan wallet di database eso.db sebelum mengeksekusi browser
        const walletsToCheck = [];
        if (wallets) {
            try {
                const { expandWalletRanges } = require('/root/wallet/webview_mcp_engine.cjs');
                walletsToCheck.push(...expandWalletRanges(wallets));
            } catch (_) {
                walletsToCheck.push(...String(wallets).split(',').map(s => s.trim()));
            }
        } else if (wallet) {
            try {
                const { expandWalletRanges } = require('/root/wallet/webview_mcp_engine.cjs');
                walletsToCheck.push(...expandWalletRanges(wallet));
            } catch (_) {
                walletsToCheck.push(wallet);
            }
        }
        if (fromWallet) {
            walletsToCheck.push(fromWallet);
        }

        if (walletsToCheck.length > 0) {
            const invalidWallets = [];
            for (const w of walletsToCheck) {
                if (!w) continue;
                const row = cr.getWallet(w, resolved);
                if (!row || !row.address) {
                    invalidWallets.push(w);
                }
            }
            if (invalidWallets.length > 0) {
                const invStr = invalidWallets.slice(0, 5).join(', ') + (invalidWallets.length > 5 ? ` (+${invalidWallets.length - 5} lainnya)` : '');
                console.error(`\n\x1b[1m\x1b[31m✗ Error:\x1b[0m \x1b[97mWallet "${invStr}" tidak ditemukan di database eso.db untuk rantai ${resolved.chainKey.toUpperCase()}!\x1b[0m`);
                console.error(`  \x1b[90mPastikan nama dompet terdaftar di eso.db (misal: eso-1 s/d eso-1000).\x1b[0m\n`);
                process.exit(1);
            }
        }

        const pb = getPlaywrightBridge();
        if (pb) {
            const isHeadlessStr = headless ? ` | \x1b[36mHEADLESS\x1b[0m` : ` | \x1b[32mVISUAL\x1b[0m`;
            const isGhostStr = ghostwallet ? ` | \x1b[35mGHOST-DAEMON\x1b[0m` : '';
            let pxLabel = '';
            if (proxyFile) {
                pxLabel = path.basename(proxyFile).toUpperCase();
            } else if (proxy) {
                pxLabel = proxy.toUpperCase();
            }
            const isProxyStr = pxLabel ? ` | \x1b[35mPROXY: ${pxLabel}\x1b[0m` : '';
            const isParallelStr = (concurrency > 1 && burst <= 1) ? ` | \x1b[33mPARALEL (x${concurrency})\x1b[0m` : '';
            const isTurboStr = turbo ? ` | \x1b[36mTURBO${noJit ? ' (NO-JIT)' : ' (JIT)'}\x1b[0m` : (jit ? ` | \x1b[33mJIT\x1b[0m` : '');
            const isWireStr = wire ? ` | \x1b[36mWIRE\x1b[0m` : '';
            const isBurstStr = burst > 1 ? ` | \x1b[35mBURST (x${burst} Tab Paralel)\x1b[0m` : '';
            const isDozeStr = doze ? ` | \x1b[35mDOZE\x1b[0m` : '';
            const isSniffStr = showSniff ? ` | \x1b[36mSNIFF: VERBOSE\x1b[0m` : '';
            let displayWallets = '';
            if (wallets) {
                try {
                    const { expandWalletRanges } = require('/root/wallet/webview_mcp_engine.cjs');
                    const exp = expandWalletRanges(wallets);
                    displayWallets = exp.length > 1 ? `${wallets} (${exp.length} Wallets)` : wallets;
                } catch (_) { displayWallets = wallets; }
            } else if (wallet) {
                try {
                    const { expandWalletRanges } = require('/root/wallet/webview_mcp_engine.cjs');
                    const exp = expandWalletRanges(wallet);
                    if (exp.length > 1) displayWallets = `${wallet} (${exp.length} Wallets)`;
                } catch (_) {}
            } else if (fresh && !wallet && !wallets && !all) {
                displayWallets = `FRESH (${loop}x Identitas Acak Tanpa Wallet)`;
            } else if (all || (!wallet && !wallets)) {
                displayWallets = fromWallet ? `FROM ${fromWallet.toUpperCase()} (Hingga Habis)` : 'ALL (Dari Awal Hingga Habis)';
            }

            let recipeUsesEmail = false;
            try {
                const recipes = JSON.parse(fs.readFileSync('/root/wallet/recipes_db.json', 'utf8'));
                const rec = recipes[recipeName];
                if (rec) {
                    const recStr = JSON.stringify(rec);
                    recipeUsesEmail = recStr.includes('{{EMAIL') ||
                                      recStr.includes('{{OTP') ||
                                      Boolean(rec.events && rec.events.some(e => e.type === 'wait_otp' || e.type === 'otp' || e.type === 'wait_link' || (e.selector && e.selector.includes('email'))));
                }
            } catch (_) {}

            let isEmailStr = '';
            const hasExplicitEmail = Boolean(email || emails || cloudMail || emailFile);
            if (hasExplicitEmail || recipeUsesEmail) {
                if (cloudMail) {
                    isEmailStr = ` | Email: \x1b[36mCloud-Mail (Dynamic TLD)\x1b[0m`;
                } else if (email) {
                    isEmailStr = ` | Email: \x1b[32m${email}\x1b[0m`;
                } else if (emails) {
                    isEmailStr = ` | Emails: \x1b[32m${emails}\x1b[0m`;
                } else if (fs.existsSync('/root/wallet/email.txt')) {
                    try {
                        const { EmailPoolManager } = require('/root/wallet/email_pool_manager.cjs');
                        const ep = new EmailPoolManager({ emailFile: emailFile || '/root/wallet/email.txt' });
                        const summ = ep.getPoolSummary();
                        if (summ.staticCount > 0) {
                            isEmailStr = ` | Email: \x1b[32mStatic Pool (${summ.staticCount} Akun: ${summ.staticEmails.slice(0, 2).join(', ')}${summ.staticCount > 2 ? '...' : ''})\x1b[0m`;
                        }
                    } catch (_) {}
                }
            }

            // Baris 1: Info Modul & Chain
            const headerLine = `\x1b[1m\x1b[36m[INSTANT REPLAY]\x1b[0m \x1b[97mModul: "${recipeName}" | Rantai: \x1b[1m\x1b[32m${resolved.chainKey.toUpperCase()}\x1b[0m`;

            // Baris 2: Info Wallets / Target Akun (dan Email jika ada)
            let walletLabel = 'Wallets';
            let walletDetail = '';
            if (displayWallets) {
                walletDetail = displayWallets;
                if (!displayWallets.includes('(') && !displayWallets.includes('FROM') && !displayWallets.includes('ALL')) {
                    walletLabel = 'Wallet';
                }
            } else if (wallet) {
                walletLabel = 'Wallet';
                walletDetail = wallet + (loop > 1 ? ` (Loop: ${loop}x)` : '');
            } else {
                walletDetail = 'Default (eso.db)';
            }
            const walletLine = `  \x1b[33m${walletLabel.padEnd(7, ' ')}\x1b[0m : \x1b[97m${walletDetail}\x1b[0m${isEmailStr}`;

            // Baris 3: Info WebView & Execution Mode
            const webviewParts = [
                headless ? '\x1b[36mHEADLESS\x1b[0m' : '\x1b[32mVISUAL\x1b[0m',
                turbo ? `\x1b[36mTURBO${noJit ? ' (NO-JIT)' : ' (JIT)'}\x1b[0m` : (jit ? '\x1b[33mJIT\x1b[0m' : ''),
                (concurrency > 1 && burst <= 1) ? `\x1b[33mPARALEL (x${concurrency})\x1b[0m` : '',
                burst > 1 ? `\x1b[35mBURST (x${burst} Tab Paralel)\x1b[0m` : '',
                pxLabel ? `\x1b[35mPROXY: ${pxLabel}\x1b[0m` : '',
                ghostwallet ? '\x1b[35mGHOST-DAEMON\x1b[0m' : '',
                wire ? '\x1b[36mWIRE\x1b[0m' : '',
                doze ? '\x1b[35mDOZE\x1b[0m' : '',
                snap ? '\x1b[36mSNAP\x1b[0m' : '',
                restore ? '\x1b[32mRESTORE\x1b[0m' : '',
                fresh ? '\x1b[36mFRESH-ID\x1b[0m' : '',
                showSniff ? '\x1b[36mSNIFF: VERBOSE\x1b[0m' : ''
            ].filter(Boolean);
            const webviewLine = `  \x1b[36mWebView\x1b[0m : ${webviewParts.join(' | ')}`;

            console.log(`\n${headerLine}\n${walletLine}\n${webviewLine}`);

            const res = await pb.playRecipe(recipeName, { wallet, wallets, loop, chain: resolved.chainKey, headless, url, ghostwallet, proxy, proxyFile, rotateProxy, concurrency, all, from: fromWallet, showSniff, turbo, jit, noJit, wire, burst, doze, email, emails, emailFile, cloudMail, snap, restore, fresh });
            if (res.error) {
                console.error(`\x1b[1m\x1b[31m✗ Error:\x1b[0m \x1b[97m${res.error}\x1b[0m`);
                process.exitCode = 1;
            } else if (res.results && Array.isArray(res.results)) {
                const totalWallets = res.totalWallets || res.results.length;
                const successList = res.results.filter(r => (r.finalStatus || '').startsWith('SUKSES') || r.isSuccess);
                const failList = res.results.filter(r => (r.finalStatus || '').startsWith('GAGAL') || (r.finalStatus || '').startsWith('ERROR'));
                const claimedList = res.results.filter(r => (r.finalStatus || '').startsWith('SUDAH KLAIM') || r.isAlreadyClaimed);
                const soldOutList = res.results.filter(r => (r.finalStatus || '').startsWith('HABIS') || r.isSoldOut);
                const successRate = totalWallets > 0 ? ((successList.length / totalWallets) * 100).toFixed(1) : '0.0';

                // Hitung total akumulasi reward per token/poin
                const rewardTotals = {};
                for (const r of successList) {
                    if (r.reward && r.reward.amount) {
                        const sym = r.reward.symbol || 'Reward';
                        rewardTotals[sym] = (rewardTotals[sym] || 0) + Number(r.reward.amount);
                    } else if (typeof r.reward === 'string') {
                        rewardTotals[r.reward] = (rewardTotals[r.reward] || 0) + 1;
                    }
                }
                const rewardParts = Object.entries(rewardTotals).map(([sym, amt]) => {
                    const displayAmt = (amt % 1 !== 0) ? parseFloat(amt.toFixed(6)) : amt;
                    return `\x1b[1m\x1b[32m+${displayAmt} ${sym}\x1b[0m`;
                });
                const totalRewardStr = rewardParts.length > 0 ? rewardParts.join(', ') : '';

                console.log(`\n\x1b[1m\x1b[32m[BATCH REPLAY SELESAI]\x1b[0m \x1b[97mTotal: ${totalWallets} Wallet | Waktu Total: ${res.totalElapsed}\x1b[0m`);

                // Jika akun sedikit (<= 5) atau user minta --all-rows: tampilkan detail per-wallet
                if (res.results.length <= 5 || showAllRows) {
                    res.results.forEach((r, idx) => {
                        const modeBadge = (r.mode && r.mode.includes('BURST')) ? `\x1b[35m[BURST]\x1b[0m` : (r.mode === 'HOT_REPLAY' ? `\x1b[33m[HOT]  \x1b[0m` : `\x1b[36m[COLD] \x1b[0m`);
                        const addrShort = r.address ? `${r.address.slice(0, 10)}...${r.address.slice(-6)}` : '-';
                        console.log(`  \x1b[1m\x1b[97m${idx + 1}.\x1b[0m ${modeBadge} \x1b[97m${(r.wallet || '-').padEnd(10)} (${addrShort}) -> \x1b[1m\x1b[33m${r.elapsed}\x1b[0m\x1b[97m | \x1b[32m${r.finalStatus}\x1b[0m`);
                    });
                }

                // Ringkasan bersih tanpa garis (borderless clean)
                const rateColor = Number(successRate) >= 80 ? '\x1b[32m' : (Number(successRate) >= 50 ? '\x1b[33m' : '\x1b[31m');
                let resultParts = [`\x1b[32m✓ ${successList.length} Sukses\x1b[0m`];
                if (failList.length > 0) resultParts.push(`\x1b[31m✗ ${failList.length} Gagal\x1b[0m`);
                if (claimedList.length > 0) resultParts.push(`\x1b[36mℹ ${claimedList.length} Sudah Klaim\x1b[0m`);
                if (soldOutList.length > 0) resultParts.push(`\x1b[33m⚠ ${soldOutList.length} Kuota Habis\x1b[0m`);

                console.log(`  \x1b[1m\x1b[97m${"Hasil:".padEnd(18, " ")}\x1b[0m${resultParts.join(' | ')} (${rateColor}${successRate}% Rate\x1b[0m)`);
                if (totalRewardStr) {
                    console.log(`  \x1b[1m\x1b[97m${"Total Reward:".padEnd(18, " ")}\x1b[0m${totalRewardStr}`);
                }
                const avgSec = (parseFloat(res.totalElapsed) / (totalWallets || 1)).toFixed(1);
                console.log(`  \x1b[1m\x1b[97m${"Rata-rata Waktu:".padEnd(18, " ")}\x1b[0m\x1b[33m${avgSec}s / wallet\x1b[0m`);

                // Jika ada yang gagal, tampilkan daftar error audit agar Tuan bisa langsung retry tanpa scrolling panjang
                if (failList.length > 0) {
                    console.log(`\n  \x1b[1m\x1b[31mGagal / Perlu Retry (${failList.length} Wallet):\x1b[0m`);
                    failList.slice(0, 10).forEach(f => {
                        const wName = f.wallet || 'Unknown';
                        const wAddr = f.address ? `(${f.address.slice(0, 8)}...${f.address.slice(-6)})` : '';
                        console.log(`    \x1b[31m-\x1b[0m \x1b[97m${wName} ${wAddr} -> \x1b[31m${f.finalStatus || 'Gagal'}\x1b[0m`);
                    });
                    if (failList.length > 10) {
                        console.log(`    \x1b[90m... dan ${failList.length - 10} wallet gagal lainnya\x1b[0m`);
                    }
                    const retryList = failList.map(f => f.wallet).filter(Boolean).slice(0, 15).join(',');
                    if (retryList) {
                        console.log(`    \x1b[90mTips retry instan: web play ${recipeName} --wallets ${retryList}\x1b[0m`);
                    }
                }

                runIpcToast('Tab WebView ditutup');
                console.log(`  \x1b[1m\x1b[97m${"Tab WebView:".padEnd(18, " ")}\x1b[0m\x1b[32m✓ Ditutup\x1b[0m\n`);
            } else {
                console.log(`\n\x1b[1m\x1b[32m[REPLAY SELESAI]\x1b[0m \x1b[97mWaktu: ${res.elapsed} | Status: OK\x1b[0m`);
                if (res.address) console.log(`  \x1b[97m${"Alamat:".padEnd(18, " ")}\x1b[32m${res.address}\x1b[0m \x1b[97m(${res.chain})\x1b[0m`);
                (res.steps || []).forEach((st, idx) => {
                    const tagCol = `${idx + 1}. [${st.step.toUpperCase()}]`.padEnd(18, ' ');
                    const skipInfo = st.skipped ? ` \x1b[97m(${st.skipped})\x1b[0m` : '';
                    const okBadge = st.ok ? `\x1b[32m✓ OK\x1b[0m` : `\x1b[31m✗ GAGAL\x1b[0m`;
                    const targetPadded = (st.target || '-').padEnd(16, ' ');
                    console.log(`  \x1b[97m${tagCol}${targetPadded} -> ${okBadge}${skipInfo}\x1b[0m`);
                });
                if (res.finalStatus) console.log(`  \x1b[1m\x1b[97m${"Status Akhir:".padEnd(18, " ")}\x1b[32m${res.finalStatus}\x1b[0m`);
                if (res.reward && res.reward.formatted) console.log(`  \x1b[1m\x1b[97m${"Reward:".padEnd(18, " ")}\x1b[1m\x1b[32m${res.reward.formatted}\x1b[0m`);
                runIpcToast('Tab WebView ditutup');
                console.log(`  \x1b[1m\x1b[97m${"Tab WebView:".padEnd(18, " ")}\x1b[0m\x1b[32m✓ Ditutup\x1b[0m\n`);
            }
            await pb.close();
            process.exit(0);
        }
    }

    // Jika dipanggil oleh Telegram / skrip background dan membawa MAKRO: delegasikan ke tab baru via IPC!
    if (isTelegramCaller && !inWorkerTab && !['prompt', 'click', 'type', 'fill', 'snapshot', 'dom', 'eval', 'close'].includes(cmd)) {
        const hasMacro = args.some(a => a.startsWith('--modul') || a.startsWith('--macro') || a.startsWith('--recipe') || a.startsWith('--loop') || a.startsWith('-l') || a === 'play');
        if (hasMacro) {
            let modulName = '';
            for (let i = 0; i < args.length; i++) {
                const a = args[i];
                if (['--modul', '--recipe', '--macro', 'play'].includes(a) && args[i + 1] && !args[i + 1].startsWith('-')) {
                    modulName = args[i + 1];
                    break;
                }
                if (a.startsWith('--modul=')) { modulName = a.split('=')[1]; break; }
                if (a.startsWith('--recipe=')) { modulName = a.split('=')[1]; break; }
                if (a.startsWith('--macro=')) { modulName = a.split('=')[1]; break; }
            }
            const workerTab = modulName ? modulName.replace(/[^a-zA-Z0-9_\-]/g, '').slice(0, 20) : ('w_' + Date.now().toString().slice(-8)).slice(0, 14);
            const cleanArgs = args.filter(a => a !== '--telegram' && a !== '--new-tab');
            const delegatedCmd = `web --in-worker-tab --tab-name "${workerTab}" ${cleanArgs.map(a => (a.includes(' ') || a.includes('&') || a.includes('#')) ? `"${a.replace(/"/g, '\\"')}"` : a).join(' ')}; sleep 1; termux-ipc tab close "${workerTab}" 2>/dev/null || true`;
            console.log(`[Agent-Web] Panggilan background/Telegram dengan makro terdeteksi. Membuka tab baru "${workerTab}" via IPC...`);
            runIpcTab('new', [workerTab, delegatedCmd]);
            process.exit(0);
        }
        // Jika bukan makro (hanya buka URL biasa / TMA), lanjutkan ke handleOpenUrl tanpa buka tab terminal!
    }

    // Deteksi jika pemanggilan berupa URL langsung atau membawa opsi automasi (--modul / --wallet / --recipe / --loop / --stop-if / --all-profiles / --profile / --desktop / --ghost / --ai / --engine / --chain)
    const isUrlOrAutomation = args.some(a => 
        a.startsWith('--modul') || a.startsWith('--macro') || a.startsWith('--recipe') ||
        a.startsWith('--wallet') || a.startsWith('--chain') || Boolean(chainResolver.extractChainFromArgs([a])) ||
        a.startsWith('--stop-if') || a.startsWith('--stop-not') || a.startsWith('--stopif') ||
        a.startsWith('--ai') || a.startsWith('--engine') ||
        a.startsWith('--pwd') || a.startsWith('--password') || a.startsWith('--profile') || a.startsWith('--fresh') || a.startsWith('--incognito') || a.startsWith('--desktop') || a.startsWith('--headless') || a.startsWith('--ghost') ||
        a.startsWith('--all-profiles') || a.startsWith('--allprofiles') || a.startsWith('--profiles') || a.startsWith('--parallel') ||
        a === 'home' || a === 'beranda' ||
        a.startsWith('http://') || a.startsWith('https://') ||
        (a.includes('.') && !a.startsWith('-') && !a.endsWith('.js') && !a.endsWith('.cjs') && !a.endsWith('.json'))
    );

    if (isUrlOrAutomation && !['prompt', 'click', 'type', 'fill', 'snapshot', 'dom', 'eval', 'close', '--synth', 'synth', '--auto-recipe', 'auto-recipe'].includes(cmd)) {
        let targetUrl = '';
        let passFlags = [];
        for (let i = 0; i < args.length; i++) {
            const item = args[i];
            if (item === '--profile' || item === '--wallet' || item === '--chain' || item === '--modul' || item === '--macro' || item === '--recipe' || item === '--loop' || item === '-l' || item === '--stop-if' || item === '--stopif' || item === '--stop-not' || item === '--stop-when' || item === '--tab-name' || item === '--profiles' || item === '--pwd' || item === '--password' || item === '--ai' || item === '--engine') {
                passFlags.push(item);
                if (args[i + 1] && !args[i + 1].startsWith('--') && !args[i + 1].startsWith('http://') && !args[i + 1].startsWith('https://') && args[i + 1] !== 'home' && args[i + 1] !== 'beranda') {
                    passFlags.push(args[i + 1]);
                    i++;
                }
            } else if (item === '--in-worker-tab' || item === '--all-profiles' || item === '--allprofiles' || item === '--parallel') {
                passFlags.push(item);
            } else if (item.startsWith('--')) {
                passFlags.push(item);
            } else if (!targetUrl && (item.startsWith('http://') || item.startsWith('https://') || item === 'home' || item === 'beranda' || item.includes('.'))) {
                targetUrl = (item === 'home' || item === 'beranda') ? 'file:///android_asset/webview_engine/home.html' : item;
            } else {
                passFlags.push(item);
            }
        }
        if (!targetUrl) {
            targetUrl = 'file:///android_asset/webview_engine/home.html';
        }
        if (passFlags.includes('--synth') || passFlags.includes('--auto-recipe')) {
            await handleSynthesizeRecipe(targetUrl, passFlags);
            process.exit(0);
        }
        await handleOpenUrl(targetUrl, passFlags);
        process.exit(0);
    }

    if (cmd === 'mcp' || cmd === '--mcp') {
        const mcpServer = '/root/wallet/termux_webview_mcp_server.cjs';
        const child = spawn('node', [mcpServer], { stdio: 'inherit' });
        child.on('close', code => process.exit(code || 0));
        return;
    }

    if (cmd === 'prompt') {
        const promptText = args.slice(1).join(' ').trim();
        if (!promptText) {
            console.log(`${RED}Error: Masukkan teks prompt!${RESET}`);
            process.exit(1);
        }
        runIpc(`prompt "${promptText}"`);
        process.exit(0);
    }

    if (cmd === 'click-human' || cmd === 'human-click') {
        const target = args.slice(1).join(' ').trim();
        if (!target) {
            console.log(`${RED}Error: Tentukan elemen atau ref ID! (contoh: web click-human e2)${RESET}`);
            process.exit(1);
        }
        const pb = getPlaywrightBridge();
        if (pb) {
            try {
                const res = await pb.clickHuman(target);
                if (res.error) console.log(`${RED}Error: ${res.error}${RESET}`);
                else console.log(`[Human Bézier Click Sukses] Target: ${target}`);
                await pb.close();
                process.exit(0);
            } catch (_) {}
        }
        process.exit(0);
    }

    if (cmd === 'swipe') {
        const x1 = parseFloat(args[1]);
        const y1 = parseFloat(args[2]);
        const x2 = parseFloat(args[3]);
        const y2 = parseFloat(args[4]);
        const dur = args[5] ? parseInt(args[5], 10) : 300;
        const pb = getPlaywrightBridge();
        if (pb) {
            const res = await pb.swipe(x1, y1, x2, y2, dur);
            console.log(JSON.stringify(res));
            await pb.close();
        }
        process.exit(0);
    }

    if (cmd === 'drag') {
        const start = args[1];
        const end = args[2];
        const dur = args[3] ? parseInt(args[3], 10) : 500;
        const pb = getPlaywrightBridge();
        if (pb) {
            const res = await pb.drag(start, end, dur);
            console.log(JSON.stringify(res));
            await pb.close();
        }
        process.exit(0);
    }

    if (cmd === 'scroll') {
        const dy = parseFloat(args[1] || '300');
        const dx = parseFloat(args[2] || '0');
        const dur = args[3] ? parseInt(args[3], 10) : 500;
        const pb = getPlaywrightBridge();
        if (pb) {
            const res = await pb.scrollNatural(dx, dy, dur);
            console.log(JSON.stringify(res));
            await pb.close();
        }
        process.exit(0);
    }

    if (cmd === 'longpress' || cmd === 'long-press') {
        const target = args[1];
        const dur = args[2] ? parseInt(args[2], 10) : 1000;
        const pb = getPlaywrightBridge();
        if (pb) {
            const res = await pb.longPress(target, dur);
            console.log(JSON.stringify(res));
            await pb.close();
        }
        process.exit(0);
    }

    if (cmd === 'hide-keyboard' || cmd === 'keyboard-hide') {
        const pb = getPlaywrightBridge();
        if (pb) {
            const res = await pb.hideKeyboard();
            console.log(JSON.stringify(res));
            await pb.close();
        }
        process.exit(0);
    }

    if (cmd === 'wakelock') {
        const mode = args[1] === 'off' ? false : true;
        const pb = getPlaywrightBridge();
        if (pb) {
            const res = await pb.setWakeLock(mode);
            console.log(JSON.stringify(res));
            await pb.close();
        }
        process.exit(0);
    }

    if (cmd === 'last-download') {
        const pb = getPlaywrightBridge();
        if (pb) {
            const res = await pb.getLastDownload();
            console.log(JSON.stringify(res));
            await pb.close();
        }
        process.exit(0);
    }

    if (cmd === 'click') {
        const target = args.slice(1).join(' ').trim();
        if (!target) {
            console.log(`${RED}Error: Tentukan elemen atau ref ID yang ingin diklik! (contoh: web click e2)${RESET}`);
            process.exit(1);
        }
        const pb = getPlaywrightBridge();
        if (pb) {
            try {
                const res = await pb.click(target);
                if (res.error) {
                    console.log(`${RED}Error: ${res.error}${RESET}`);
                } else {
                    console.log(`[Click Sukses] Target: ${target} (${res.action.tag || 'element'})`);
                    if (res.snapshot) {
                        console.log(`\nUpdated ARIA Snapshot:\n${res.snapshot}`);
                    }
                }
                await pb.close();
                process.exit(0);
            } catch (_) {}
        }
        runIpc(`prompt "klik ${target}"`);
        process.exit(0);
    }

    if (cmd === 'type' || cmd === 'fill') {
        const field = args[1];
        const val = args.slice(2).join(' ').trim();
        if (!field) {
            console.log(`${RED}Error: Tentukan ref ID atau kolom dan nilai! (contoh: web fill e1 "halo")${RESET}`);
            process.exit(1);
        }
        const pb = getPlaywrightBridge();
        if (pb) {
            try {
                const res = await pb.fill(field, val);
                if (res.error) {
                    console.log(`${RED}Error: ${res.error}${RESET}`);
                } else {
                    console.log(`[Fill Sukses] Target: ${field} = "${val}"`);
                    if (res.snapshot) {
                        console.log(`\nUpdated ARIA Snapshot:\n${res.snapshot}`);
                    }
                }
                await pb.close();
                process.exit(0);
            } catch (_) {}
        }
        runIpc(`prompt "isi ${field} ${val}"`);
        process.exit(0);
    }

    if (cmd === 'press') {
        const key = args[1] || 'Enter';
        const pb = getPlaywrightBridge();
        if (pb) {
            try {
                await pb.press(key);
                console.log(`[Press Sukses] Tombol [${key}] ditekan.`);
                await pb.close();
                process.exit(0);
            } catch (_) {}
        }
        console.log(`[Press] Tombol [${key}] dikirim.`);
        process.exit(0);
    }

    if (cmd === 'hover') {
        const target = args.slice(1).join(' ').trim();
        const pb = getPlaywrightBridge();
        if (pb) {
            try {
                const res = await pb.hover(target);
                console.log(`[Hover Sukses] ${JSON.stringify(res)}`);
                await pb.close();
                process.exit(0);
            } catch (_) {}
        }
        process.exit(0);
    }

    if (cmd === 'wait') {
        const query = args[1];
        const timeout = args[2] && /^\d+$/.test(args[2]) ? parseInt(args[2], 10) : 5000;
        const pb = getPlaywrightBridge();
        if (pb) {
            try {
                const res = await pb.waitFor(query, timeout);
                console.log(JSON.stringify(res, null, 2));
                await pb.close();
                process.exit(0);
            } catch (_) {}
        }
        process.exit(0);
    }

    if (cmd === 'snapshot' || cmd === 'dom' || cmd === 'aria') {
        const pb = getPlaywrightBridge();
        if (pb) {
            try {
                const depth = args[1] && /^\d+$/.test(args[1]) ? parseInt(args[1], 10) : 12;
                const snap = await pb.snapshot(depth);
                console.log(snap);
                await pb.close();
                process.exit(0);
            } catch (err) {}
        }
        await handleSnapshot();
        process.exit(0);
    }

    if (cmd === 'eval') {
        const js = args.slice(1).join(' ').trim();
        const res = evalJs(js);
        if (res) console.log(res);
        process.exit(0);
    }

    if (cmd === 'emit' || cmd === 'send-event') {
        const eventName = args[1];
        const eventData = args.slice(2).join(' ') || '{}';
        if (!eventName) {
            console.error('Usage: web emit <event_name> [json_payload]');
            process.exit(1);
        }
        const script = `if(window.__FUSION_DISPATCH_TERMUX_EVENT__){window.__FUSION_DISPATCH_TERMUX_EVENT__('${eventName}', ${JSON.stringify(eventData)});}else if(window.dispatchEvent){window.dispatchEvent(new CustomEvent('termux_${eventName}',{detail:${JSON.stringify(eventData)}}));}`;
        evalJs(script);
        console.log(`[Event Emitted] ${eventName} -> WebView`);
        process.exit(0);
    }

    if (cmd === 'logs' || cmd === 'log' || cmd === 'console') {
        const follow = args.includes('-f') || args.includes('--follow');
        const logPath = '/tmp/webview_console.log';
        if (!fs.existsSync(logPath)) {
            console.log('Belum ada log console WebView di ' + logPath);
            process.exit(0);
        }
        if (follow) {
            const { spawn } = require('child_process');
            const tail = spawn('tail', ['-f', '-n', '20', logPath], { stdio: 'inherit' });
            process.on('SIGINT', () => { tail.kill(); process.exit(0); });
        } else {
            const lines = execSync(`tail -n 40 "${logPath}" 2>/dev/null || true`).toString();
            console.log(lines || 'Log kosong.');
            process.exit(0);
        }
        return;
    }

    if (cmd === 'kill' || cmd === 'kill-tab' || cmd === 'killtab') {
        const killArg = args[1] && !args[1].startsWith('-') ? `kill-tab ${args[1]}` : 'kill-tab';
        runIpc(killArg);
        runIpcToast('Tab WebView ditutup');
        console.log(`Tab WebView ditutup.`);
        process.exit(0);
    }

    if (cmd === 'restart' || cmd === 'reset' || cmd === 'reboot') {
        console.log(`[Agent-Web] Me-restart WebView dan me-reset konfigurasi proxy/tab...`);
        try {
            runIpc('proxy clear');
        } catch (_) {}
        try {
            runIpc('close');
        } catch (_) {}
        console.log(`${GREEN}✔ WebView berhasil di-reset bersih (Proxy Direct & Closed).${RESET}`);
        process.exit(0);
    }

    const isGcCmd = (
        cmd === 'gc' ||
        cmd === 'clean-ram' ||
        cmd === 'purge' ||
        cmd === 'mem' ||
        cmd === 'free-ram' ||
        cmd === 'garbage-collect'
    );

    if (isGcCmd) {
        const allTabs = args.includes('--all') || args.includes('-a');
        const asJson = args.includes('--json') || args.includes('-j');
        const pb = getWebviewBridge();
        if (!pb) {
            console.error('\x1b[31mGagal menginisialisasi WebView bridge.\x1b[0m');
            process.exit(1);
        }

        const res = await pb.collectGarbage({ allTabs });
        if (asJson) {
            console.log(JSON.stringify(res, null, 2));
            process.exit(res.success ? 0 : 1);
        }

        if (!res.success) {
            console.error(`\n\x1b[1m\x1b[31m✗ Error:\x1b[0m \x1b[97m${res.error || 'Gagal menjalankan V8 Garbage Collection'}\x1b[0m\n`);
            process.exit(1);
        }

        const tabDesc = res.allTabs ? `${res.tabsPurged} tab (Seluruh Tab)` : `1 tab (${res.totalTargets > 1 ? 'Tab Utama, ' + res.totalTargets + ' total' : 'Utama'})`;
        console.log(`\n\x1b[1m\x1b[32m✓\x1b[0m \x1b[1m[MEMORY PURGE]\x1b[0m \x1b[97mV8 Heap Garbage Collection Berhasil\x1b[0m`);
        console.log(`  \x1b[90mTab Diproses  :\x1b[0m \x1b[97m${tabDesc}\x1b[0m`);
        console.log(`  \x1b[90mV8 Heap Awal  :\x1b[0m \x1b[97m${res.heapBeforeMb} MB\x1b[0m`);
        console.log(`  \x1b[90mV8 Heap Akhir :\x1b[0m \x1b[97m${res.heapAfterMb} MB\x1b[0m`);
        console.log(`  \x1b[90mRAM Bebas     :\x1b[0m \x1b[1m\x1b[32m${res.freedMb} MB\x1b[0m \x1b[90m(Durasi: ${res.durationMs}ms)\x1b[0m\n`);
        process.exit(0);
    }

    if (cmd === 'close') {
        runIpc('close');
        console.log(`WebView ditutup.`);
        process.exit(0);
    }

    // Validasi input default sebelum diteruskan ke termux-ipc webview
    const firstArg = args[0] ? args[0].trim() : '';
    const isUrl = firstArg.startsWith('http://') ||
                  firstArg.startsWith('https://') ||
                  firstArg.startsWith('file://') ||
                  firstArg.startsWith('about:') ||
                  firstArg.startsWith('content://') ||
                  firstArg.startsWith('www.') ||
                  firstArg === 'home' ||
                  firstArg === 'beranda';

    if (cmd === 'default-webview') {
        const output = runIpc(`--default-webview ${args.slice(1).join(' ')}`.trim());
        if (output) console.log(output);
        process.exit(0);
    }

    const isLocalFile = fs.existsSync(firstArg);
    const isIpcFlag = firstArg.startsWith('--') && [
        '--gecko', '--geckoview', '--default', '--system-webview', '--default-webview',
        '--headless', '--new-tab', '--desktop', '--wallet', '--profile', '--fresh',
        '--incognito', '--clear-cache', '--devtools', '--proxy', '--user-agent',
        '--url', '--window', '--zoom', '--wc', '--ghost', '--auto', '--turbo',
        '--block-', '--monitor', '--watch', '--interval', '--rotate'
    ].some(f => firstArg.startsWith(f));

    if (args.length === 0 || isUrl || isLocalFile || isIpcFlag) {
        const output = runIpc(args.join(' '));
        if (output) console.log(output);
        process.exit(0);
    }

    // Jika perintah tidak dikenali sama sekali: Tolak dan hentikan seketika (Anti-Eksekusi Liar)
    console.error(`\n\x1b[1m\x1b[31m✗ Error:\x1b[0m \x1b[97mPerintah atau URL "${firstArg}" tidak valid!\x1b[0m`);
    console.error(`  \x1b[90mKetik "web help" untuk melihat daftar perintah dan opsi yang didukung.\x1b[0m\n`);
    process.exit(1);
}

main().catch(err => {
    console.error(`${RED}Error: ${err.message}${RESET}`);
    process.exit(1);
});

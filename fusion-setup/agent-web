function deleteProfileFromVault(prof) {
    if (!prof) return { success: false, message: 'Nama profil kosong.' };
    const clean = prof.trim();
    let deletedFiles = [];

    // 1. Hapus dari webview_profiles.json di semua path
    const profileFiles = [
        '/root/wallet/webview_profiles.json',
        '/data/data/com.termux/files/home/wallet/webview_profiles.json',
        '/wallet/webview_profiles.json'
    ];
    for (const pf of profileFiles) {
        if (fs.existsSync(pf)) {
            try {
                let list = JSON.parse(fs.readFileSync(pf, 'utf8'));
                if (Array.isArray(list) && list.includes(clean)) {
                    list = list.filter(p => p !== clean);
                    fs.writeFileSync(pf, JSON.stringify(list, null, 2), 'utf8');
                    deletedFiles.push(path.basename(pf));
                }
            } catch (_) {}
        }
    }

    // 2. Hapus berkas sesi dan device di direktori session
    const dirs = getAllSessionDirs();
    for (const d of dirs) {
        const sessionFile = path.join(d, `${clean}.json`);
        if (fs.existsSync(sessionFile)) {
            try { fs.unlinkSync(sessionFile); deletedFiles.push(`sessions/${clean}.json`); } catch (_) {}
        }
        const devFile = path.join(d, `${clean}.device.json`);
        if (fs.existsSync(devFile)) {
            try { fs.unlinkSync(devFile); deletedFiles.push(`sessions/${clean}.device.json`); } catch (_) {}
        }
    }

    // 3. Reset .active_profile jika profil yang dihapus sedang aktif
    const active = getActiveProfile();
    if (active === clean) {
        setActiveProfile('default');
    }

    return { success: true, deletedFiles: Array.from(new Set(deletedFiles)) };
}


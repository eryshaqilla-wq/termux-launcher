    }

    // Cleanup: Jika menjalankan modul makro, selalu tutup WebView setelah selesai agar RAM lega
    if (recipe || modulQuery) {
        if (targetProfile && targetProfile !== 'default' && targetProfile !== 'list') {
            try { runIpc(`save-session ${targetProfile}`); } catch (_) {}

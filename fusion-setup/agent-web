#!/usr/bin/env node

/**
 * AGENT-WEB CONTROLLER (Universal Web Automation Engine)
 * Pengendali WebView otonom untuk AI Agents (Antigravity) & CLI.
 * Mendukung navigasi, multi-step NLP, DOM snapshot, multi-profile cookie vault, dan X automation.
 */

const { execSync } = require('child_process');
const fs = require('fs');
const path = require('path');

const GREEN = '\x1b[32m';
const CYAN = '\x1b[36m';
const YELLOW = '\x1b[33m';
const RED = '\x1b[31m';
const BOLD = '\x1b[1m';
const RESET = '\x1b[0m';

function getSessionsDir() {
    const candidates = [
        process.env.FUSION_WALLET_DIR ? path.join(process.env.FUSION_WALLET_DIR, 'sessions') : null,
        process.env.HOME ? path.join(process.env.HOME, 'wallet', 'sessions') : null,
        '/wallet/sessions',
        '/root/wallet/sessions',
        '/data/data/com.termux/files/home/wallet/sessions'
    ].filter(Boolean);

    for (const dir of candidates) {
        if (fs.existsSync(dir)) return dir;
    }
    const def = '/root/wallet/sessions';
    try { fs.mkdirSync(def, { recursive: true }); } catch(_) {}
    return def;
}

function sleep(ms) {
    return new Promise(r => setTimeout(r, ms));
}

function runIpc(ipcArgs) {
    const ipcBin = fs.existsSync('/usr/local/bin/termux-ipc') 
        ? '/usr/local/bin/termux-ipc' 
        : (fs.existsSync('/usr/local/termux-shims/termux-ipc') ? '/usr/local/termux-shims/termux-ipc' : 'termux-ipc');
    try {
        return execSync(`${ipcBin} webview ${ipcArgs}`, { encoding: 'utf8' }).trim();
    } catch (e) {
        return e.stdout ? e.stdout.trim() : `Error: ${e.message}`;
    }
}

function evalJs(code) {
    const escaped = code.replace(/\\/g, '\\\\').replace(/"/g, '\\"');
    return runIpc(`eval "${escaped}"`);
}

async function ensurePortForward() {
    try {
        const unixOut = execSync("adb -s 127.0.0.1:5555 shell 'cat /proc/net/unix | grep devtools' 2>/dev/null").toString();
        const match = unixOut.match(/@(webview_devtools_remote_\d+)/);
        if (match) {
            execSync(`adb -s 127.0.0.1:5555 forward tcp:9222 localabstract:${match[1]}`);
        }
    } catch (_) {}
}

async function clearCdpCookies() {
    try {
        await ensurePortForward();
        const { chromium } = require('playwright-core');
        const browser = await chromium.connectOverCDP('http://127.0.0.1:9222');
        const contexts = browser.contexts();
        if (contexts.length > 0) {
            await contexts[0].clearCookies();
        }
        await browser.close();
        return true;
    } catch(e) {
        return false;
    }
}

async function injectSessionCookies(profile) {
    const dir = getSessionsDir();
    const sessionFile = path.join(dir, `${profile}.json`);
    if (!fs.existsSync(sessionFile)) return false;

    try {
        const raw = JSON.parse(fs.readFileSync(sessionFile, 'utf8'));
        if (!raw.cookies || raw.cookies.length === 0) return false;

        await ensurePortForward();
        const { chromium } = require('playwright-core');
        const browser = await chromium.connectOverCDP('http://127.0.0.1:9222');
        const contexts = browser.contexts();
        if (contexts.length > 0) {
            await contexts[0].clearCookies();
            await contexts[0].addCookies(raw.cookies);
            console.log(` ${GREEN}🔑 [COOKIE VAULT] Sesi login [${profile}] berhasil diinjeksi ke browser!${RESET}`);
        }
        await browser.close();
        return true;
    } catch (e) {
        return false;
    }
}

async function handleXPost(text, profile) {
    const targetProfile = profile || 'shaqilla';
    console.log(`${CYAN}🐦 [X-POST] Memulai posting ke X menggunakan profil: ${BOLD}${targetProfile}${RESET}`);
    
    // Pastikan cookies profil diinjeksi jika ada
    await injectSessionCookies(targetProfile);

    // 1. Buka komposer tweet X dengan profil yang diminta
    runIpc(`--profile ${targetProfile} https://x.com/compose/post`);
    console.log(`⏳ Menunggu halaman editor X siap...`);
    await sleep(3500);

    // 2. Skrip injeksi teks ke contenteditable Twitter / X
    const postScript = `
    (async function() {
        try {
            var editor = document.querySelector('[data-testid="tweetTextarea_0"]') || 
                         document.querySelector('div[contenteditable="true"]');
            if (!editor) return JSON.stringify({ error: "Editor tweet tidak ditemukan di halaman" });
            
            editor.focus();
            document.execCommand('selectAll', false, null);
            document.execCommand('delete', false, null);
            document.execCommand('insertText', false, "${text.replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/\n/g, '\\n')}");
            
            // Trigger input events
            editor.dispatchEvent(new Event('input', { bubbles: true }));
            editor.dispatchEvent(new Event('change', { bubbles: true }));
            
            await new Promise(r => setTimeout(r, 1000));
            
            var btn = document.querySelector('[data-testid="tweetButton"]') || 
                      document.querySelector('[data-testid="tweetButtonInline"]') ||
                      Array.from(document.querySelectorAll('button')).find(b => b.innerText && (b.innerText.includes('Post') || b.innerText.includes('Tweet')));
            
            if (!btn) return JSON.stringify({ error: "Tombol Post tidak ditemukan" });
            if (btn.disabled || btn.getAttribute('aria-disabled') === 'true') {
                return JSON.stringify({ error: "Tombol Post disabled" });
            }
            
            btn.click();
            return JSON.stringify({ success: true, text: "${text.substring(0, 30)}..." });
        } catch(e) {
            return JSON.stringify({ error: e.message });
        }
    })();
    `;

    const res = evalJs(postScript);
    console.log(`${GREEN}✔ Perintah kirim tweet telah dieksekusi.${RESET}`);
    return { success: true, profile: targetProfile, text };
}

async function handleSnapshot() {
    console.log(`${CYAN}📸 [DOM SNAPSHOT] Mengambil ringkasan elemen aktif di WebView...${RESET}`);
    const dumpFile = '/root/wallet/dom_dump.json';
    try { if (fs.existsSync(dumpFile)) fs.unlinkSync(dumpFile); } catch(_) {}
    
    runIpc('bridge');
    
    for (let i = 0; i < 10; i++) {
        await sleep(200);
        if (fs.existsSync(dumpFile)) {
            try {
                const data = JSON.parse(fs.readFileSync(dumpFile, 'utf8'));
                console.log(JSON.stringify(data, null, 2));
                return data;
            } catch(_) {}
        }
    }
    console.log(JSON.stringify({ status: "snapshot_requested", url: "active_page" }, null, 2));
}

async function handleOpenUrl(url, extraFlags = []) {
    let targetProfile = 'default';
    let flagsWithoutProfile = [];

    for (let i = 0; i < extraFlags.length; i++) {
        if (extraFlags[i] === '--profile' && extraFlags[i + 1]) {
            targetProfile = extraFlags[i + 1];
            i++;
        } else {
            flagsWithoutProfile.push(extraFlags[i]);
        }
    }

    const dir = getSessionsDir();
    const sessionFile = path.join(dir, `${targetProfile}.json`);
    const hasSession = fs.existsSync(sessionFile);

    console.log(`${CYAN}🌐 [AGENT-WEB] Membuka: ${BOLD}${url}${RESET} ${CYAN}(Profil: ${BOLD}${targetProfile}${RESET}${CYAN})${RESET}`);

    if (hasSession) {
        console.log(` ${GREEN}🔑 Sesi profil [${targetProfile}] ditemukan. Memulihkan cookies akun...${RESET}`);
        await injectSessionCookies(targetProfile);
    } else if (targetProfile !== 'default') {
        console.log(` ${YELLOW}⚡ Profil baru [${targetProfile}] belum ada sesi. Membersihkan cookies agar 100% FRESH...${RESET}`);
        await clearCdpCookies();
    }

    let fullFlags = `--profile ${targetProfile}`;
    if (flagsWithoutProfile.length > 0) {
        fullFlags += ` ${flagsWithoutProfile.join(' ')}`;
    }

    const res = runIpc(`${fullFlags} ${url}`);
    if (res) console.log(res);
}

async function main() {
    const args = process.argv.slice(2);
    const cmd = args[0] ? args[0].toLowerCase() : '';

    if (!cmd || cmd === '--help' || cmd === 'help') {
        console.log(`\n${CYAN}${BOLD}🤖 AGENT-WEB CONTROLLER (Universal Web Automation for AI Agents)${RESET}`);
        console.log(`Pengendali browser otonom untuk Antigravity, Subagents, dan CLI.\n`);
        console.log(`Usage:`);
        console.log(`  ${GREEN}web open <url> [--profile <nama>] [--wallet <name>]${RESET}`);
        console.log(`  ${GREEN}web <url> [--profile <nama>]${RESET}  (Shortcut instan membuka URL)`);
        console.log(`  ${GREEN}web x-post "teks tweet" [--profile <nama>]${RESET}`);
        console.log(`  ${GREEN}web prompt "instruksi cerdas / multi-step"${RESET}`);
        console.log(`  ${GREEN}web click "Nama Tombol"${RESET}`);
        console.log(`  ${GREEN}web type "Kolom" "Nilai yang diisi"${RESET}`);
        console.log(`  ${GREEN}web snapshot${RESET} (Ekstrak DOM aktif)`);
        console.log(`  ${GREEN}web clear-cookies${RESET} (Bersihkan cookies aktif agar 100% fresh)`);
        console.log(`  ${GREEN}web eval "kode JavaScript"${RESET}`);
        console.log(`  ${GREEN}web close${RESET}\n`);
        process.exit(0);
    }

    if (cmd === 'clear-cookies' || cmd === 'clearcookies' || cmd === 'clean') {
        console.log(`${CYAN}🧹 Membersihkan seluruh cookies & storage aktif...${RESET}`);
        await clearCdpCookies();
        runIpc('clear-cache');
        console.log(`${GREEN}✔ Selesai! Browser aktif kini 100% FRESH.${RESET}`);
        process.exit(0);
    }

    if (cmd === 'x-post' || cmd === 'post-x' || cmd === 'tweet') {
        let profile = 'shaqilla';
        let textArgs = [];
        for (let i = 1; i < args.length; i++) {
            if (args[i] === '--profile' && args[i + 1]) {
                profile = args[i + 1];
                i++;
            } else {
                textArgs.push(args[i]);
            }
        }
        const tweetText = textArgs.join(' ').trim();
        if (!tweetText) {
            console.log(`${RED}Error: Masukkan teks yang ingin diposting!${RESET}`);
            console.log(`Contoh: web x-post "Halo dunia Web3!" --profile shaqilla`);
            process.exit(1);
        }
        await handleXPost(tweetText, profile);
        process.exit(0);
    }

    if (cmd === 'open') {
        const url = args[1];
        if (!url) {
            console.log(`${RED}Error: Masukkan URL yang ingin dibuka!${RESET}`);
            process.exit(1);
        }
        const extraFlags = args.slice(2);
        await handleOpenUrl(url, extraFlags);
        process.exit(0);
    }

    // Shortcut: jika perintah berupa URL (contoh: web x.com --profile eryziggy)
    if (cmd.startsWith('http://') || cmd.startsWith('https://') || cmd.includes('.')) {
        const url = args[0];
        const extraFlags = args.slice(1);
        await handleOpenUrl(url, extraFlags);
        process.exit(0);
    }

    if (cmd === 'prompt') {
        const promptText = args.slice(1).join(' ').trim();
        if (!promptText) {
            console.log(`${RED}Error: Masukkan teks prompt!${RESET}`);
            process.exit(1);
        }
        runIpc(`prompt "${promptText}"`);
        process.exit(0);
    }

    if (cmd === 'click') {
        const target = args.slice(1).join(' ').trim();
        runIpc(`prompt "klik ${target}"`);
        process.exit(0);
    }

    if (cmd === 'type' || cmd === 'fill') {
        const field = args[1];
        const val = args.slice(2).join(' ').trim();
        runIpc(`prompt "isi ${field} ${val}"`);
        process.exit(0);
    }

    if (cmd === 'snapshot' || cmd === 'dom') {
        await handleSnapshot();
        process.exit(0);
    }

    if (cmd === 'eval') {
        const js = args.slice(1).join(' ').trim();
        const res = evalJs(js);
        if (res) console.log(res);
        process.exit(0);
    }

    if (cmd === 'close') {
        runIpc('close');
        console.log(`${GREEN}✔ WebView ditutup.${RESET}`);
        process.exit(0);
    }

    // Default: teruskan ke termux-ipc webview
    const output = runIpc(args.join(' '));
    if (output) console.log(output);
}

main().catch(err => {
    console.error(`${RED}Error: ${err.message}${RESET}`);
    process.exit(1);
});

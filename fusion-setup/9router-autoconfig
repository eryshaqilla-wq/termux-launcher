      cfg["$schema"] = "https://opencode.ai/config.json";
      cfg.provider = cfg.provider || {};
      cfg.provider["9router"] = {
        npm: "@ai-sdk/openai-compatible",
        name: "9Router Multi-Account",
        options: {
          baseURL: BASE_URL,
          apiKey: apiKey

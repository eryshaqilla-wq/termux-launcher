      models.forEach(m => {
        const cleanName = m.replace("ag/", "");
        cfg.provider["9router"].models[m] = {
          name: `${cleanName} (9Router)`
        };
      });
      cfg.model = `9router/${models[0]}`;
      fs.writeFileSync(cfgPath, JSON.stringify(cfg, null, 2), "utf8");
      return true;
    }
  },
  {
    id: "openclaw",
    name: "OpenClaw",
    detect: () => {
      try {
        const bin = execSync("which openclaw 2>/dev/null", { encoding: "utf8" }).trim();
        if (bin) return true;
      } catch {}
      return fs.existsSync(path.join(HOME, ".openclaw")) ||
             fs.existsSync("/usr/local/bin/openclaw");
    },
    version: () => {
      try {
        return execSync("openclaw --version 2>/dev/null", { encoding: "utf8" }).trim().split("\n")[0];
      } catch {
        return "terpasang";
      }
    },
    configPath: path.join(HOME, ".openclaw", "openclaw.json"),
    isConfigured: (cfgPath) => {
      if (!fs.existsSync(cfgPath)) return false;
      try {
        const content = fs.readFileSync(cfgPath, "utf8");
        return content.includes("127.0.0.1:20128") || content.includes(":20128");
      } catch {
        return false;
      }
    },
    configure: (cfgPath, apiKey, models) => {
      fs.mkdirSync(path.dirname(cfgPath), { recursive: true });
      let cfg = {};
      if (fs.existsSync(cfgPath)) {
        try { cfg = JSON.parse(fs.readFileSync(cfgPath, "utf8")); } catch {}
      }
      cfg.models = cfg.models || {};
      cfg.models.mode = cfg.models.mode || "merge";
      cfg.models.providers = cfg.models.providers || {};
      cfg.models.providers["9router"] = {
        baseUrl: BASE_URL,
        apiKey: apiKey,
        api: "openai-completions",
        models: models.map(m => ({
          id: m,
          name: `${m.replace("ag/", "")} (9Router)`,
          contextWindow: 1000000,
          maxTokens: 65536
        }))
      };
      fs.writeFileSync(cfgPath, JSON.stringify(cfg, null, 2), "utf8");
      return true;
    }
  },
  {
    id: "hermes",
    name: "Hermes Agent",
    detect: () => {
      try {
        const bin = execSync("which hermes 2>/dev/null", { encoding: "utf8" }).trim();
        if (bin) return true;
      } catch {}
      return fs.existsSync(path.join(HOME, ".hermes"));
    },
    version: () => "terpasang",
    configPath: path.join(HOME, ".hermes", "config.json"),
    isConfigured: (cfgPath) => {
      if (!fs.existsSync(cfgPath)) return false;
      try {
        const content = fs.readFileSync(cfgPath, "utf8");
        return content.includes(":20128");
      } catch {
        return false;
      }
    },
    configure: (cfgPath, apiKey, models) => {
      fs.mkdirSync(path.dirname(cfgPath), { recursive: true });
      let cfg = {};
      if (fs.existsSync(cfgPath)) {
        try { cfg = JSON.parse(fs.readFileSync(cfgPath, "utf8")); } catch {}
      }
      cfg.openai_base_url = BASE_URL;
      cfg.openai_api_key = apiKey;
      cfg.default_model = models[0];
      fs.writeFileSync(cfgPath, JSON.stringify(cfg, null, 2), "utf8");
      return true;
    }
  },
  {
    id: "aider",
    name: "Aider",
    detect: () => {
      try {
        const bin = execSync("which aider 2>/dev/null", { encoding: "utf8" }).trim();
        return !!bin;
      } catch {
        return false;
      }
    },
    version: () => {
      try {
        return execSync("aider --version 2>/dev/null", { encoding: "utf8" }).trim();
      } catch {
        return "terpasang";
      }
    },
    configPath: path.join(HOME, ".aider.conf.yml"),
    isConfigured: (cfgPath) => {
      if (!fs.existsSync(cfgPath)) return false;
      try {
        return fs.readFileSync(cfgPath, "utf8").includes(":20128");
      } catch {
        return false;
      }
    },
    configure: (cfgPath, apiKey, models) => {
      const content = `# Aider configuration for 9Router Multi-Account
openai-api-base: ${BASE_URL}
openai-api-key: ${apiKey}
model: openai/${models[0]}
`;
      fs.writeFileSync(cfgPath, content, "utf8");
      return true;
    }
  },
  {
    id: "continue",
    name: "Continue.dev",
    detect: () => fs.existsSync(path.join(HOME, ".continue")),
    version: () => "terpasang",
    configPath: path.join(HOME, ".continue", "config.json"),
    isConfigured: (cfgPath) => {
      if (!fs.existsSync(cfgPath)) return false;
      try {
        return fs.readFileSync(cfgPath, "utf8").includes(":20128");
      } catch {
        return false;
      }
    },
    configure: (cfgPath, apiKey, models) => {
      fs.mkdirSync(path.dirname(cfgPath), { recursive: true });
      let cfg = {};
      if (fs.existsSync(cfgPath)) {
        try { cfg = JSON.parse(fs.readFileSync(cfgPath, "utf8")); } catch {}
      }
      cfg.models = cfg.models || [];
      const routerModel = {
        title: "9Router AI (Antigravity)",
        provider: "openai",
        model: models[0],
        apiBase: BASE_URL,
        apiKey: apiKey
      };
      cfg.models = cfg.models.filter(m => !m.apiBase || !m.apiBase.includes(":20128"));
      cfg.models.unshift(routerModel);
      fs.writeFileSync(cfgPath, JSON.stringify(cfg, null, 2), "utf8");
      return true;
    }
  },
  {
    id: "shell_env",
    name: "Shell AI Environment (~/.zshrc)",
    detect: () => fs.existsSync(path.join(HOME, ".zshrc")) || fs.existsSync(path.join(HOME, ".bashrc")),
    version: () => "zsh/bash",
    configPath: path.join(HOME, ".zshrc"),
    isConfigured: (cfgPath) => {
      if (!fs.existsSync(cfgPath)) return false;
      try {
        return fs.readFileSync(cfgPath, "utf8").includes("FUSION_9ROUTER_ENV=1");
      } catch {
        return false;
      }
    },
    configure: (cfgPath, apiKey) => {
      const zshrc = path.join(HOME, ".zshrc");
      if (fs.existsSync(zshrc)) {
        let text = fs.readFileSync(zshrc, "utf8");
        // Hapus blok lama jika ada
        text = text.replace(/# >>> 9router env >>>[\s\S]*?# <<< 9router env <<<\n?/g, "");
        const block = `
# >>> 9router env >>>
export OPENAI_BASE_URL="${BASE_URL}"
export OPENAI_API_BASE="${BASE_URL}"
export OPENAI_API_KEY="${apiKey}"
export FUSION_9ROUTER_ENV=1
# <<< 9router env <<<
`;
        fs.writeFileSync(zshrc, text.trim() + "\n" + block, "utf8");
      }
      return true;
    }
  }
];

function getDetectedInstalledClients() {
  const list = [];
  for (const client of CLIENT_DEFINITIONS) {
    if (client.detect()) {
      const isConf = client.isConfigured(client.configPath);
      list.push({
        id: client.id,
        name: client.name,
        version: client.version(),
        isConfigured: isConf,
        configPath: client.configPath
      });
    }
  }
  return list;
}

// Subcommand handling
const args = process.argv.slice(2);
const command = args[0] || "interactive";

if (command === "apikey" || command === "--apikey") {
  const apiKey = getApiKey();
  console.log(apiKey || "");
  process.exit(0);
}

if (command === "model" || command === "models" || command === "set-model") {
  const targetModel = args[1];
  const models = getModelsList();
  const current = getCurrentModel();

  if (targetModel) {
    const applied = setModel(targetModel);
    console.log(`\n================== 9ROUTER MODEL SWITCHER ==================`);
    console.log(`✅ Model aktif 9Router berhasil diubah ke: \x1b[32m${applied}\x1b[0m`);
    console.log(`   • OpenCode   : 9router/${applied}`);
    console.log(`   • OpenClaw   : ${applied}`);
    console.log(`   • Shell Env  : ${applied}`);
    console.log(`============================================================\n`);
    process.exit(0);
  }

  // Interaktif
  console.log("\n================== 9ROUTER MODEL SELECTOR ==================");
  console.log(`📡 Gateway Endpoint    : ${BASE_URL}`);
  console.log(`🤖 Model Aktif Saat Ini: \x1b[32m${current}\x1b[0m`);
  console.log("------------------------------------------------------------");
  console.log("Daftar Model Antigravity yang Tersedia di 9Router:");
  models.forEach((m, idx) => {
    const isCur = (m === current);
    const badge = isCur ? " \x1b[32m[🟢 AKTIF]\x1b[0m" : "";
    console.log(`  ${String(idx + 1).padStart(2, " ")}. ${m}${badge}`);
  });
  console.log("------------------------------------------------------------");

  const readline = require("readline");
  const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
  rl.question(`Pilih nomor model untuk diaktifkan [1-${models.length}, Q]: `, (ans) => {
    rl.close();
    const c = ans.trim();
    if (!c || c.toUpperCase() === "Q") {
      console.log("Dibatalkan.");
      process.exit(0);
    }
    const num = parseInt(c, 10);
    if (num >= 1 && num <= models.length) {
      const chosen = models[num - 1];
      const applied = setModel(chosen);
      console.log(`\n================== 9ROUTER MODEL SWITCHER ==================`);
      console.log(`✅ Model aktif 9Router berhasil diubah ke: \x1b[32m${applied}\x1b[0m`);
      console.log(`   • OpenCode   : 9router/${applied}`);
      console.log(`   • OpenClaw   : ${applied}`);
      console.log(`   • Shell Env  : ${applied}`);
      console.log(`============================================================\n`);
    } else {
      console.log("Nomor model tidak valid.");
      process.exit(1);
    }
  });
}

if (command === "list" || command === "json" || command === "--json") {
  const models = getModelsList();
  const installed = getDetectedInstalledClients();
  const apiKey = getApiKey();
  console.log(JSON.stringify({
    apiKey: apiKey,
    maskedApiKey: apiKey ? (apiKey.substring(0, 7) + "..." + apiKey.substring(apiKey.length - 4)) : "",
    endpoint: BASE_URL,
    defaultModel: models[0],
    models: models,
    clients: installed
  }, null, 2));
  process.exit(0);
}

if (command === "apply") {
  const targetIds = args.slice(1);
  const models = getModelsList();
  const apiKey = getApiKey();
  const installed = getDetectedInstalledClients();
  const toConfigure = targetIds.includes("all") ? installed.map(c => c.id) : targetIds;

  const results = [];
  for (const client of CLIENT_DEFINITIONS) {
    if (toConfigure.includes(client.id)) {
      try {
        const ok = client.configure(client.configPath, apiKey, models);
        results.push({ id: client.id, name: client.name, success: ok });
      } catch (e) {
        results.push({ id: client.id, name: client.name, success: false, error: e.message });
      }
    }
  }

  if (args.includes("--json")) {
    console.log(JSON.stringify(results));
  } else {
    console.log("\n================== 9ROUTER AUTO-CONFIG ==================");
    console.log(`Endpoint : ${BASE_URL}`);
    console.log(`Model    : ${models[0]} (${models.length} model terdaftar di 9Router)`);
    console.log(`API Key  : ${apiKey.substring(0, 7)}...`);
    console.log("---------------------------------------------------------");
    results.forEach(r => {
      if (r.success) {
        console.log(`  ✅ [BERHASIL] ${r.name} tersambung ke 9Router.`);
      } else {
        console.log(`  ❌ [GAGAL] ${r.name}: ${r.error}`);
      }
    });
    console.log("=========================================================\n");
  }
  process.exit(0);
}

// Tampilan CLI Interaktif
const readline = require("readline");
const installed = getDetectedInstalledClients();
const models = getModelsList();
const apiKey = getApiKey();

console.log("\n================== 9ROUTER CLIENT AUTO-CONFIG ==================");
console.log(`📡 Gateway Endpoint : ${BASE_URL}`);
console.log(`🤖 Model 9Router    : ${models[0]} (dan ${models.length - 1} varian lainnya)`);
console.log(`🔑 9Router API Key  : ${apiKey.substring(0, 7)}...${apiKey.substring(apiKey.length - 4)}`);
console.log("----------------------------------------------------------------");

if (installed.length === 0) {
  console.log("⚠️ Tidak ada klien AI yang terdeteksi terpasang di sistem ini.");
  console.log("  Pasang OpenCode (opencode), OpenClaw, atau Aider terlebih dahulu.\n");
  process.exit(0);
}

console.log("Klien AI yang Terdeteksi di Sistem:");
installed.forEach((c, idx) => {
  const badge = c.isConfigured ? "\x1b[32m[🟢 Terhubung ke 9Router]\x1b[0m" : "\x1b[33m[⚪ Belum Terhubung]\x1b[0m";
  console.log(`  ${idx + 1}. ${c.name} (${c.version}) ${badge}`);
  console.log(`     Config: ${c.configPath}`);
});
console.log(`  A. Konfigurasi SEMUA klien terdeteksi`);
console.log(`  Q. Keluar`);
console.log("----------------------------------------------------------------");

const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
rl.question("Pilih nomor klien yang ingin dihubungkan ke 9Router [1-" + installed.length + ", A, Q]: ", (answer) => {
  rl.close();
  const choice = answer.trim().toUpperCase();
  if (choice === "Q" || !choice) {
    console.log("Dibatalkan.");
    process.exit(0);
  }

  let selected = [];
  if (choice === "A") {
    selected = installed.map(c => c.id);
  } else {
    const num = parseInt(choice, 10);
    if (num >= 1 && num <= installed.length) {
      selected = [installed[num - 1].id];
    } else {
      console.log("Pilihan tidak valid.");
      process.exit(1);
    }
  }

  execSync(`/usr/local/bin/9router-autoconfig apply ${selected.join(" ")}`, { stdio: "inherit" });
});

#!/usr/bin/env node

/**
 * ⚡ 9ROUTER UNIVERSAL AI CLIENT AUTO-CONFIG ENGINE
 * Mendeteksi klien AI yang terpasang (OpenCode, OpenClaw, Hermes, Aider, dll),
 * membaca status koneksi ke 9Router, dan menginjeksi konfigurasi 9Router secara otomatis.
 */

const fs = require("fs");
const path = require("path");
const { execSync } = require("child_process");
const os = require("os");

const HOME = os.homedir();
const PORT = 20128;
const BASE_URL = `http://127.0.0.1:${PORT}/v1`;

// Ambil API Key dari data.sqlite
function getApiKey() {
  const dbPaths = [
    path.join(HOME, ".9router", "db", "data.sqlite"),
    "/root/.9router/db/data.sqlite",
    "/data/data/com.termux/files/home/.9router/db/data.sqlite"
  ];
  for (const p of dbPaths) {
    if (fs.existsSync(p)) {
      try {
        const { DatabaseSync } = require("node:sqlite");
        const db = new DatabaseSync(p);
        const row = db.prepare("SELECT key FROM apiKeys WHERE isActive = 1 LIMIT 1").get() ||
                    db.prepare("SELECT key FROM apiKeys LIMIT 1").get();
        db.close();
        if (row && row.key) return row.key.trim();
      } catch {
        try {
          const out = execSync(`sqlite3 "${p}" "SELECT key FROM apiKeys LIMIT 1" 2>/dev/null`, { encoding: "utf8" }).trim();
          if (out) return out;
        } catch {}
      }
    }
  }
  return "sk-9router-local-key";
}

// Ambil daftar model dari live server 9Router, cache riil, atau catalog Antigravity
function getModelsList() {
  const apiKey = getApiKey();
  const liveModelsPath = path.join(HOME, ".9router", "live-models.json");
  const prio = [
    "ag/gemini-3.8-flash-medium",
    "ag/gemini-3.8-flash-high",
    "ag/gemini-3.8-flash-low",
    "ag/claude-sonnet-5-5",
    "ag/claude-sonnet-5-5-high",
    "ag/claude-sonnet-5-5-medium",
    "ag/claude-sonnet-5-5-low",
    "ag/claude-opus-5-5",
    "ag/claude-opus-5-5-high",
    "ag/claude-opus-5-5-medium",
    "ag/claude-opus-5-5-low",
    "ag/gemini-3.7-flash-high",
    "ag/gemini-3.7-flash-medium",
    "ag/gemini-3.7-flash-low",
    "ag/gemini-3.1-pro-high",
    "ag/gemini-3.1-pro-low",
    "ag/gemini-pro-agent",
    "ag/claude-sonnet-4-6",
    "ag/claude-opus-4-6-thinking",
    "ag/gpt-oss-120b-medium"
  ];

  function sortModels(ids) {
    const sorted = [];
    prio.forEach(p => { if (ids.includes(p)) sorted.push(p); });
    ids.forEach(id => { if (!sorted.includes(id)) sorted.push(id); });
    return sorted;
  }

  // 1. Ambil real-time langsung dari live server 9Router via /v1/models
  try {
    const out = execSync(`curl -s -m 2 http://127.0.0.1:${PORT}/v1/models -H "Authorization: Bearer ${apiKey}" 2>/dev/null`, { encoding: "utf8" });
    const json = JSON.parse(out);
    if (json && json.data && Array.isArray(json.data)) {
      const ids = json.data.map(m => m.id).filter(id => id.startsWith("ag/"));
      if (ids.length > 0) {
        try { fs.writeFileSync(liveModelsPath, out, "utf8"); } catch {}
        return sortModels(ids);
      }
    }
  } catch {}

  // 2. Ambil dari cache riil hasil query server sebelumnya (jika Next.js sedang tidur/standby)
  if (fs.existsSync(liveModelsPath)) {
    try {
      const data = JSON.parse(fs.readFileSync(liveModelsPath, "utf8"));
      if (data && data.data && Array.isArray(data.data)) {
        const ids = data.data.map(m => m.id).filter(id => id.startsWith("ag/"));
        if (ids.length > 0) return sortModels(ids);
      }
    } catch {}
  }

  // 3. Fallback riil lengkap mencakup seluruh tier (High, Medium, Low)
  return [
    "ag/gemini-3.8-flash-medium",
    "ag/gemini-3.8-flash-high",
    "ag/gemini-3.8-flash-low",
    "ag/claude-sonnet-5-5",
    "ag/claude-sonnet-5-5-high",
    "ag/claude-sonnet-5-5-medium",
    "ag/claude-sonnet-5-5-low",
    "ag/claude-opus-5-5",
    "ag/claude-opus-5-5-high",
    "ag/claude-opus-5-5-medium",
    "ag/claude-opus-5-5-low",
    "ag/gemini-3.7-flash-high",
    "ag/gemini-3.7-flash-medium",
    "ag/gemini-3.7-flash-low",
    "ag/gemini-3.1-pro-high",
    "ag/gemini-3.1-pro-low",
    "ag/gemini-pro-agent",
    "ag/claude-sonnet-4-6",
    "ag/claude-opus-4-6-thinking",
    "ag/gpt-oss-120b-medium"
  ];
}

function getCurrentModel() {
  const prefPath = path.join(HOME, ".9router", "current-model");
  if (fs.existsSync(prefPath)) {
    const m = fs.readFileSync(prefPath, "utf8").trim();
    if (m) return m;
  }
  const opencodeJson = path.join(HOME, ".config", "opencode", "opencode.json");
  if (fs.existsSync(opencodeJson)) {
    try {
      const cfg = JSON.parse(fs.readFileSync(opencodeJson, "utf8"));
      if (cfg && cfg.model) {
        return cfg.model.replace("9router/", "");
      }
    } catch {}
  }
  return "ag/gemini-3.8-flash-medium";
}

function setModel(targetModel) {
  const models = getModelsList();
  let matched = models.find(m => m.toLowerCase() === targetModel.toLowerCase());
  if (!matched) {
    matched = models.find(m => m.toLowerCase().includes(targetModel.toLowerCase()));
  }
  if (!matched) {
    matched = targetModel.startsWith("ag/") ? targetModel : `ag/${targetModel}`;
  }

  try {
    fs.mkdirSync(path.join(HOME, ".9router"), { recursive: true });
    fs.writeFileSync(path.join(HOME, ".9router", "current-model"), matched, "utf8");
  } catch {}

  const apiKey = getApiKey();

  // 1. Update OpenCode
  const opencodeCfg = path.join(HOME, ".config", "opencode", "opencode.json");
  if (fs.existsSync(opencodeCfg)) {
    try {
      let cfg = JSON.parse(fs.readFileSync(opencodeCfg, "utf8"));
      cfg.provider = cfg.provider || {};
      cfg.provider["9router"] = cfg.provider["9router"] || {
        npm: "@ai-sdk/openai-compatible",
        name: "9Router Multi-Account",
        options: { baseURL: BASE_URL, apiKey: apiKey },
        models: {}
      };
      models.forEach(m => {
        const cleanName = m.replace("ag/", "");
        cfg.provider["9router"].models[m] = { name: `${cleanName} (9Router)` };
      });
      cfg.model = `9router/${matched}`;
      fs.writeFileSync(opencodeCfg, JSON.stringify(cfg, null, 2), "utf8");
    } catch {}
  }

  // 2. Update OpenClaw
  const openclawCfg = path.join(HOME, ".openclaw", "openclaw.json");
  if (fs.existsSync(openclawCfg)) {
    try {
      let cfg = JSON.parse(fs.readFileSync(openclawCfg, "utf8"));
      cfg.model = matched;
      fs.writeFileSync(openclawCfg, JSON.stringify(cfg, null, 2), "utf8");
    } catch {}
  }

  // 3. Update Shell AI Env (~/.zshrc)
  const zshrc = path.join(HOME, ".zshrc");
  if (fs.existsSync(zshrc)) {
    try {
      let text = fs.readFileSync(zshrc, "utf8");
      text = text.replace(/# >>> 9router env >>>[\s\S]*?# <<< 9router env <<<\n?/g, "");
      const block = `
# >>> 9router env >>>
export OPENAI_BASE_URL="${BASE_URL}"
export OPENAI_API_BASE="${BASE_URL}"
export OPENAI_API_KEY="${apiKey}"
export OPENAI_MODEL="${matched}"
export FUSION_9ROUTER_ENV=1
# <<< 9router env <<<
`;
      fs.writeFileSync(zshrc, text.trim() + "\n" + block, "utf8");
    } catch {}
  }

  return matched;
}

// Definisi Klien yang Didukung
const CLIENT_DEFINITIONS = [
  {
    id: "opencode",
    name: "OpenCode",
    detect: () => {
      try {
        const bin = execSync("which opencode 2>/dev/null", { encoding: "utf8" }).trim();
        if (bin) return true;
      } catch {}
      return fs.existsSync(path.join(HOME, ".opencode", "bin", "opencode")) ||
             fs.existsSync("/usr/local/bin/opencode");
    },
    version: () => {
      try {
        return execSync("opencode --version 2>/dev/null", { encoding: "utf8" }).trim();
      } catch {
        return "terpasang";
      }
    },
    configPath: path.join(HOME, ".config", "opencode", "opencode.json"),
    isConfigured: (cfgPath) => {

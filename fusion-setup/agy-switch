// --- DATABASE HELPER (node:sqlite dengan fallback sqlite3 cli) ---
let sqliteDb = null;
function getDb() {
  if (sqliteDb) return sqliteDb;
  try {
    const { DatabaseSync } = require("node:sqlite");
    sqliteDb = new DatabaseSync(DB_PATH);
    return sqliteDb;
  } catch {
    return null;
  }
}

function queryDb(sql, params = []) {
  const db = getDb();
  if (db) {
    try {
      const stmt = db.prepare(sql);
      return stmt.all(...params);
    } catch {}
  }
  try {
    const jsonStr = execSync(`sqlite3 -json "${DB_PATH}" "${sql.replace(/"/g, '\\"')}"`, { encoding: "utf8" });
    return jsonStr ? JSON.parse(jsonStr) : [];
  } catch {
    return [];
  }
}

function executeDb(sql, params = []) {
  const db = getDb();
  if (db) {
    try {
      const stmt = db.prepare(sql);
      return stmt.run(...params);
    } catch {}
  }
  try {
    execSync(`sqlite3 "${DB_PATH}" "${sql.replace(/"/g, '\\"')}"`, { encoding: "utf8" });
    return true;
  } catch {
    return false;
  }
}

// --- GOOGLE OAUTH & TOKEN HELPERS ---
function refreshGoogleToken(refreshToken) {
  return new Promise((resolve, reject) => {
    const postData = new URLSearchParams({
      client_id: CLIENT_ID,
      client_secret: CLIENT_SECRET,
      grant_type: "refresh_token",
      refresh_token: refreshToken
    }).toString();

    const req = https.request("https://oauth2.googleapis.com/token", {
      method: "POST",
      headers: {
        "Content-Type": "application/x-www-form-urlencoded",
        "User-Agent": "antigravity/ide/1.0.0 darwin/arm64"
      },
      timeout: 10000
    }, (res) => {
      let data = "";
      res.on("data", chunk => data += chunk);
      res.on("end", () => {
        try {
          const parsed = JSON.parse(data);
          if (parsed.error) return reject(new Error(parsed.error_description || parsed.error));
          resolve(parsed);
        } catch (e) {
          reject(e);
        }
      });
    });
    req.on("error", reject);
    req.on("timeout", () => {
      req.destroy();
      reject(new Error("Timeout menghubungi server token Google"));
    });
    req.write(postData);
    req.end();
  });
}

function getEmailFromJwt(idToken) {
  try {
    if (!idToken || typeof idToken !== "string") return null;
    const parts = idToken.split(".");
    if (parts.length >= 2) {
      let payload = parts[1];
      payload += "=".repeat((-payload.length % 4 + 4) % 4);
      const decoded = JSON.parse(Buffer.from(payload, "base64").toString("utf8"));
      return decoded.email || null;
    }
  } catch {}
  return null;
}

function checkCloudCodeTier(accessToken) {
  return new Promise((resolve) => {
    const req = https.request("https://cloudcode-pa.googleapis.com/v1internal:loadCodeAssist", {
      method: "POST",
      headers: {
        "Authorization": `Bearer ${accessToken}`,
        "Content-Type": "application/json",
        "User-Agent": "antigravity/ide/1.0.0 darwin/arm64"
      },
      timeout: 8000
    }, (res) => {
      let data = "";
      res.on("data", chunk => data += chunk);
      res.on("end", () => {
        try {
          const parsed = JSON.parse(data);
          resolve(parsed);
        } catch {
          resolve(null);
        }
      });
    });
    req.on("error", () => resolve(null));
    req.on("timeout", () => { req.destroy(); resolve(null); });
    req.write(JSON.stringify({}));
    req.end();
  });
}

// --- AKUN & SINKRONISASI ---
function getActiveAccountName() {
  if (fs.existsSync(ACTIVE_FILE)) {
    return fs.readFileSync(ACTIVE_FILE, "utf8").trim();
  }
  if (fs.existsSync(TOKEN_DEST)) {
    try {
      const data = JSON.parse(fs.readFileSync(TOKEN_DEST, "utf8"));
      if (data.id_token_email) {
        return data.id_token_email.split("@")[0];
      }
    } catch {}
  }
  return "unknown";
}

function listAccounts() {
  const activeName = getActiveAccountName();
  const files = fs.readdirSync(ACCOUNTS_DIR).filter(f => f.endsWith(".json"));

  // Ambil data usage dan priority dari 9router database
  let dbAccountsMap = {};
  try {
    const rows = queryDb(`
      SELECT pc.id, pc.email, pc.priority, pc.isActive, pc.data, pc.updatedAt,
             COUNT(uh.id) as reqCount,
             COALESCE(SUM(uh.promptTokens), 0) as promptTokens,
             COALESCE(SUM(uh.completionTokens), 0) as compTokens,
             COALESCE(SUM(uh.cost), 0) as cost,
             MAX(uh.timestamp) as lastUsed
      FROM providerConnections pc
      LEFT JOIN usageHistory uh ON pc.id = uh.connectionId
      WHERE pc.provider = 'antigravity'
      GROUP BY pc.id
      ORDER BY pc.priority ASC
    `);
    for (const r of rows) {
      const email = r.email || "";
      const baseName = email.split("@")[0];
      dbAccountsMap[email] = r;
      dbAccountsMap[baseName] = r;
    }
  } catch {}

  const rawList = [];

  for (const f of files) {
    const accName = path.basename(f, ".json");
    const filePath = path.join(ACCOUNTS_DIR, f);
    let accData = {};
    try {
      accData = JSON.parse(fs.readFileSync(filePath, "utf8"));
    } catch {
      continue;
    }

    const tokenObj = accData.token || {};
    const email = accData.id_token_email || getEmailFromJwt(accData.id_token) || `${accName}@gmail.com`;
    const dbInfo = dbAccountsMap[email] || dbAccountsMap[accName] || null;

    const hasRefreshToken = Boolean(tokenObj.refresh_token);
    let isExpired = false;
    let isRevoked = false;
    let expiryStr = tokenObj.expiry || "";

    // Sesi akun Google OAuth hanya expired jika:
    // 1. Tidak memiliki refresh_token DAN access_token 1-jam sudah habis masa berlakunya.
    // 2. Refresh token di-revoke / invalid di database 9Router atau provider error.
    // Jika refresh_token ada dan valid, sesi adalah PERMANEN & AKTIF (access_token auto-refresh saat dipakai).
    if (!hasRefreshToken) {
      if (expiryStr) {
        const expDate = new Date(expiryStr);
        if (!isNaN(expDate.getTime()) && expDate.getTime() < Date.now()) {
          isExpired = true;
        }
      } else {
        isExpired = true;
      }
    } else {
      let dbData = {};
      try { dbData = JSON.parse(dbInfo?.data || "{}"); } catch {}
      if (dbInfo && (dbInfo.isActive === 0 && (dbData.errorCode || dbData.testStatus === "failed"))) {
        isRevoked = true;
        isExpired = true;
      }
    }

    const isActive = (accName === activeName || email === activeName);
    const priority = dbInfo ? Number(dbInfo.priority) : 999;

    rawList.push({
      name: accName,
      email: email,
      isActive: isActive,
      filePath: filePath,
      priority: priority,
      is9RouterActive: dbInfo ? Boolean(dbInfo.isActive) : true,
      connectionId: dbInfo ? dbInfo.id : null,
      reqCount: dbInfo ? Number(dbInfo.reqCount) : 0,
      promptTokens: dbInfo ? Number(dbInfo.promptTokens) : 0,
      completionTokens: dbInfo ? Number(dbInfo.compTokens) : 0,
      cost: dbInfo ? Number(dbInfo.cost) : 0,
      lastUsed: dbInfo ? dbInfo.lastUsed : null,
      expiry: expiryStr,
      isExpired: isExpired,
      isRevoked: isRevoked,
      hasRefreshToken: hasRefreshToken
    });
  }

  // Urutkan akun berdasarkan Priority 9Router secara presisi
  rawList.sort((a, b) => {
    if (a.priority !== b.priority) return a.priority - b.priority;
    return a.name.localeCompare(b.name);
  });

  // Pasang index urut 1, 2, 3...
  return rawList.map((item, idx) => ({
    ...item,
    index: idx + 1
  }));
}

function switchToAccount(target) {
  const accounts = listAccounts();
  if (accounts.length === 0) {
    throw new Error("Tidak ada akun Antigravity yang tersimpan di " + ACCOUNTS_DIR);
  }

  let selected = null;
  // Jika target angka
  if (/^\d+$/.test(String(target).trim())) {
    const idx = parseInt(target, 10);
    selected = accounts.find(a => a.index === idx);
  } else {
    // Target berupa nama atau email
    const lower = String(target).trim().toLowerCase();
    selected = accounts.find(a => a.name.toLowerCase() === lower || a.email.toLowerCase() === lower);
  }

  if (!selected) {
    throw new Error(`Akun '${target}' tidak ditemukan!`);
  }

  // Baca berkas akun yang dipilih
  const fileContent = fs.readFileSync(selected.filePath, "utf8");
  const parsed = JSON.parse(fileContent);

  // Jika token expired atau mendekati expired (<5 menit), coba refresh otomatis
  let refreshed = false;
  const tokenObj = parsed.token || {};
  if (tokenObj.refresh_token) {
    let needRefresh = false;
    if (!tokenObj.expiry) {
      needRefresh = true;
    } else {
      const expTime = new Date(tokenObj.expiry).getTime();
      if (isNaN(expTime) || expTime - Date.now() < 5 * 60 * 1000) {
        needRefresh = true;
      }
    }

    if (needRefresh) {
      try {
        const ref = execSync(`python3 -c "
import urllib.request, urllib.parse, json
data = urllib.parse.urlencode({'client_id': '${CLIENT_ID}', 'client_secret': '${CLIENT_SECRET}', 'grant_type': 'refresh_token', 'refresh_token': '${tokenObj.refresh_token}'}).encode()
req = urllib.request.Request('https://oauth2.googleapis.com/token', data=data, headers={'User-Agent': 'antigravity/ide/1.0.0 darwin/arm64'})
resp = urllib.request.urlopen(req, timeout=8)
print(resp.read().decode())
" 2>/dev/null`, { encoding: "utf8" });
        const refData = JSON.parse(ref);
        if (refData.access_token) {
          tokenObj.access_token = refData.access_token;
          const expSec = refData.expires_in || 3599;
          tokenObj.expiry = new Date(Date.now() + expSec * 1000).toISOString();
          parsed.token = tokenObj;
          fs.writeFileSync(selected.filePath, JSON.stringify(parsed, null, 2), "utf8");
          refreshed = true;
        }
      } catch {}
    }
  }

  // Tulis ke token destination
  const destDir = path.dirname(TOKEN_DEST);
  if (!fs.existsSync(destDir)) fs.mkdirSync(destDir, { recursive: true });
  fs.writeFileSync(TOKEN_DEST, JSON.stringify(parsed, null, 2), { mode: 0o600 });
  fs.chmodSync(TOKEN_DEST, 0o600);

  // Simpan active state
  fs.writeFileSync(ACTIVE_FILE, selected.name, "utf8");

  return {
    success: true,
    account: selected,
    refreshed: refreshed
  };
}

// --- SINKRONISASI DUA ARAH (BIDIRECTIONAL SYNC) ---
async function syncBidirectional() {
  const result = {
    total9Router: 0,
    totalLocal: 0,
    importedFrom9Router: [],
    pushedTo9Router: [],
    refreshed: []
  };

  if (!fs.existsSync(DB_PATH)) {
    throw new Error(`Database 9Router di ${DB_PATH} tidak ditemukan!`);
  }

  // 1. Ambil semua akun Antigravity dari database 9router
  const dbRows = queryDb("SELECT id, name, email, priority, isActive, data, updatedAt FROM providerConnections WHERE provider = 'antigravity' ORDER BY priority ASC");
  result.total9Router = dbRows.length;

  const dbMap = {};
  for (const r of dbRows) {
    const email = r.email || r.name;
    let d = {};
    try { d = JSON.parse(r.data); } catch {}
    dbMap[email] = { ...r, parsedData: d };
  }

  // 2. Ambil semua file lokal di ~/.agy-accounts
  const localFiles = fs.readdirSync(ACCOUNTS_DIR).filter(f => f.endsWith(".json"));
  result.totalLocal = localFiles.length;

  const localMap = {};
  for (const f of localFiles) {
    const accName = path.basename(f, ".json");
    const filePath = path.join(ACCOUNTS_DIR, f);
    try {
      const data = JSON.parse(fs.readFileSync(filePath, "utf8"));
      const email = data.id_token_email || getEmailFromJwt(data.id_token) || `${accName}@gmail.com`;
      localMap[email] = { name: accName, filePath, data };
      localMap[accName] = localMap[email];
    } catch {}
  }

  // --- TAHAP A: IMPORT DARI 9ROUTER KE LOCAL JIKA BELUM ADA ---
  for (const [email, r] of Object.entries(dbMap)) {
    const baseName = email.split("@")[0].replace(/[^a-zA-Z0-9_-]/g, "_");
    const targetFile = path.join(ACCOUNTS_DIR, `${baseName}.json`);

    const d = r.parsedData || {};
    const refreshToken = d.refreshToken;
    const accessToken = d.accessToken;
    const expiresAt = d.expiresAt || new Date(Date.now() + 3600 * 1000).toISOString();

    if (!fs.existsSync(targetFile)) {
      const newAcc = {
        token: {
          access_token: accessToken || "",
          token_type: "Bearer",
          refresh_token: refreshToken || "",
          expiry: expiresAt,
          expires_in: d.expiresIn || 3599
        },
        auth_method: "consumer",
        id_token_email: email
      };
      fs.writeFileSync(targetFile, JSON.stringify(newAcc, null, 2), { mode: 0o600 });
      result.importedFrom9Router.push(`${baseName} (${email})`);
    } else {
      try {
        const cur = JSON.parse(fs.readFileSync(targetFile, "utf8"));
        let updated = false;
        if (refreshToken && (!cur.token || !cur.token.refresh_token)) {
          cur.token = cur.token || {};
          cur.token.refresh_token = refreshToken;
          updated = true;
        }
        if (accessToken && (!cur.token || !cur.token.access_token)) {
          cur.token = cur.token || {};
          cur.token.access_token = accessToken;
          updated = true;
        }
        if (!cur.id_token_email) {
          cur.id_token_email = email;
          updated = true;
        }
        if (updated) {
          fs.writeFileSync(targetFile, JSON.stringify(cur, null, 2), { mode: 0o600 });
        }
      } catch {}
    }
  }

  // --- TAHAP B: PUSH DARI LOCAL KE 9ROUTER JIKA BELUM ADA / PERBARUI TOKEN ---
  let maxPriority = Math.max(...dbRows.map(r => r.priority || 0), 0);
  const updatedLocalFiles = fs.readdirSync(ACCOUNTS_DIR).filter(f => f.endsWith(".json"));

  for (const f of updatedLocalFiles) {
    const accName = path.basename(f, ".json");
    const filePath = path.join(ACCOUNTS_DIR, f);
    let accData = {};
    try {
      accData = JSON.parse(fs.readFileSync(filePath, "utf8"));
    } catch { continue; }

    const tokenObj = accData.token || {};
    const refreshToken = tokenObj.refresh_token;
    if (!refreshToken) continue;

    const email = accData.id_token_email || getEmailFromJwt(accData.id_token) || `${accName}@gmail.com`;
    let accessToken = tokenObj.access_token;
    let expiresAt = tokenObj.expiry;
    let expiresIn = tokenObj.expires_in || 3599;

    // Refresh token Google jika expired
    let isExpired = !expiresAt || (new Date(expiresAt).getTime() - Date.now() < 3 * 60 * 1000);

    if (isExpired && refreshToken) {
      try {
        const refRes = await refreshGoogleToken(refreshToken);
        accessToken = refRes.access_token;
        expiresIn = refRes.expires_in || 3599;
        expiresAt = new Date(Date.now() + expiresIn * 1000).toISOString();

        tokenObj.access_token = accessToken;
        tokenObj.expiry = expiresAt;
        tokenObj.expires_in = expiresIn;
        accData.token = tokenObj;
        fs.writeFileSync(filePath, JSON.stringify(accData, null, 2), { mode: 0o600 });
        result.refreshed.push(email);
      } catch (e) {}
    }

    const nowIso = new Date().toISOString();

    if (dbMap[email]) {
      const existing = dbMap[email];
      const connData = existing.parsedData || {};
      connData.accessToken = accessToken || connData.accessToken;
      connData.refreshToken = refreshToken;
      connData.expiresAt = expiresAt || connData.expiresAt;
      connData.expiresIn = expiresIn;
      connData.lastRefreshAt = nowIso;
      connData.scope = connData.scope || DEFAULT_SCOPE;
      connData.projectId = connData.projectId || "aicode-consumers";
      connData.testStatus = "active";

      executeDb(`
        UPDATE providerConnections
        SET authType = 'oauth', isActive = 1, data = ?, updatedAt = ?
        WHERE id = ?
      `, [JSON.stringify(connData), nowIso, existing.id]);
    } else {
      maxPriority++;
      const { randomUUID } = require("node:crypto");
      const newId = randomUUID();
      const connData = {
        accessToken: accessToken || "",
        refreshToken: refreshToken,
        expiresAt: expiresAt || nowIso,
        expiresIn: expiresIn,
        scope: DEFAULT_SCOPE,
        projectId: "aicode-consumers",
        testStatus: "active",
        lastRefreshAt: nowIso,
        errorCode: null,
        backoffLevel: 0
      };

      executeDb(`
        INSERT INTO providerConnections (id, provider, authType, name, email, priority, isActive, data, createdAt, updatedAt)
        VALUES (?, 'antigravity', 'oauth', ?, ?, ?, 1, ?, ?, ?)
      `, [newId, email, email, maxPriority, JSON.stringify(connData), nowIso, nowIso]);

      result.pushedTo9Router.push(`${accName} (${email})`);
    }
  }

  // Jika active file belum diset, set ke akun pertama
  if (!fs.existsSync(ACTIVE_FILE)) {
    const allNow = listAccounts();
    if (allNow.length > 0) {
      fs.writeFileSync(ACTIVE_FILE, allNow[0].name, "utf8");
    }
  }

  
  return result;
}

// --- USAGE & QUOTA ANALYTICS ---
function getUsageAnalytics() {
  const overall = queryDb(`
    SELECT COUNT(*) as totalRequests,
           COALESCE(SUM(promptTokens), 0) as totalPromptTokens,
           COALESCE(SUM(completionTokens), 0) as totalCompTokens,
           COALESCE(SUM(cost), 0) as totalCost
    FROM usageHistory
  `)[0] || { totalRequests: 0, totalPromptTokens: 0, totalCompTokens: 0, totalCost: 0 };

  const perAccount = queryDb(`
    SELECT pc.id, pc.name, pc.email, pc.priority, pc.isActive,
           COUNT(uh.id) as reqCount,
           COALESCE(SUM(uh.promptTokens), 0) as promptTokens,
           COALESCE(SUM(uh.completionTokens), 0) as compTokens,
           COALESCE(SUM(uh.cost), 0) as cost,
           MAX(uh.timestamp) as lastUsed
    FROM providerConnections pc
    LEFT JOIN usageHistory uh ON pc.id = uh.connectionId
    WHERE pc.provider = 'antigravity'
    GROUP BY pc.id
    ORDER BY pc.priority ASC
  `);

  const recentLogs = queryDb(`
    SELECT id, timestamp, model, connectionId, promptTokens, completionTokens, cost, status
    FROM usageHistory
    WHERE provider = 'antigravity'
    ORDER BY id DESC
    LIMIT 20
  `);

  return {
    overall: {
      totalRequests: Number(overall.totalRequests),
      totalPromptTokens: Number(overall.totalPromptTokens),
      totalCompTokens: Number(overall.totalCompTokens),
      totalCost: Number(overall.totalCost)
    },
    perAccount: perAccount.map(a => ({
      id: a.id,
      name: a.name || a.email.split("@")[0],
      email: a.email,
      priority: a.priority,
      isActive: Boolean(a.isActive),
      reqCount: Number(a.reqCount),
      promptTokens: Number(a.promptTokens),
      completionTokens: Number(a.compTokens),
      cost: Number(a.cost),
      lastUsed: a.lastUsed
    })),
    recentLogs
  };
}

// --- TAMBAH AKUN BARU ---
async function addNewAccount(name, rawInput) {
  if (!name || typeof name !== "string") {
    throw new Error("Nama akun wajib diisi!");
  }
  const cleanName = name.trim().toLowerCase().replace(/[^a-z0-9_-]/g, "_");
  const targetPath = path.join(ACCOUNTS_DIR, `${cleanName}.json`);

  let parsed = null;
  try {
    parsed = JSON.parse(rawInput);
  } catch {}

  let refreshToken = "";
  let accessToken = "";
  let email = `${cleanName}@gmail.com`;

  if (parsed && typeof parsed === "object") {
    if (parsed.token) {
      refreshToken = parsed.token.refresh_token || "";
      accessToken = parsed.token.access_token || "";
    } else if (parsed.refreshToken) {
      refreshToken = parsed.refreshToken;
      accessToken = parsed.accessToken || "";
    } else if (parsed.refresh_token) {
      refreshToken = parsed.refresh_token;
      accessToken = parsed.access_token || "";
    }
    if (parsed.id_token_email) {
      email = parsed.id_token_email;
    } else if (parsed.id_token) {
      email = getEmailFromJwt(parsed.id_token) || email;
    } else if (parsed.email) {
      email = parsed.email;
    }
  } else {
    refreshToken = String(rawInput).trim();
  }

  if (!refreshToken) {
    throw new Error("Refresh token Google tidak ditemukan pada input!");
  }

  let expiresIn = 3599;
  let expiresAt = new Date(Date.now() + expiresIn * 1000).toISOString();
  try {
    const ref = await refreshGoogleToken(refreshToken);
    accessToken = ref.access_token;
    expiresIn = ref.expires_in || 3599;
    expiresAt = new Date(Date.now() + expiresIn * 1000).toISOString();
  } catch (e) {
    throw new Error("Gagal memvalidasi refresh token ke Google: " + e.message);
  }

  const accountPayload = {
    token: {
      access_token: accessToken,
      token_type: "Bearer",
      refresh_token: refreshToken,
      expiry: expiresAt,
      expires_in: expiresIn
    },
    auth_method: "consumer",
    id_token_email: email
  };

  fs.writeFileSync(targetPath, JSON.stringify(accountPayload, null, 2), { mode: 0o600 });
  await syncBidirectional();

  return {
    success: true,
    name: cleanName,
    email: email
  };
}


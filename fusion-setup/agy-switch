</body>
</html>`;
}

// --- HTTP SERVER ---
function startServer() {
  const server = http.createServer(async (req, res) => {
    const parsedUrl = new URL(req.url, `http://localhost:${PORT}`);
    const pathname = parsedUrl.pathname;

    res.setHeader("Access-Control-Allow-Origin", "*");
    res.setHeader("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
    res.setHeader("Access-Control-Allow-Headers", "Content-Type");

    if (req.method === "OPTIONS") {
      res.writeHead(204);
      return res.end();
    }

    const sendJson = (status, payload) => {
      res.writeHead(status, { "Content-Type": "application/json" });
      res.end(JSON.stringify(payload));
    };

    const readBody = () => new Promise((resolve) => {
      let b = "";
      req.on("data", chunk => b += chunk);
      req.on("end", () => {
        try { resolve(JSON.parse(b)); } catch { resolve({}); }
      });
    });

    try {
      if (pathname === "/" || pathname === "/index.html") {
        res.writeHead(200, { "Content-Type": "text/html; charset=utf-8" });
        return res.end(renderDashboardHtml());
      }

      if (pathname === "/api/accounts" && req.method === "GET") {
        const accs = listAccounts();
        const active = getActiveAccountName();
        return sendJson(200, { accounts: accs, activeAccount: active });
      }

      if (pathname === "/api/switch" && req.method === "POST") {
        const body = await readBody();
        const sw = switchToAccount(body.target);
        return sendJson(200, sw);
      }

      if (pathname === "/api/sync" && req.method === "POST") {
        const syncRes = await syncBidirectional();
        return sendJson(200, { success: true, ...syncRes });
      }

      if (pathname === "/api/usage" && req.method === "GET") {
        const usage = getUsageAnalytics();
        return sendJson(200, usage);
      }

      if (pathname === "/api/quota" && req.method === "GET") {
        const accs = listAccounts();
        const active = accs.find(a => a.isActive);
        let tierInfo = null;
        if (active) {
          try {
            const curFile = JSON.parse(fs.readFileSync(active.filePath, "utf8"));
            if (curFile.token && curFile.token.access_token) {
              tierInfo = await checkCloudCodeTier(curFile.token.access_token);
            }
          } catch {}
        }
        return sendJson(200, { success: true, activeAccount: active, tierInfo });
      }

      if (pathname === "/api/add" && req.method === "POST") {
        const body = await readBody();
        const addRes = await addNewAccount(body.name, body.tokenData);
        return sendJson(200, addRes);
      }

      sendJson(404, { error: "Not found" });
    } catch (e) {
      sendJson(500, { error: e.message });
    }
  });

  server.listen(PORT, "127.0.0.1", () => {
    fs.writeFileSync(PID_FILE, String(process.pid), "utf8");
    console.log(`[✓] AGY-Switch Server aktif di http://127.0.0.1:${PORT} (PID: ${process.pid})`);
  });

  server.on("error", (e) => {
    if (e.code === "EADDRINUSE") {
      console.log(`[!] Port ${PORT} sudah digunakan.`);
      process.exit(0);
    } else {
      console.error("Server error:", e.message);
      process.exit(1);
    }
  });
}

function isPortRunning(port) {
  return new Promise((resolve) => {
    const s = net.connect({ port, host: "127.0.0.1" }, () => {
      s.destroy();
      resolve(true);
    });
    s.on("error", () => {
      s.destroy();
      resolve(false);
    });
  });
}

function waitPort(port, timeout = 5000) {
  const start = Date.now();
  return new Promise((resolve, reject) => {
    const check = () => {
      const s = net.connect({ port, host: "127.0.0.1" }, () => {
        s.destroy();
        resolve(true);
      });
      s.on("error", () => {
        s.destroy();
        if (Date.now() - start > timeout) return reject(new Error("Timeout"));
        setTimeout(check, 100);
      });
    };
    check();
  });
}

function launchWebView(isAgent = false) {
  const url = `http://127.0.0.1:${PORT}`;

  if (isAgent) {
    console.log(`\n🌐 [Agent Mode] Membuka AGY-Switch WebUI di tab baru: ${url}...`);
    try {
      execSync(`termux-ipc tab new "AGY-Switch" "termux-ipc webview ${url}" 2>/dev/null`, { stdio: "ignore" });
      console.log("[✓] Tab baru 'AGY-Switch' berhasil dibuka bersama Termux WebView!");
      return;
    } catch {}
  }

  // Eksekusi Manual oleh Tuan Eso: langsung buka webview di tab aktif tanpa membuat tab baru
  console.log(`\n🌐 Membuka AGY-Switch WebUI: ${url}...`);
  try {
    execSync(`termux-ipc webview "${url}" 2>/dev/null`, { stdio: "ignore" });
    console.log("[✓] WebView diluncurkan di tab saat ini.");
  } catch (e) {
    console.log(`[+] Silakan buka di browser Anda: ${url}`);
  }
}

async function ensureDaemonRunning() {
  const running = await isPortRunning(PORT);
  if (!running) {
    const out = fs.openSync(LOG_FILE, "a");
    const err = fs.openSync(LOG_FILE, "a");
    const child = spawn(process.execPath, [__filename, "server", "start"], {
      detached: true,
      stdio: ["ignore", out, err]
    });
    child.unref();
    try {
      await waitPort(PORT, 5000);
    } catch {}
  }
}

// --- CLI DISPATCHER ---
async function main() {
  const args = process.argv.slice(2);
  const cmd = args[0] ? args[0].toLowerCase() : "";

  // 1. Sinkronisasi CLI
  if (cmd === "sync" || cmd === "sync-9router") {
    console.log("⚡ [AGY-GANTI] Memulai sinkronisasi dua arah dengan 9Router...");
    try {
      const res = await syncBidirectional();
      console.log(`\n================ SINKRONISASI SELESAI ================`);
      console.log(`Akun di 9Router Database : ${res.total9Router} Akun`);
      console.log(`Akun di ~/.agy-accounts  : ${res.totalLocal} Akun`);
      if (res.importedFrom9Router.length > 0) {
        console.log(`Diimpor dari 9Router     : ${res.importedFrom9Router.join(", ")}`);
      }
      if (res.pushedTo9Router.length > 0) {
        console.log(`Ditambahkan ke 9Router   : ${res.pushedTo9Router.join(", ")}`);
      }
      if (res.refreshed.length > 0) {
        console.log(`Token Google Di-refresh  : ${res.refreshed.join(", ")}`);
      }
      console.log(`======================================================\n`);
      console.log("✅ Seluruh akun telah sinkron 100%!");
    } catch (e) {
      console.error("❌ Gagal sinkronisasi:", e.message);
      process.exit(1);
    }
    return;
  }

  // 2. Daftar Akun (List)
  if (cmd === "list" || cmd === "ls") {
    const accs = listAccounts();
    console.log("\n========================================================");
    console.log("             DAFTAR AKUN ANTIGRAVITY (AGY)              ");
    console.log("========================================================");
    accs.forEach(a => {
      const badge = a.isActive ? "👉 [AKTIF]" : "  [STANDBY]";
      let expStatus = "✓ OK";
      if (a.isRevoked) {
        expStatus = "❌ REVOKED";
      } else if (a.isExpired) {
        expStatus = "⚠️ EXPIRED";
      }
      console.log(
        `${String(a.index).padStart(2, " ")}. ` +
        `${a.name.padEnd(16, " ")} ` +
        `${badge} ` +
        `Prio:${a.priority} ` +
        `(${a.email}) ` +
        `[${expStatus}]`
      );
    });
    console.log("========================================================");
    console.log("💡 Ganti akun cepat : switch <nomor|nama>");
    console.log("   Contoh           : switch 1   atau   switch devikarina69");
    console.log("   Buka WebUI       : switch ui");
    console.log("   Sinkronisasi     : switch sync\n");
    return;
  }

  

  // 3. Simpan Akun Saat Ini
  if (cmd === "simpan" || cmd === "save") {
    const targetName = args[1];
    if (!targetName) {
      console.error("❌ Harap masukkan nama akun! Contoh: agy-switch simpan akun-baru");
      process.exit(1);
    }
    if (!fs.existsSync(TOKEN_DEST)) {
      console.error(`❌ Token Antigravity belum ada di ${TOKEN_DEST}`);
      process.exit(1);
    }
    const dest = path.join(ACCOUNTS_DIR, `${targetName}.json`);
    fs.copyFileSync(TOKEN_DEST, dest);
    fs.chmodSync(dest, 0o600);
    fs.writeFileSync(ACTIVE_FILE, targetName, "utf8");
    console.log(`✅ Akun saat ini berhasil disimpan sebagai '${targetName}'!`);
    console.log("[*] Menyinkronkan ke 9Router...");
    await syncBidirectional();
    return;
  }

  // 4. Server Management
  if (cmd === "server") {
    const sub = args[1] || "status";
    if (sub === "start") {
      startServer();
    } else if (sub === "stop") {
      if (fs.existsSync(PID_FILE)) {
        try {
          const p = parseInt(fs.readFileSync(PID_FILE, "utf8").trim(), 10);
          process.kill(p, "SIGTERM");
          console.log(`[✓] Server PID ${p} dihentikan.`);
        } catch {}
        try { fs.unlinkSync(PID_FILE); } catch {}
      }
      try { execSync(`fuser -k ${PORT}/tcp 2>/dev/null || true`); } catch {}
    } else if (sub === "restart") {
      try { execSync(`agy-switch server stop`, { stdio: "ignore" }); } catch {}
      await ensureDaemonRunning();
      console.log("[✓] Server berhasil di-restart.");
    } else {
      const running = await isPortRunning(PORT);
      console.log(`AGY-Switch Server (Port ${PORT}): ${running ? "🟢 AKTIF" : "⚪ MATI"}`);
    }
    return;
  }

  // 5. Usage Stats CLI
  if (cmd === "usage") {
    const u = getUsageAnalytics();
    console.log("\n=================== USAGE TRACKER ===================");
    console.log(`Total Requests          : ${u.overall.totalRequests.toLocaleString()}`);
    console.log(`Total Prompt Tokens     : ${(u.overall.totalPromptTokens / 1000000).toFixed(2)}M`);
    console.log(`Total Completion Tokens : ${(u.overall.totalCompTokens / 1000).toFixed(1)}K`);
    console.log(`Total Estimasi Biaya    : $${u.overall.totalCost.toFixed(4)}`);
    console.log("-----------------------------------------------------");
    u.perAccount.forEach(a => {
      console.log(` • [Prio ${a.priority}] ${a.name.padEnd(15)} : ${a.reqCount} req | $${a.cost.toFixed(4)} (${a.email})`);
    });
    console.log("=====================================================\n");
    return;
  }

  // 6. Quota CLI
  if (cmd === "quota") {
    console.log("[*] Memeriksa status tier & quota Google Cloud Code...");
    const accs = listAccounts();
    const active = accs.find(a => a.isActive);
    if (!active) {
      console.log("Tidak ada akun aktif.");
      return;
    }
    try {
      const curFile = JSON.parse(fs.readFileSync(active.filePath, "utf8"));
      const tier = await checkCloudCodeTier(curFile.token.access_token);
      console.log(`Akun Aktif : ${active.name} (${active.email})`);
      if (tier && tier.currentTier) {
        console.log(`Tier       : ${tier.currentTier.name} (${tier.currentTier.id})`);
        console.log(`Project    : ${tier.cloudaicompanionProject}`);
      } else {
        console.log("Gagal mengambil tier langsung dari Google API.");
      }
    } catch (e) {
      console.log("Error:", e.message);
    }
    return;
  }

  // 7. Ganti Akun Cepat jika ada argumen angka atau nama
  if (cmd && cmd !== "ui" && cmd !== "web") {
    try {
      const sw = switchToAccount(cmd);
      console.log(`\n✅ Berhasil beralih ke akun #${sw.account.index}: ${sw.account.name} (${sw.account.email})`);
      if (sw.refreshed) {
        console.log("⚡ Token Google berhasil diperbarui secara otomatis!");
      }
      console.log("💡 Sesi baru telah diterapkan langsung ke Antigravity CLI!\n");
    } catch (e) {
      console.error(`❌ ${e.message}\n`);
      const accs = listAccounts();
      console.log("Daftar akun yang tersedia:");
      accs.forEach(a => console.log(`  ${a.index}. ${a.name} (${a.email})`));
      console.log("\nGunakan: switch <nomor|nama>");
      process.exit(1);
    }
    return;
  }

  // 8. Jika dipanggil tanpa argumen atau 'ui' / 'web':
  try { await syncBidirectional(); } catch {}
  await ensureDaemonRunning();

  const isAgent = args.includes("--agent") ||
                  args.includes("--new-tab") ||
                  args.includes("tab") ||
                  Boolean(process.env.AGENT_MODE) ||
                  Boolean(process.env.AI_AGENT) ||
                  (!process.stdin.isTTY && !args.includes("--manual"));

  launchWebView(isAgent);

  const accs = listAccounts();
  console.log("\n========================================================");
  console.log("              AGY GANTI - QUICK SWITCHER                ");
  console.log("========================================================");
  accs.forEach(a => {
    const badge = a.isActive ? "👉 [AKTIF]" : "         ";
    console.log(`  ${String(a.index).padStart(2, " ")}. ${a.name.padEnd(16, " ")} ${badge} (${a.email})`);
  });
  console.log("========================================================");
  console.log(`🌐 WebUI Server : http://127.0.0.1:${PORT}`);
  console.log("💡 Ganti Cepat   : switch <nomor|nama>  (contoh: switch 1)");
  console.log("   Sinkronisasi  : switch sync");
  console.log("   Daftar Akun   : agy-switch list\n");
}

main().catch(err => {
  console.error("Fatal Error:", err);
  process.exit(1);
});

{
  "manifest_version": 2,
  "name": "Fusion Gecko Bridge",
  "version": "1.1.0",
  "description": "Fusion IPC JS injection, native bridge & proxy controller for hybrid GeckoView tabs",
  "browser_specific_settings": {
    "gecko": {
      "id": "fusion@termux.com",
      "strict_min_version": "113.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "proxy",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ]
}

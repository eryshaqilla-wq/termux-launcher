function decodeRecipePayloadCli(rawInput) {
    if (!rawInput) return null;
    let code = rawInput.trim();

    // 1. Cek jika berupa URL dengan hash #agy_code= atau #agy_recipe= atau ?agy_code=
    const urlMatch = code.match(/[#\?&]agy_(?:code|recipe)=([^&\s]+)/i);
    if (urlMatch && urlMatch[1]) {
        code = urlMatch[1];
    } else if (code.startsWith('AGY-RECIPE:')) {
        // AGY-RECIPE:v1:<base64> atau AGY-RECIPE:<base64>
        const parts = code.split(':');
        code = parts[parts.length - 1].trim();
    }

    // 2. Decode base64 URL-safe / standard
    try {
        const decodedStr = Buffer.from(decodeURIComponent(code), 'base64').toString('utf8');
        const parsed = JSON.parse(decodedStr);
        if (parsed && (parsed.name || parsed.events)) {
            return parsed;
        }
    } catch (_) {}

    // Coba langsung JSON decode jika raw JSON di-paste
    try {
        const parsed = JSON.parse(rawInput);
        if (parsed && (parsed.name || parsed.events)) {
            return parsed;
        }
    } catch (_) {}

    return null;
}

function getSitePrefix(rawUrl) {
    if (!rawUrl) return '';
    try {
        const u = rawUrl.startsWith('http://') || rawUrl.startsWith('https://') ? rawUrl : `https://${rawUrl}`;
        let host = new URL(u).hostname.replace(/^www\./i, '').toLowerCase();
        let parts = host.split('.');
        if (parts.length >= 3 && ['app', 'dapp', 'm', 'mobile', 'claim', 'web'].includes(parts[0])) {
            parts.shift();
            host = parts.join('.');
        }
        if (parts.length >= 2) {
            if (parts.length === 2 && !['com', 'net', 'org', 'io', 'xyz', 'app', 'me', 'co'].includes(parts[1])) {
                return host.replace(/[^a-zA-Z0-9_-]/g, '_');
            }
            return parts[0].replace(/[^a-zA-Z0-9_-]/g, '_');
        }
        return host.replace(/[^a-zA-Z0-9_-]/g, '_');
    } catch (_) {
        return '';
    }
}

function saveRecipeToDisk(recipe) {
    const candidates = [
        '/proc/1/root/data/data/com.termux/files/home/wallet/recipes_db.json',
        '/root/wallet/recipes_db.json',
        '/data/data/com.termux/files/home/wallet/recipes_db.json'
    ];
    let targetFile = candidates[0];
    for (const f of candidates) {
        if (fs.existsSync(path.dirname(f))) {
            targetFile = f;
            break;
        }
    }

    let db = {};
    if (fs.existsSync(targetFile)) {
        try {
            db = JSON.parse(fs.readFileSync(targetFile, 'utf8')) || {};
        } catch (_) { db = {}; }
    }

    const targetUrl = recipe.targetUrl || recipe.url || '';
    const sitePrefix = getSitePrefix(targetUrl);
    let rName = (recipe.name || `makro_${Date.now()}`).trim().replace(/[^a-zA-Z0-9_-]/g, '_');

    if (sitePrefix && !rName.toLowerCase().startsWith(sitePrefix.toLowerCase())) {
        rName = `${sitePrefix}_${rName.replace(/^(resep_|makro_)/i, '')}`;
    }

    db[rName] = {
        name: rName,
        site: sitePrefix || 'web',
        createdAt: Date.now(),
        targetUrl: targetUrl,
        events: Array.isArray(recipe.events) ? recipe.events : []
    };

    try {
        fs.mkdirSync(path.dirname(targetFile), { recursive: true });
        fs.writeFileSync(targetFile, JSON.stringify(db, null, 2), 'utf8');
        return { ok: true, file: targetFile, name: rName, count: db[rName].events.length, url: db[rName].targetUrl };
    } catch (e) {
        return { ok: false, error: e.message };
    }
}

function loadRecipe(recipeQuery) {
    if (!recipeQuery) return null;
    const query = String(recipeQuery).trim();

    // 1. Cek jika query berupa file path langsung (.makro / .json)
    if (fs.existsSync(query)) {
        try {
            const content = fs.readFileSync(query, 'utf8');
            const parsed = JSON.parse(content);
            if (parsed && (parsed.events || Array.isArray(parsed))) {
                const events = Array.isArray(parsed) ? parsed : parsed.events;
                const name = parsed.name || path.basename(query, path.extname(query));
                return { name, events, targetUrl: parsed.targetUrl || parsed.url || '' };
            }
        } catch (_) {}
    }

    // 2. Baca dari recipes_db.json
    const candidates = [
        '/proc/1/root/data/data/com.termux/files/home/wallet/recipes_db.json',
        '/root/wallet/recipes_db.json',
        '/data/data/com.termux/files/home/wallet/recipes_db.json'
    ];
    let db = {};
    for (const f of candidates) {
        if (fs.existsSync(f)) {
            try {
                db = JSON.parse(fs.readFileSync(f, 'utf8')) || {};
                break;
            } catch (_) {}
        }
    }

    // A. Direct key match
    if (db[query]) {
        return db[query];
    }

    // B. Normalized query (contoh: "web3.claim.makro" -> "web3_claim")
    const cleanQuery = query.replace(/\.(makro|json)$/i, '').replace(/[^a-zA-Z0-9_-]/g, '_').toLowerCase();
    if (db[cleanQuery]) {
        return db[cleanQuery];
    }

    // C. Prefix / Suffix / Substring match
    for (const [key, val] of Object.entries(db)) {
        const kLower = key.toLowerCase();
        if (kLower === cleanQuery || kLower.endsWith(`_${cleanQuery}`) || kLower.includes(cleanQuery)) {
            return val;
        }
    }

    return null;
}

function isPortOpen(port, host = '127.0.0.1') {
    return new Promise((resolve) => {
        const socket = new net.Socket();
        socket.setTimeout(400);
        socket.once('connect', () => {
            socket.destroy();
            resolve(true);
        });
        socket.once('timeout', () => {
            socket.destroy();
            resolve(false);
        });
        socket.once('error', () => {
            socket.destroy();
            resolve(false);
        });
        socket.connect(port, host);
    });
}

function runIpcTab(action, args = []) {
    const ipcBin = fs.existsSync('/usr/local/bin/termux-ipc') 
        ? '/usr/local/bin/termux-ipc' 
        : (fs.existsSync('/usr/local/termux-shims/termux-ipc') ? '/usr/local/termux-shims/termux-ipc' : 'termux-ipc');
    try {
        const cmdStr = `${ipcBin} tab ${action} ${args.map(a => `"${String(a).replace(/"/g, '\\"')}"`).join(' ')}`;
        return execSync(cmdStr, { encoding: 'utf8' }).trim();
    } catch (e) {
        return e.stdout ? e.stdout.trim() : `Error: ${e.message}`;
    }
}

async function ensureGhostWalletRunning(preferTab = true) {
    const running = await isPortOpen(3333);
    if (running) {
        console.log(`[GhostWallet] Daemon sudah aktif di port 3333.`);
        return { running: true, spawnedTab: null };
    }

    const tabName = `ghostwallet_${Date.now().toString().slice(-4)}`;
    console.log(`[GhostWallet] Daemon belum aktif. Membuka tab baru "${tabName}" via IPC...`);

    const walletCmd = 'if command -v wallet >/dev/null 2>&1; then wallet --auto --ghostwallet 3333; else for d in "$FUSION_WALLET_DIR" "$HOME/wallet" /wallet /root/wallet; do if [ -n "$d" ] && [ -d "$d" ]; then cd "$d" && { if [ -f wallet.cjs ]; then node wallet.cjs --auto --ghostwallet 3333; elif [ -f wallet.js ]; then node wallet.js --auto --ghostwallet 3333; fi; } && break; fi; done; fi';

    if (preferTab) {
        runIpcTab('new', [tabName, walletCmd]);
    } else {
        spawn('bash', ['-c', walletCmd], { detached: true, stdio: 'ignore' }).unref();
    }

    for (let i = 0; i < 20; i++) {
        await sleep(250);
        if (await isPortOpen(3333)) {
            console.log(`[GhostWallet] Daemon sukses aktif di port 3333 (Tab: ${tabName}).`);
            return { running: true, spawnedTab: preferTab ? tabName : null };
        }
    }

    console.error(`[GhostWallet] Timeout menunggu port 3333.`);
    return { running: false, spawnedTab: null };
}


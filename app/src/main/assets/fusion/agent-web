async function ensurePortForward() {
    try {
        const unixOut = execSync("adb -s 127.0.0.1:5555 shell 'cat /proc/net/unix | grep devtools' 2>/dev/null", { timeout: 1500 }).toString();
        const match = unixOut.match(/@(webview_devtools_remote_\d+)/);
        if (match) {
            execSync(`adb -s 127.0.0.1:5555 forward tcp:9222 localabstract:${match[1]}`, { timeout: 1500 });
            return true;
        }
    } catch (_) {}
    return false;
}

async function clearCdpCookies() {
    try {
        const forwarded = await ensurePortForward();
        if (!forwarded) return false;
        const { chromium } = require('playwright-core');
        const browser = await chromium.connectOverCDP('http://127.0.0.1:9222', { timeout: 1500 });
        const contexts = browser.contexts();
        if (contexts.length > 0) {
            await contexts[0].clearCookies();
        }
        await browser.close();
        return true;
    } catch(e) {
        return false;
    }
}

async function saveSessionCookies(profile, silent = false) {
    if (!profile || profile === 'default' || profile.startsWith('fresh_')) return false;

    // SYSTEM LOCK 1: Active Profile System Lock
    // Jika sistem sedang terkunci pada profil aktif tertentu dan profil target berbeda, tolak keras!
    const activeProfile = process.env.FUSION_ACTIVE_PROFILE || (process.env.IN_WORKER_TAB ? null : getActiveProfile());
    if (activeProfile && activeProfile !== 'default' && activeProfile !== profile) {
        console.error(`${RED}[SYSTEM LOCK ERROR] Pelanggaran Isolasi Profil! Sesi sistem saat ini terkunci pada [${activeProfile}]. Mustahil dan ditolak menyimpan ke profil berbeda [${profile}]!${RESET}`);
        return false;
    }

    try {
        const forwarded = await ensurePortForward();
        if (!forwarded) return false;
        const { chromium } = require('playwright-core');
        const browser = await chromium.connectOverCDP('http://127.0.0.1:9222', { timeout: 1500 });
        const contexts = browser.contexts();
        if (contexts.length > 0) {
            const pages = contexts[0].pages();

            // SYSTEM LOCK 2: Tab Browser Profile Stamp Verification (Mendukung Multi-Tab Paralel)
            let hasMatchingTab = false;
            let otherTabsCount = 0;
            for (const p of pages) {
                try {
                    const prof = await p.evaluate(() => window.__FUSION_PROFILE__ || null);
                    if (prof === profile) {
                        hasMatchingTab = true;
                        break;
                    } else if (prof && prof !== 'default') {
                        otherTabsCount++;
                    }
                } catch (_) {}
            }

            // Jika hanya ada tab milik profil lain dan tab profil target tidak ditemukan: tolak!
            if (!hasMatchingTab && otherTabsCount > 0 && pages.length > 0) {
                console.error(`${RED}[SYSTEM LOCK ERROR] Tidak ditemukan tab aktif milik profil [${profile}] di browser. Operasi simpan digagalkan demi keamanan.${RESET}`);
                await browser.close();
                return false;
            }

            const state = await contexts[0].storageState();
            if (state && state.cookies && state.cookies.length > 0) {
                // SYSTEM LOCK 3: Dynamic Multi-Profile Account Identity Lock (Universal untuk SEMUA profil)
                const twidCookie = state.cookies.find(c => c.name === 'twid');
                if (twidCookie) {
                    const match = twidCookie.value.match(/u%3D(\d+)/) || twidCookie.value.match(/(\d+)/);
                    if (match && match[1]) {
                        const foundUid = match[1];
                        const knownIdentities = getKnownProfileIdentities();
                        if (knownIdentities.has(foundUid)) {
                            const boundProfile = knownIdentities.get(foundUid);
                            if (boundProfile !== profile) {
                                console.error(`${RED}[SYSTEM LOCK CRITICAL] TERKUNCI: Cookie sesi browser ini terdeteksi milik akun X (UID: ${foundUid}) yang sudah terikat permanen pada profil [${boundProfile}]. MUSTAHIL dan DILARANG KERAS menyimpan ke profil berbeda [${profile}]! Operasi dibatalkan demi keamanan isolasi.${RESET}`);
                                await browser.close();
                                return false;
                            }
                        }
                    }
                }

                // Deduplikasi cookies berdasarkan name + clean domain
                const dedupedMap = new Map();
                for (const c of state.cookies) {
                    if (!c.name) continue;
                    const domain = c.domain || '';
                    const cleanDomain = domain.startsWith('.') ? domain.slice(1) : domain;
                    const key = `${c.name}@${cleanDomain}`;
                    const existing = dedupedMap.get(key);
                    const curExp = typeof c.expires === 'number' ? c.expires : -1;
                    const prevExp = existing && typeof existing.expires === 'number' ? existing.expires : -1;
                    if (!existing || curExp > prevExp) {
                        dedupedMap.set(key, c);
                    }
                }
                state.cookies = Array.from(dedupedMap.values());
                const jsonStr = JSON.stringify(state, null, 2);
                const dirs = getAllSessionDirs();
                for (const d of dirs) {
                    try {
                        const targetFile = path.join(d, `${profile}.json`);
                        fs.writeFileSync(targetFile, jsonStr, 'utf8');
                        try { fs.chmodSync(targetFile, 0o666); } catch (_) {}
                    } catch (_) {}
                }
                registerProfile(profile);
                if (!silent) console.log(`Sesi web untuk profil [${profile}] berhasil disimpan (${state.cookies.length} cookies).`);
                await browser.close();
                return true;
            }
        }
        await browser.close();
        return false;
    } catch (e) {
        return false;
    }
}

async function injectSessionCookies(profile, silent = false) {
    if (!profile || profile === 'default' || profile.startsWith('fresh_')) return false;
    const dirs = getAllSessionDirs();
    let sessionFile = null;
    for (const d of dirs) {
        const candidate = path.join(d, `${profile}.json`);
        if (fs.existsSync(candidate) && fs.statSync(candidate).size > 0) {
            sessionFile = candidate;
            break;
        }
    }
    if (!sessionFile) return false;

    try {
        const raw = JSON.parse(fs.readFileSync(sessionFile, 'utf8'));
        if (!raw.cookies || raw.cookies.length === 0) return false;

        // SYSTEM LOCK: Validasi berkas sesi profil ini terhadap registri identitas profil lain secara dinamis
        const twidCookie = raw.cookies.find(c => c.name === 'twid');
        if (twidCookie) {
            const match = twidCookie.value.match(/u%3D(\d+)/) || twidCookie.value.match(/(\d+)/);
            if (match && match[1]) {
                const foundUid = match[1];
                const knownIdentities = getKnownProfileIdentities();
                if (knownIdentities.has(foundUid)) {
                    const boundProfile = knownIdentities.get(foundUid);
                    if (boundProfile !== profile) {
                        console.error(`${RED}[SYSTEM LOCK ERROR] Berkas sesi [${profile}.json] terdeteksi terkontaminasi akun milik profil [${boundProfile}] (UID: ${foundUid}). Injeksi dibatalkan demi keamanan!${RESET}`);
                        return false;
                    }
                }
            }
        }

        // Deduplikasi cookies sebelum inject
        const dedupedMap = new Map();
        for (const c of raw.cookies) {
            if (!c.name) continue;
            const domain = c.domain || '';
            const cleanDomain = domain.startsWith('.') ? domain.slice(1) : domain;
            const key = `${c.name}@${cleanDomain}`;
            const existing = dedupedMap.get(key);
            const curExp = typeof c.expires === 'number' ? c.expires : -1;
            const prevExp = existing && typeof existing.expires === 'number' ? existing.expires : -1;
            if (!existing || curExp > prevExp) {
                dedupedMap.set(key, c);
            }
        }
        const cookiesToInject = Array.from(dedupedMap.values());

        // Pastikan berkas sesi juga tersalin ke seluruh kandidat direktori sesi (termasuk folder home Termux)
        for (const d of dirs) {
            const target = path.join(d, `${profile}.json`);
            if (target !== sessionFile && (!fs.existsSync(target) || fs.statSync(target).size === 0)) {
                try {
                    fs.writeFileSync(target, JSON.stringify({ ...raw, cookies: cookiesToInject }, null, 2), 'utf8');
                    fs.chmodSync(target, 0o666);
                } catch (_) {}
            }
        }

        const forwarded = await ensurePortForward();
        if (!forwarded) return false;
        const { chromium } = require('playwright-core');
        const browser = await chromium.connectOverCDP('http://127.0.0.1:9222', { timeout: 1500 });
        const contexts = browser.contexts();
        if (contexts.length > 0) {
            await contexts[0].clearCookies();
            await contexts[0].addCookies(cookiesToInject);
            if (!silent) console.log(`Sesi profil [${profile}] dipulihkan (${cookiesToInject.length} cookies).`);
        }
        await browser.close();
        return true;
    } catch (e) {
        return false;
    }
}

async function handleXPost(text, profile) {
    const targetProfile = profile || 'shaqilla';
    console.log(`Mengirim tweet via profil: ${targetProfile}...`);
    
    // Pastikan cookies profil diinjeksi jika ada
    await injectSessionCookies(targetProfile, true);

    // 1. Buka komposer tweet X dengan profil yang diminta
    runIpc(`--profile ${targetProfile} https://x.com/compose/post`);
    await sleep(3500);

    // 2. Skrip injeksi teks ke contenteditable Twitter / X
    const postScript = `
    (async function() {
        try {
            var editor = document.querySelector('[data-testid="tweetTextarea_0"]') || 
                         document.querySelector('div[contenteditable="true"]');
            if (!editor) return JSON.stringify({ error: "Editor tweet tidak ditemukan di halaman" });
            
            editor.focus();
            document.execCommand('selectAll', false, null);
            document.execCommand('delete', false, null);
            document.execCommand('insertText', false, "${text.replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/\n/g, '\\n')}");
            
            // Trigger input events
            editor.dispatchEvent(new Event('input', { bubbles: true }));
            editor.dispatchEvent(new Event('change', { bubbles: true }));
            
            await new Promise(r => setTimeout(r, 1000));
            
            var btn = document.querySelector('[data-testid="tweetButton"]') || 
                      document.querySelector('[data-testid="tweetButtonInline"]') ||
                      Array.from(document.querySelectorAll('button')).find(b => b.innerText && (b.innerText.includes('Post') || b.innerText.includes('Tweet')));
            
            if (!btn) return JSON.stringify({ error: "Tombol Post tidak ditemukan" });
            if (btn.disabled || btn.getAttribute('aria-disabled') === 'true') {
                return JSON.stringify({ error: "Tombol Post disabled" });
            }
            
            btn.click();
            return JSON.stringify({ success: true, text: "${text.substring(0, 30)}..." });
        } catch(e) {
            return JSON.stringify({ error: e.message });
        }
    })();
    `;

    const res = evalJs(postScript);
    console.log(`Tweet terkirim.`);
    return { success: true, profile: targetProfile, text };
}


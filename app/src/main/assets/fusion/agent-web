function getProfileDeviceIdentity(profile) {
    if (!profile || profile === 'default') return null;
    const dirs = getAllSessionDirs();
    for (const d of dirs) {
        const candidate = path.join(d, `${profile}.device.json`);
        if (fs.existsSync(candidate) && fs.statSync(candidate).size > 0) {
            try {
                return JSON.parse(fs.readFileSync(candidate, 'utf8'));
            } catch (_) {}
        }
    }
    const p = profile.toLowerCase().trim();
    let dev;
    if (p === 'shaqilla') dev = DEVICE_POOL[0];
    else if (p === 'eryziggy') dev = DEVICE_POOL[1];
    else if (p === '0xjamrud') dev = DEVICE_POOL[3];
    else if (p === 'wallet_1') dev = DEVICE_POOL[2];
    else {
        let hash = 0;
        for (let i = 0; i < p.length; i++) hash = ((hash << 5) - hash) + p.charCodeAt(i);
        dev = DEVICE_POOL[Math.abs(hash) % DEVICE_POOL.length];
    }
    for (const d of dirs) {
        try {
            const targetPath = path.join(d, `${profile}.device.json`);
            fs.writeFileSync(targetPath, JSON.stringify(dev, null, 2), 'utf8');
            try { fs.chmodSync(targetPath, 0o666); } catch(_) {}
        } catch (_) {}
    }
    return dev;
}


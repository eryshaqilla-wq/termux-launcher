async function handleOpenUrl(url, extraFlags = []) {
    if (!url || url === 'home' || url === 'about:home' || url === 'about:newtab') {
        url = 'file:///android_asset/webview_engine/home.html';
    }
    // 1. Deteksi Multi-Profile Flags (--all-profiles / --profiles / --parallel)
    let multiProfiles = null;
    const isAllProfiles = extraFlags.includes('--all-profiles') || extraFlags.includes('--allprofiles');
    const isParallel = extraFlags.includes('--parallel');

    if (isAllProfiles) {
        multiProfiles = ['shaqilla', 'eryziggy', '0xjamrud'];
    } else {
        const pIdx = extraFlags.indexOf('--profiles');
        if (pIdx !== -1 && extraFlags[pIdx + 1] && !extraFlags[pIdx + 1].startsWith('--')) {
            multiProfiles = extraFlags[pIdx + 1].split(',').map(s => s.trim()).filter(Boolean);
        } else {
            const pEqual = extraFlags.find(f => f.startsWith('--profiles='));
            if (pEqual) {
                multiProfiles = pEqual.split('=')[1].split(',').map(s => s.trim()).filter(Boolean);
            }
        }
    }

    if (multiProfiles && multiProfiles.length > 0) {
        const cleanFlags = [];
        for (let i = 0; i < extraFlags.length; i++) {
            const f = extraFlags[i];
            if (f === '--all-profiles' || f === '--allprofiles' || f === '--parallel') {
                continue;
            } else if (f === '--profiles') {
                i++;
                continue;
            } else if (f.startsWith('--profiles=')) {
                continue;
            } else {
                cleanFlags.push(f);
            }
        }

        const hasMacro = cleanFlags.some(f => f.startsWith('--modul') || f.startsWith('--macro') || f.startsWith('--recipe'));
        if (isParallel) {
            console.log(`\n[MULTI-PROFILE RUNNER] Meluncurkan ${hasMacro ? 'Makro' : 'Tab'} untuk ${multiProfiles.length} Profil (Mode: PARALEL BERSAMAAN)...`);
            for (let i = 0; i < multiProfiles.length; i++) {
                const currentProfile = multiProfiles[i];
                const shortProf = currentProfile.replace(/[^a-zA-Z0-9]/g, '').slice(0, 10);
                const workerTab = `w_${shortProf}`.slice(0, 14);
                const profileFlags = ['--profile', currentProfile, ...(hasMacro ? ['--in-worker-tab', '--tab-name', workerTab] : []), ...cleanFlags.filter(f => !f.startsWith('--profile'))];
                const baseWebCmd = `web ${profileFlags.map(a => (a.includes(' ') || a.includes('&') || a.includes('#')) ? `"${a.replace(/"/g, '\\"')}"` : a).join(' ')} ${url || ''}`.trim();
                const launchCmd = hasMacro
                    ? `${baseWebCmd}; sleep 1; termux-ipc tab close "${workerTab}" 2>/dev/null || termux-ipc tab close current 2>/dev/null || true`
                    : `${baseWebCmd}`;
                console.log(`  🚀 Meluncurkan Tab [${currentProfile}] -> ${workerTab}`);
                runIpcTab('new', [workerTab, launchCmd]);
                await sleep(1000);
            }
            console.log(`\n[MULTI-PROFILE RUNNER] Seluruh ${multiProfiles.length} tab profil berhasil diluncurkan!`);
            console.log(`Tuan dapat memantau progresnya di laci tab WebView atau terminal tabs.\n`);
            return;
        } else {
            console.log(`\n[MULTI-PROFILE RUNNER] Membuka ${multiProfiles.length} Profil (Mode: Sekuensial 1/1)...`);
            const summary = [];
            for (let i = 0; i < multiProfiles.length; i++) {
                const currentProfile = multiProfiles[i];
                console.log(`\n=============================================================`);
                console.log(`▶ [${i + 1}/${multiProfiles.length}] Menjalankan Profil: ${currentProfile}`);
                console.log(`=============================================================`);
                const profileFlags = ['--profile', currentProfile, ...cleanFlags.filter(f => !f.startsWith('--profile'))];
                const startTime = Date.now();
                try {
                    await executeSingleProfile(url, profileFlags);
                    const elapsed = ((Date.now() - startTime) / 1000).toFixed(1);
                    summary.push({ profile: currentProfile, status: 'OK', time: `${elapsed}s` });
                } catch (err) {
                    summary.push({ profile: currentProfile, status: 'FAILED', error: err.message });
                }
            }
            console.log(`\n=============================================================`);
            console.log(`[MULTI-PROFILE RUNNER] Ringkasan Eksekusi Selesai:`);
            summary.forEach(s => {
                console.log(`  - ${s.profile.padEnd(12)}: [${s.status}] (${s.time || s.error})`);
            });
            console.log(`=============================================================\n`);
            return;
        }
    }

    await executeSingleProfile(url, extraFlags);
}

async function executeSingleProfile(url, extraFlags = []) {
    let targetProfile = null;
    let explicitProfile = false;
    let flagsWithoutProfile = [];
    let modulQuery = null;
    let loopCount = 1;
    let targetWallet = null;
    let needWallet = false;
    let stopIfWord = null;
    let stopNotWord = null;
    let passwordArg = null;
    let explicitPassword = false;

    for (let i = 0; i < extraFlags.length; i++) {
        const flag = extraFlags[i];
        if (flag === '--profile' && extraFlags[i + 1]) {
            targetProfile = extraFlags[i + 1];
            explicitProfile = true;
            i++;
        } else if (flag.startsWith('--profile=')) {
            targetProfile = flag.split('=')[1] || 'default';
            explicitProfile = true;
        } else if (flag === '--pwd' || flag === '--password') {
            if (extraFlags[i + 1] && !extraFlags[i + 1].startsWith('--')) {
                passwordArg = extraFlags[i + 1];
                explicitPassword = true;
                i++;
            }
        } else if (flag.startsWith('--pwd=') || flag.startsWith('--password=')) {
            passwordArg = flag.split('=')[1] || null;
            explicitPassword = true;
        } else if (flag === '--modul' || flag === '--macro' || flag === '--recipe') {
            if (extraFlags[i + 1] && !extraFlags[i + 1].startsWith('--')) {
                modulQuery = extraFlags[i + 1];
                i++;
            }
        } else if (flag.startsWith('--modul=') || flag.startsWith('--macro=') || flag.startsWith('--recipe=')) {
            modulQuery = flag.split('=')[1];
        } else if (flag === '--loop' || flag === '-l') {
            if (extraFlags[i + 1] && !extraFlags[i + 1].startsWith('--')) {
                loopCount = parseInt(extraFlags[i + 1], 10) || 1;
                i++;
            }
        } else if (flag.startsWith('--loop=')) {
            loopCount = parseInt(flag.split('=')[1], 10) || 1;
        } else if (flag === '--wallet') {
            needWallet = true;
            if (extraFlags[i + 1] && !extraFlags[i + 1].startsWith('--') && !extraFlags[i + 1].startsWith('http://') && !extraFlags[i + 1].startsWith('https://')) {
                targetWallet = extraFlags[i + 1];
                i++;
            } else {
                targetWallet = null;
            }
        } else if (flag.startsWith('--wallet=')) {
            needWallet = true;
            targetWallet = flag.split('=')[1] || null;
        } else if (flag === '--stop-if' || flag === '--stopif' || flag === '--stop-when') {
            if (extraFlags[i + 1] && !extraFlags[i + 1].startsWith('--')) {
                stopIfWord = extraFlags[i + 1];
                i++;
            }
        } else if (flag.startsWith('--stop-if=') || flag.startsWith('--stopif=')) {
            stopIfWord = flag.split('=')[1] || null;
        } else if (flag === '--stop-not') {
            if (extraFlags[i + 1] && !extraFlags[i + 1].startsWith('--')) {
                stopNotWord = extraFlags[i + 1];
                i++;
            }
        } else if (flag.startsWith('--stop-not=')) {
            stopNotWord = flag.split('=')[1] || null;
        } else {
            flagsWithoutProfile.push(flag);
        }
    }

    const isWorkerTab = extraFlags.includes('--in-worker-tab');
    let workerTabName = '';
    const wIdx = extraFlags.indexOf('--tab-name');
    if (wIdx !== -1 && extraFlags[wIdx + 1]) {
        workerTabName = extraFlags[wIdx + 1];
    }

    let spawnedWalletTab = null;
    if (needWallet) {
        const wRes = await ensureGhostWalletRunning(true);
        spawnedWalletTab = wRes.spawnedTab;
        if (!flagsWithoutProfile.includes('--ghost')) {
            flagsWithoutProfile.push('--ghost');
        }
        if (targetWallet && !flagsWithoutProfile.some(f => f.startsWith('--wallet'))) {
            flagsWithoutProfile.push(`--wallet "${targetWallet}"`);
        }
    }

    let recipe = null;
    if (modulQuery) {
        recipe = loadRecipe(modulQuery);
        if (!recipe) {
            console.error(`${RED}[Modul Makro] Resep/modul "${modulQuery}" tidak ditemukan!${RESET}`);
            console.error(`Periksa nama resep di /root/wallet/recipes_db.json atau pastikan path file valid.`);
            process.exit(1);
        }
        if (!url && recipe.targetUrl) {
            url = recipe.targetUrl;
        }
    }

    if (!url || url === 'home' || url === 'about:home' || url === 'about:newtab') {
        url = 'file:///android_asset/webview_engine/home.html';
    }

    // Password vault HANYA diakses jika menjalankan resep/modul makro atau jika diberikan --pwd secara eksplisit
    if (recipe || modulQuery || explicitPassword) {
        if (!passwordArg && url) {
            passwordArg = getCachedPassword(url);
        }
        if (explicitPassword && passwordArg && url) {
            saveCachedPassword(url, passwordArg, 'cli');
        }
    }

    if (!explicitProfile) {
        targetProfile = 'default';
    }

    if (targetProfile && targetProfile !== 'default') {
        process.env.FUSION_ACTIVE_PROFILE = targetProfile;
        if (!isWorkerTab) {
            setActiveProfile(targetProfile);
        }
        registerProfile(targetProfile);
    }

    let fullFlags = `--profile ${targetProfile}`;
    if (flagsWithoutProfile.length > 0) {
        fullFlags += ` ${flagsWithoutProfile.join(' ')}`;
    }

    const res = runIpc(`${fullFlags} ${url}`);

    // Print 1x bersih dan ringkas tanpa icon alay
    let displayUrl;
    if (url.includes('home.html')) {
        displayUrl = 'Beranda Browser (Fusion Home)';
    } else {
        displayUrl = (url.startsWith('http://') || url.startsWith('https://') || url.startsWith('file://')) ? url : `https://${url}`;
    }
    let statusMsg = `Membuka ${displayUrl}`;
    if (targetProfile && targetProfile !== 'default') statusMsg += ` (profil: ${targetProfile}) [Auto-Session: Aktif]`;
    if (needWallet) statusMsg += ` [GhostWallet: ${targetWallet ? targetWallet : 'Auto-Daemon'}]`;
    console.log(statusMsg);

    // Hanya tampilkan jika ada output error tidak terduga
    if (res && !res.toLowerCase().includes('meluncurkan') && res !== 'OK') {
        console.log(res);
    }

    if (recipe) {
        let eventsToRun = (recipe.events || []).slice();
        if (stopIfWord) {
            eventsToRun.push({
                type: 'stop_if',
                text: stopIfWord,
                condition: 'contains',
                desc: 'Auto-Stop jika ada: ' + stopIfWord,
                timestamp: Date.now()
            });
            console.log(`[Modul Makro] Disisipkan Auto-Stop jika terdeteksi: "${stopIfWord}"`);
        }
        if (stopNotWord) {
            eventsToRun.push({
                type: 'stop_not',
                text: stopNotWord,
                condition: 'not_found',
                desc: 'Auto-Stop jika hilang: ' + stopNotWord,
                timestamp: Date.now()
            });
            console.log(`[Modul Makro] Disisipkan Auto-Stop jika hilang: "${stopNotWord}"`);
        }
        const triggered = await triggerRecipeInWebView(recipe.name, eventsToRun, loopCount, passwordArg);
        if (triggered) {
            const completionStatus = await waitForRecipeCompletion();
            if (completionStatus === 'INVALID_PASSWORD') {
                console.error(`[AGY_ERROR: INVALID_PASSWORD] Password "${passwordArg}" ditolak oleh situs web!`);
                process.exitCode = 2;
            }
        }
    }

    // Cleanup: Jika wallet dinyalakan khusus untuk sesi ini, hentikan dan tutup tabnya
    if (spawnedWalletTab) {
        console.log(`[GhostWallet] Makro selesai. Menghentikan daemon & menutup tab "${spawnedWalletTab}"...`);
        try {
            execSync("fuser -k 3333/tcp 2>/dev/null || pkill -f 'ghostwallet 3333' 2>/dev/null || true");
            runIpcTab('close', [spawnedWalletTab]);
        } catch (_) {}
    }

    // Cleanup: Jika sesi berjalan di dalam tab worker terisolasi, tutup webview & tab worker
    if (isWorkerTab) {
        if (targetProfile && targetProfile !== 'default') {
            try {
                runIpc(`save-session ${targetProfile}`);
            } catch (_) {}
        }
        console.log(`[WebView Worker] Makro selesai. Menutup tab worker "${workerTabName || 'current'}"...`);
        await sleep(500);
        runIpc('close');
        if (workerTabName) {
            runIpcTab('close', [workerTabName]);
            if (workerTabName.length > 14) {
                runIpcTab('close', [workerTabName.slice(0, 14)]);
            }
        }
        runIpcTab('close', ['current']);
    }
}

async function main() {
    const args = process.argv.slice(2);
    const cmd = args[0] ? args[0].toLowerCase() : '';

    // 🔥 AUTO-DETECT & IMPORT CODE REKAMAN VIA CLI (web <coderekaman> atau web import <code/url>)
    const fullInput = args.join(' ').trim();
    const recipeData = decodeRecipePayloadCli(fullInput) || (args[1] ? decodeRecipePayloadCli(args.slice(1).join(' ')) : null);

    if (recipeData) {
        const result = saveRecipeToDisk(recipeData);
        if (result.ok) {
            console.log(`[Resep AGY Diimpor]`);
            console.log(`  Resep    : ${result.name}`);
            console.log(`  Langkah  : ${result.count}`);
            console.log(`  Target   : ${result.url || '(Tidak ditentukan)'}`);
            console.log(`  Database : ${result.file}\n`);

            if (result.url && (result.url.startsWith('http://') || result.url.startsWith('https://'))) {
                await handleOpenUrl(result.url, args.filter(a => a.startsWith('--')));
            } else {
                console.log(`Resep siap diputar di WebView. Buka: web <url> lalu tekan tombol REC.`);
            }
            process.exit(0);
        } else {
            console.log(`Gagal menyimpan resep: ${result.error}`);
            process.exit(1);
        }
    }

    if (cmd === '--help' || cmd === 'help' || cmd === '-h') {
        console.log(`\nAGENT-WEB CONTROLLER (Universal Web Automation)`);
        console.log(`Pengendali browser otonom untuk Antigravity, Subagents, dan CLI.\n`);
        console.log(`Usage:`);
        console.log(`  web                           (Buka halaman Beranda browser)`);
        console.log(`  web <url> [options]           (Buka URL di WebView)`);
        console.log(`  web --modul <makro> <url>     (Auto-play resep makro on-load)`);
        console.log(`  web --modul <m> --all-profiles [--parallel] (Putar makro untuk 3 wallet utama: 1/1 atau Paralel)`);
        console.log(`  web --modul <m> --profiles a,b [--parallel] (Putar makro untuk daftar profil tertentu)`);
        console.log(`  web --wallet [nama] <url>     (Auto-start GhostWallet port 3333 & connect)`);
        console.log(`  web --loop <n>                (Jumlah putaran murni, tanpa switch wallet)`);
        console.log(`  web --stop-if "kata"          (Auto-stop loop seketika jika teks terdeteksi di DOM)`);
        console.log(`  web --stop-not "kata"         (Auto-stop loop jika teks hilang dari DOM)`);
        console.log(`  web <coderekaman>             (Import resep otomatis)`);
        console.log(`  web load <profil>             (Load profil & pasang sesi cookies ke browser)`);
        console.log(`  web eject                     (Simpan sesi profil aktif & unmount/bersihkan browser)`);
        console.log(`  web save-session [nama]       (Simpan sesi website ke profil)`);
        console.log(`  web x-post "teks" [--profile] (Post tweet ke X)`);
        console.log(`  web prompt "instruksi"        (Eksekusi automasi via NLP)`);
        console.log(`  web click "Nama Tombol"       (Klik elemen)`);
        console.log(`  web type "Kolom" "Nilai"      (Input teks)`);
        console.log(`  web snapshot                  (Ambil DOM dump aktif)`);
        console.log(`  web clear-cookies             (Bersihkan cookies & cache aktif)`);
        console.log(`  web eval "kode JS"            (Eksekusi JavaScript di WebView)`);
        console.log(`  web close                     (Tutup WebView)\n`);
        console.log(`Contoh Integrasi Telegram / Sniper:`);
        console.log(`  web --wallet Master --modul web3_claim "https://web3.claim/gift/gsisbsi"`);
        console.log(`  web --modul giftedstock_claim --loop 5 "https://giftedstock.com/gift"`);
        console.log(`  web --wallet --modul gacha_box --stop-if "Out of stock" --loop 20 "https://dapp.xyz/box"\n`);
        process.exit(0);
    }

    if (args.length === 0 || cmd === 'home' || cmd === 'beranda') {
        await handleOpenUrl('file:///android_asset/webview_engine/home.html', args.filter(a => a !== 'home' && a !== 'beranda'));
        process.exit(0);
    }

    if (cmd === '--watch-session' || cmd === 'watch-session') {
        const prof = args[1];
        if (prof) {
            await runSessionWatcher(prof);
        }
        process.exit(0);
    }

    if (cmd === 'profile' || cmd === 'profiles') {
        const targetProf = args[1] || getActiveProfile();
        if (targetProf && targetProf !== 'list' && targetProf !== 'default') {
            printProfileBanner(targetProf);
        }
        const active = getActiveProfile();
        const dirs = getAllSessionDirs();
        const profiles = new Set();
        for (const d of dirs) {
            try {
                const files = fs.readdirSync(d);
                for (const f of files) {
                    if (f.endsWith('.json') && !f.endsWith('.device.json')) profiles.add(f.replace('.json', ''));
                }
            } catch (_) {}
        }
        console.log(`Profil aktif saat ini : ${active}`);
        console.log(`Sesi tersimpan di vault: ${Array.from(profiles).join(', ') || '(belum ada)'}`);
        process.exit(0);
    }

    if (cmd === 'load' || cmd === 'load-profile' || (cmd === 'profile' && args[1] === 'load')) {
        const prof = (cmd === 'profile' ? args[2] : args[1]);
        if (!prof) {
            console.log(`${RED}Error: Tentukan nama profil yang ingin di-LOAD! Contoh: web load eryziggy${RESET}`);
            process.exit(1);
        }
        setActiveProfile(prof);
        await injectSessionCookies(prof);
        printProfileBanner(prof);
        console.log(`Profil [${prof}] berhasil di-LOAD (Sesi aktif).`);
        process.exit(0);
    }

    if (cmd === 'eject' || cmd === 'eject-profile' || (cmd === 'profile' && args[1] === 'eject')) {
        const prof = getActiveProfile();
        if (!prof || prof === 'default') {
            console.log(`Tidak ada profil aktif yang perlu di-EJECT.`);
            process.exit(0);
        }
        console.log(`Menyimpan dan meng-EJECT profil [${prof}]...`);
        await saveSessionCookies(prof, false);
        await clearCdpCookies();
        runIpc('clear-cache');
        setActiveProfile('default');
        console.log(`Profil [${prof}] berhasil di-EJECT. (Sesi disimpan, cookies dibersihkan).`);
        process.exit(0);
    }

    if (cmd === 'clear-cookies' || cmd === 'clearcookies' || cmd === 'clean') {
        console.log(`Membersihkan seluruh cookies & storage aktif...`);
        await clearCdpCookies();
        runIpc('clear-cache');
        console.log(`Cookies dan storage aktif telah dibersihkan.`);
        process.exit(0);
    }

    if (cmd === 'save' || cmd === 'save-session' || cmd === 'save-profile') {
        const activeProf = getActiveProfile();
        const prof = args[1] || (activeProf !== 'default' ? activeProf : null);
        if (!prof) {
            console.log(`${RED}Error: Tentukan profil yang ingin disimpan! Contoh: web save <nama_profil>${RESET}`);
            process.exit(1);
        }

        // SYSTEM LOCK: Jika sesi aktif sedang terkunci pada profil tertentu dan target berbeda, tolak keras!
        if (activeProf && activeProf !== 'default' && prof !== activeProf) {
            console.error(`${RED}[SYSTEM LOCK ERROR] Sesi web saat ini sedang terkunci pada profil [${activeProf}]. Mustahil dan dilarang keras menyimpan ke profil berbeda [${prof}]!${RESET}`);
            process.exit(1);
        }

        console.log(`Menyimpan sesi website untuk profil [${prof}] via IPC Native...`);
        try {
            const ipcResp = runIpc(`save-session ${prof}`);
            if (ipcResp && (ipcResp.includes('berhasil') || ipcResp.includes('OK') || ipcResp.includes('cookies'))) {
                console.log(ipcResp.trim());
                process.exit(0);
            }
        } catch (_) {}

        // Fallback CDP jika IPC tidak aktif
        const ok = await saveSessionCookies(prof);
        if (ok) {
            console.log(`Sesi website berhasil disimpan ke profil [${prof}].`);
        } else {
            console.log(`${RED}Gagal menyimpan sesi untuk profil [${prof}] (System Lock atau sesi kosong).${RESET}`);
            process.exit(1);
        }
        process.exit(0);
    }

    if (cmd === 'x-post' || cmd === 'post-x' || cmd === 'tweet') {
        let profile = 'shaqilla';
        let textArgs = [];
        for (let i = 1; i < args.length; i++) {
            if (args[i] === '--profile' && args[i + 1]) {
                profile = args[i + 1];
                i++;
            } else {
                textArgs.push(args[i]);
            }
        }
        const tweetText = textArgs.join(' ').trim();
        if (!tweetText) {
            console.log(`${RED}Error: Masukkan teks yang ingin diposting!${RESET}`);
            console.log(`Contoh: web x-post "Halo dunia Web3!" --profile shaqilla`);
            process.exit(1);
        }
        await handleXPost(tweetText, profile);
        process.exit(0);
    }

    // Deteksi otomatis: Jika dipanggil dari Telegram/skrip background (!isTTY) atau flag --new-tab
    const isTelegramCaller = Boolean(
        !process.stdin.isTTY ||
        process.env.TELEGRAM || 
        process.env.AI_AGENT || 
        process.env.AGENT_MODE || 
        args.includes('--telegram') || 
        args.includes('--new-tab')
    );
    const inWorkerTab = args.includes('--in-worker-tab');

    if (cmd === 'open') {
        const url = args[1];
        if (!url) {
            console.log(`${RED}Error: Masukkan URL yang ingin dibuka!${RESET}`);
            process.exit(1);
        }
        const extraFlags = args.slice(2);
        await handleOpenUrl(url, extraFlags);
        process.exit(0);
    }

    // Jika dipanggil oleh Telegram / skrip background dan belum di dalam worker tab: delegasikan ke tab baru via IPC!
    if (isTelegramCaller && !inWorkerTab && !['prompt', 'click', 'type', 'fill', 'snapshot', 'dom', 'eval', 'close'].includes(cmd)) {
        const workerTab = ('w_' + Date.now().toString().slice(-8)).slice(0, 14);
        const cleanArgs = args.filter(a => a !== '--telegram' && a !== '--new-tab');
        const delegatedCmd = `web --in-worker-tab --tab-name ${workerTab} ${cleanArgs.map(a => (a.includes(' ') || a.includes('&') || a.includes('#')) ? `"${a.replace(/"/g, '\\"')}"` : a).join(' ')}; sleep 1; termux-ipc tab close "${workerTab}" 2>/dev/null || termux-ipc tab close current 2>/dev/null || true`;
        console.log(`[Agent-Web] Panggilan background/Telegram terdeteksi. Membuka tab baru "${workerTab}" via IPC...`);
        runIpcTab('new', [workerTab, delegatedCmd]);
        process.exit(0);
    }

    // Deteksi jika pemanggilan berupa URL langsung atau membawa opsi automasi (--modul / --wallet / --recipe / --loop / --stop-if / --all-profiles / --profile / --desktop / --ghost)
    const isUrlOrAutomation = args.some(a => 
        a.startsWith('--modul') || a.startsWith('--macro') || a.startsWith('--recipe') ||
        a.startsWith('--wallet') || a.startsWith('--stop-if') || a.startsWith('--stop-not') || a.startsWith('--stopif') ||
        a.startsWith('--pwd') || a.startsWith('--password') || a.startsWith('--profile') || a.startsWith('--desktop') || a.startsWith('--ghost') ||
        a.startsWith('--all-profiles') || a.startsWith('--allprofiles') || a.startsWith('--profiles') || a.startsWith('--parallel') ||
        a === 'home' || a === 'beranda' ||
        a.startsWith('http://') || a.startsWith('https://') ||
        (a.includes('.') && !a.startsWith('-') && !a.endsWith('.js') && !a.endsWith('.cjs') && !a.endsWith('.json'))
    );

    if (isUrlOrAutomation && !['prompt', 'click', 'type', 'fill', 'snapshot', 'dom', 'eval', 'close'].includes(cmd)) {
        let targetUrl = '';
        let passFlags = [];
        for (let i = 0; i < args.length; i++) {
            const item = args[i];
            if (item === '--profile' || item === '--wallet' || item === '--modul' || item === '--macro' || item === '--recipe' || item === '--loop' || item === '-l' || item === '--stop-if' || item === '--stopif' || item === '--stop-not' || item === '--stop-when' || item === '--tab-name' || item === '--profiles' || item === '--pwd' || item === '--password') {
                passFlags.push(item);
                if (args[i + 1] && !args[i + 1].startsWith('--')) {
                    // Cek jika item adalah option yang mengambil value
                    passFlags.push(args[i + 1]);
                    i++;
                }
            } else if (item === '--in-worker-tab' || item === '--all-profiles' || item === '--allprofiles' || item === '--parallel') {
                passFlags.push(item);
            } else if (item.startsWith('--')) {
                passFlags.push(item);
            } else if (!targetUrl && (item.startsWith('http://') || item.startsWith('https://') || item === 'home' || item === 'beranda' || item.includes('.'))) {
                targetUrl = (item === 'home' || item === 'beranda') ? 'file:///android_asset/webview_engine/home.html' : item;
            } else {
                passFlags.push(item);
            }
        }
        if (!targetUrl) {
            targetUrl = 'file:///android_asset/webview_engine/home.html';
        }
        await handleOpenUrl(targetUrl, passFlags);
        process.exit(0);
    }

    if (cmd === 'prompt') {
        const promptText = args.slice(1).join(' ').trim();
        if (!promptText) {
            console.log(`${RED}Error: Masukkan teks prompt!${RESET}`);
            process.exit(1);
        }
        runIpc(`prompt "${promptText}"`);
        process.exit(0);
    }

    if (cmd === 'click') {
        const target = args.slice(1).join(' ').trim();
        runIpc(`prompt "klik ${target}"`);
        process.exit(0);
    }

    if (cmd === 'type' || cmd === 'fill') {
        const field = args[1];
        const val = args.slice(2).join(' ').trim();
        runIpc(`prompt "isi ${field} ${val}"`);
        process.exit(0);
    }

    if (cmd === 'snapshot' || cmd === 'dom') {
        await handleSnapshot();
        process.exit(0);
    }

    if (cmd === 'eval') {
        const js = args.slice(1).join(' ').trim();
        const res = evalJs(js);
        if (res) console.log(res);
        process.exit(0);
    }

    if (cmd === 'kill' || cmd === 'kill-tab' || cmd === 'killtab') {
        const killArg = args[1] && !args[1].startsWith('-') ? `kill-tab ${args[1]}` : 'kill-tab';
        runIpc(killArg);
        console.log(`Tab WebView ditutup.`);
        process.exit(0);
    }

    if (cmd === 'close') {
        runIpc('close');
        console.log(`WebView ditutup.`);
        process.exit(0);
    }

    // Default: teruskan ke termux-ipc webview
    const output = runIpc(args.join(' '));
    if (output) console.log(output);
}

main().catch(err => {
    console.error(`${RED}Error: ${err.message}${RESET}`);
    process.exit(1);
});

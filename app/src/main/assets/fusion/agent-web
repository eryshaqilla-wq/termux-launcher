    const identities = new Map(); // uid -> profileName

    // 1. Peta bawaan Tri-Agent resmi Tuan Eso
    identities.set('1314621600', 'shaqilla');
    identities.set('1533016831161606144', 'eryziggy');
    identities.set('1604449944899063809', '0xjamrud');

    // 2. Scan seluruh file profil (.json) di seluruh vault sessions secara dinamis (unlimited profiles)
    const dirs = getAllSessionDirs();
    for (const d of dirs) {
        if (!fs.existsSync(d)) continue;
        try {
            const files = fs.readdirSync(d);
            for (const f of files) {
                if (!f.endsWith('.json') || f.endsWith('.device.json') || f === 'webview_profiles.json') continue;
                const profName = path.basename(f, '.json');
                if (profName === 'default' || profName.startsWith('fresh_')) continue;
                try {
                    const content = JSON.parse(fs.readFileSync(path.join(d, f), 'utf8'));
                    if (content && Array.isArray(content.cookies)) {
                        const twidCookie = content.cookies.find(c => c.name === 'twid');
                        if (twidCookie && twidCookie.value) {
                            const match = twidCookie.value.match(/u%3D(\d+)/) || twidCookie.value.match(/(\d+)/);
                            if (match && match[1]) {
                                identities.set(match[1], profName);
                            }
                        }
                    }
                } catch (_) {}
            }
        } catch (_) {}
    }
    return identities;
}


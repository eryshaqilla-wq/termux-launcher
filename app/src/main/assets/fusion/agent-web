async function triggerRecipeInWebView(recipeName, recipeEvents, loopCount = 1, password = null) {
    const safeName = recipeName.replace(/[^a-zA-Z0-9_-]/g, '_');
    console.log(`[Modul Makro] Menyiapkan auto-play resep "${safeName}" (Loop: ${loopCount}x murni, tanpa switch wallet)...`);
    if (password) {
        console.log(`[Modul Makro] Menyertakan Password / 口令 Klaim: "${password}"`);
    }

    const triggerJs = `(function() {
        if (window.__AGY_RECIPE_TRIGGERED__) return 'ALREADY_RUNNING';
        if (!window.AgyBatchRunner || typeof window.AgyBatchRunner.run !== 'function') return 'NOT_READY';
        window.__AGY_ACTIVE_PASSWORD__ = ${JSON.stringify(password || '')};
        var events = ${JSON.stringify(recipeEvents)};
        window.__AGY_RECIPE_TRIGGERED__ = true;
        window.__AGY_RECIPE_STATUS__ = 'RUNNING';
        window.AgyBatchRunner.run(events, '${safeName}', '1', false, function(result) {
            window.__AGY_RECIPE_STATUS__ = 'COMPLETED';
            window.__AGY_RECIPE_RESULT__ = result;
        }, 'raw', ${loopCount});
        return 'STARTED';
    })()`;

    for (let attempt = 1; attempt <= 15; attempt++) {
        await sleep(1500);
        try {
            const res = runIpc(`eval "${triggerJs.replace(/\n/g, ' ').replace(/"/g, '\\"')}"`);
            if (res && res.includes('STARTED')) {
                console.log(`[Modul Makro] Resep "${safeName}" sukses diputar di WebView!`);
                return true;
            } else if (res && res.includes('ALREADY_RUNNING')) {
                return true;
            }
        } catch (_) {}
    }
    console.log(`[Modul Makro] Peringatan: Timeout menunggu kesiapan DOM / WebView.`);
    return false;
}

async function waitForRecipeCompletion(timeoutMs = 180000) {
    const start = Date.now();
    const checkJs = `(function() {
        var txt = (document.body && document.body.innerText) ? document.body.innerText : '';
        if (txt.includes('口令错误') || txt.includes('密码错误') || txt.includes('Wrong password') || txt.includes('Password incorrect') || txt.includes('Kode salah') || txt.includes('Password salah')) {
            return 'INVALID_PASSWORD';
        }
        if (window.__AGY_RECIPE_STATUS__ === 'COMPLETED') return 'COMPLETED';
        if (!window.AgyBatchRunner || !window.AgyBatchRunner.isRunning) return 'STOPPED';
        return 'RUNNING';
    })()`;

    while (Date.now() - start < timeoutMs) {
        await sleep(1500);
        try {
            const res = runIpc(`eval "${checkJs.replace(/\n/g, ' ').replace(/"/g, '\\"')}"`);
            if (res && res.includes('INVALID_PASSWORD')) {
                console.log(`[Modul Makro] ❌ ERROR: [AGY_ERROR: INVALID_PASSWORD] Password ditolak oleh situs web!`);
                return 'INVALID_PASSWORD';
            } else if (res && res.includes('COMPLETED')) {
                console.log(`[Modul Makro] Seluruh alur makro telah selesai (COMPLETED)!`);
                return true;
            } else if (res && res.includes('STOPPED')) {
                console.log(`[Modul Makro] Alur makro selesai / berhenti.`);
                return true;
            }
        } catch (_) {}
    }
    console.log(`[Modul Makro] Batas waktu pemantauan (${timeoutMs / 1000}s) tercapai.`);
    return false;
}

function getAllSessionDirs() {
    const candidates = [
        process.env.FUSION_WALLET_DIR ? path.join(process.env.FUSION_WALLET_DIR, 'sessions') : null,
        process.env.HOME ? path.join(process.env.HOME, 'wallet', 'sessions') : null,
        '/data/data/com.termux/files/home/wallet/sessions',
        '/data/local/nhsystem/kali-arm64/root/wallet/sessions',
        '/root/wallet/sessions',
        '/wallet/sessions'
    ].filter(Boolean);

    const dirs = [];
    for (const dir of candidates) {
        try {
            if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });
            const real = fs.realpathSync.native ? fs.realpathSync.native(dir) : fs.realpathSync(dir);
            if (!dirs.includes(real)) dirs.push(real);
            if (!dirs.includes(dir)) dirs.push(dir);
        } catch (_) {
            if (fs.existsSync(dir) && !dirs.includes(dir)) dirs.push(dir);
        }
    }
    return dirs.length > 0 ? dirs : ['/root/wallet/sessions'];
}

function getSessionsDir() {
    const dirs = getAllSessionDirs();
    for (const dir of dirs) {
        if (fs.existsSync(dir)) return dir;
    }
    const def = '/root/wallet/sessions';
    try { fs.mkdirSync(def, { recursive: true }); } catch(_) {}
    return def;
}


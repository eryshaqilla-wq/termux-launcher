show_status() {
    title_header
    printf " ${CYAN}${BOLD}[ DIAGNOSTIK STATUS SISTEM & DAEMON ]${RESET}\n\n"

    # 1. Cek Socket IPC
    printf " ├─ Socket Termux IPC : "
    local py_cmd=""
    command -v python3 >/dev/null 2>&1 && py_cmd="python3" || command -v python >/dev/null 2>&1 && py_cmd="python"
    local ipc_pong=""
    if [ -n "$py_cmd" ]; then
        ipc_pong=$("$py_cmd" -c "
import socket
targets = ['\0termux_ipc', '/var/tmp/termux_ipc.sock', '/tmp/termux_ipc.sock']
resp = ''
for t in targets:
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(1.0)
        s.connect(t)
        s.sendall(b'ping\n')
        resp = s.recv(1024).decode(errors='ignore').strip()
        s.close()
        break
    except Exception:
        pass
if 'PONG' in resp:
    print('PONG')
" 2>/dev/null)
    fi

    if [ "$ipc_pong" = "PONG" ]; then
        printf "${GREEN}[OK] ONLINE (Abstract Socket @termux_ipc)${RESET}\n"
    else
        printf "${RED}[--] OFFLINE / STANDALONE (Socket belum terhubung)${RESET}\n"
    fi

    # 2. Cek Port 3333 (Wallet Daemon)
    printf " ├─ Ghost Web3 Wallet : "
    if (exec 3<>/dev/tcp/127.0.0.1/3333) 2>/dev/null; then
        exec 3<&- && exec 3>&-
        printf "${GREEN}[OK] AKTIF (Port 3333 Terbuka)${RESET}\n"
    else
        printf "${YELLOW}[--] STANDBY / MATI (Port 3333 Tertutup)${RESET}\n"
    fi

    # 3. Cek Port 20128 (9router AI)
    printf " ├─ 9router AI Engine : "
    if (exec 3<>/dev/tcp/127.0.0.1/20128) 2>/dev/null; then
        exec 3<&- && exec 3>&-
        printf "${GREEN}[OK] AKTIF (Port 20128 Terbuka)${RESET}\n"
    else
        printf "${YELLOW}[--] STANDBY / MATI (Port 20128 Tertutup)${RESET}\n"
    fi

    # 4. Cek AGY Multi-Account Pool
    printf " ├─ AGY Sandbox Pool  : "
    local acc_cnt=$(ls -1 /root/.agy-accounts/*.json 2>/dev/null | wc -l)
    local act_acc=$(cat /root/.agy-accounts/.active 2>/dev/null | tr -d '\r\n')
    if [ "$acc_cnt" -gt 0 ]; then
        printf "${GREEN}[OK] ${acc_cnt} Akun Terdaftar (Aktif: ${CYAN}${act_acc:-Default}${GREEN})${RESET}\n"
    else
        printf "${YELLOW}[!] Belum ada akun di ~/.agy-accounts/${RESET}\n"
    fi

    # 5. Cek Runtime Environment
    printf " ├─ Node.js Runtime   : ${CYAN}$(node -v 2>/dev/null || echo 'Tidak terpasang')${RESET}\n"
    printf " ├─ Python Runtime    : ${CYAN}$(python3 --version 2>/dev/null || echo 'Tidak terpasang')${RESET}\n"
    printf " └─ Folder Kerja      : ${CYAN}$(readlink -f /project 2>/dev/null || echo '/project')${RESET}\n\n"
}


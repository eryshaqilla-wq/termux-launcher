#!/usr/bin/env bash
# termux-backup-slot: Multi-profile / slot manager for Titanium Backup (.backup / com.ery.ziggy)
# Works directly on Android host, PRoot, and NetHunter chroot / Droidspaces containers.

PREF_FILE="/data/data/com.ery.ziggy/shared_prefs/DataProfilesCache.xml"
TERMUX_PREF="/data/data/com.termux/shared_prefs/fusion_slot_preferences.xml"

check_root() {
    if [ "$(id -u)" -eq 0 ]; then
        return 0
    fi
    if command -v su >/dev/null 2>&1 && su -c "id" >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

run_sh() {
    if [ -f "$PREF_FILE" ]; then
        sh -c "$*"
    else
        echo "$*" | su -mm -c "/system/bin/sh" 2>/dev/null || echo "$*" | su -c "/system/bin/sh"
    fi
}

is_auto_clear_cache() {
    if [ "$CLEAR_CACHE_OPT" = "1" ]; then
        return 0
    fi
    if run_sh "[ -f '$TERMUX_PREF' ] && grep -q 'name=\"slot_auto_clear_cache\" value=\"true\"' '$TERMUX_PREF' 2>/dev/null"; then
        return 0
    fi
    return 1
}

get_current() {
    if ! check_root; then
        echo "Error: Akses root (su) diperlukan untuk fitur slot .backup" >&2
        return 1
    fi
    curr=$(run_sh "grep 'name=\"currentProfile\"' /data/data/com.ery.ziggy/shared_prefs/DataProfilesCache.xml 2>/dev/null | sed -e 's/.*<string name=\"currentProfile\">//' -e 's/<\\/string>.*//'")
    if [ -z "$curr" ]; then
        curr=$(run_sh "readlink /data/data/com.kiwibrowser.browser/.data_profiles/.current 2>/dev/null")
    fi
    [ -z "$curr" ] && curr="01"
    echo "$curr"
}

get_all() {
    if ! check_root; then
        echo "Error: Akses root (su) diperlukan untuk fitur slot .backup" >&2
        return 1
    fi
    all=$(run_sh "grep 'name=\"profile\.' /data/data/com.ery.ziggy/shared_prefs/DataProfilesCache.xml 2>/dev/null | sed -e 's/.*name=\"profile\.//' -e 's/\".*//' | sort")
    if [ -z "$all" ]; then
        all=$(run_sh "ls -1 /data/data/com.kiwibrowser.browser/.data_profiles 2>/dev/null | grep -v '^\.' | sort")
    fi
    echo "$all"
}

switch_to() {
    if ! check_root; then
        echo "Error: Akses root (su) diperlukan untuk fitur slot .backup" >&2
        return 1
    fi

    target="$1"
    if [ -z "$target" ]; then
        echo "Error: target slot required" >&2
        return 1
    fi

    curr=$(get_current)
    if [ "$curr" = "$target" ]; then
        echo "Already on slot $target"
        return 0
    fi

    local CLEAR_CMD=""
    if is_auto_clear_cache; then
        CLEAR_CMD="
sync
echo 3 > /proc/sys/vm/drop_caches
am kill-all >/dev/null 2>&1 || true
sysctl -w vm.shrink_memory=1 >/dev/null 2>&1 || true
"
    fi

    local SCRIPT="
TARGET='$target'
PREF='/data/data/com.ery.ziggy/shared_prefs/DataProfilesCache.xml'
CURR=\$(grep 'name=\"currentProfile\"' \"\$PREF\" 2>/dev/null | sed -e 's/.*<string name=\"currentProfile\">//' -e 's/<\\/string>.*//')
[ -z \"\$CURR\" ] && [ -L '/data/data/com.kiwibrowser.browser/.data_profiles/.current' ] && CURR=\$(readlink /data/data/com.kiwibrowser.browser/.data_profiles/.current 2>/dev/null)
[ -f \"\$PREF\" ] && sed -i \"s/<string name=\\\"currentProfile\\\">.*<\\/string>/<string name=\\\"currentProfile\\\">\$TARGET<\\/string>/\" \"\$PREF\"
for pdir in \$(find /data/data -maxdepth 2 -name .data_profiles 2>/dev/null); do
  [ -d \"\$pdir\" ] || continue
  pkg=\$(basename \"\$(dirname \"\$pdir\")\")
  pkgdir=\$(dirname \"\$pdir\")
  /system/bin/am force-stop \"\$pkg\" >/dev/null 2>&1 || am force-stop \"\$pkg\" >/dev/null 2>&1 || true
  pkg_curr=\"\"
  if [ -L \"\$pdir/.current\" ]; then
    pkg_curr=\$(readlink \"\$pdir/.current\")
  elif [ -f \"\$pdir/.current\" ]; then
    pkg_curr=\$(cat \"\$pdir/.current\")
  fi
  [ -z \"\$pkg_curr\" ] && pkg_curr=\"\$CURR\"
  if [ -n \"\$pkg_curr\" ] && [ \"\$pkg_curr\" != \"\$TARGET\" ]; then
    mkdir -p \"\$pdir/\$pkg_curr\"
    for item in \"\$pkgdir\"/*; do
      [ -e \"\$item\" ] || continue
      bname=\$(basename \"\$item\")
      [ \"\$bname\" = \"lib\" ] && continue
      [ \"\$bname\" = \".data_profiles\" ] && continue
      mv \"\$item\" \"\$pdir/\$pkg_curr/\" 2>/dev/null || true
    done
    if [ -d \"\$pdir/\$TARGET\" ]; then
      for item in \"\$pdir/\$TARGET\"/*; do
        [ -e \"\$item\" ] || continue
        mv \"\$item\" \"\$pkgdir/\" 2>/dev/null || true
      done
    else
      mkdir -p \"\$pdir/\$TARGET\"
    fi
    rm -f \"\$pdir/.current\"
    ln -s \"\$TARGET\" \"\$pdir/.current\" 2>/dev/null || true
  fi
done
/system/bin/am broadcast -a android.appwidget.action.APPWIDGET_UPDATE -n com.ery.ziggy/com.myrefucek.FufuFu.MyDataProfileWidget >/dev/null 2>&1 || true
$CLEAR_CMD
"
    run_sh "$SCRIPT"

    # Notify Termux IPC if available
    if command -v termux-ipc >/dev/null 2>&1; then
        local TOAST="Slot Aktif: $target"
        if is_auto_clear_cache; then
            TOAST="Slot Aktif: $target, Dan Cache Dibersihkan!"
        fi
        termux-ipc toast "$TOAST" >/dev/null 2>&1 || true
    fi

    echo "Switched to slot $target"
}

prev_slot() {
    curr=$(get_current)
    all=$(get_all)
    prev=""
    last=""
    target=""

    for s in $all; do
        if [ "$s" = "$curr" ]; then
            target="$prev"
        fi
        prev="$s"
        last="$s"
    done

    if [ -z "$target" ]; then
        target="$last"
    fi

    if [ -n "$target" ]; then
        switch_to "$target"
    else
        echo "No slots available" >&2
        return 1
    fi
}

next_slot() {
    curr=$(get_current)
    all=$(get_all)
    first=""
    target=""
    take_next=0

    for s in $all; do
        [ -z "$first" ] && first="$s"
        if [ $take_next -eq 1 ]; then
            target="$s"
            break
        fi
        if [ "$s" = "$curr" ]; then
            take_next=1
        fi
    done

    if [ -z "$target" ]; then
        target="$first"
    fi

    if [ -n "$target" ]; then
        switch_to "$target"
    else
        echo "No slots available" >&2
        return 1
    fi
}

create_single_slot() {
    target="$1"
    if [ -z "$target" ]; then
        echo "Error: target slot required" >&2
        return 1
    fi

    # Proteksi nama sama
    all=$(get_all)
    for s in $all; do
        if [ "$s" = "$target" ]; then
            echo "Error: Slot '$target' sudah terdaftar! Proteksi aktif." >&2
            return 1
        fi
    done

    local SCRIPT="
PREF='/data/data/com.ery.ziggy/shared_prefs/DataProfilesCache.xml'
if [ -f \"\$PREF\" ]; then
  P_OWNER=\$(stat -c \"%u:%g\" \"\$PREF\" 2>/dev/null || stat -c \"%u:%g\" \"\$(dirname \"\$PREF\")\")
  grep -q 'name=\"profile.$target\"' \"\$PREF\" 2>/dev/null || sed -i 's/<\\/map>/    <string name=\"profile.$target\"><\\/string>\\n<\\/map>/' \"\$PREF\"
  chown \"\$P_OWNER\" \"\$PREF\" 2>/dev/null || true
  chmod 660 \"\$PREF\" 2>/dev/null || true
fi
for pdir in \$(find /data/data -maxdepth 2 -name .data_profiles 2>/dev/null); do
  [ -d \"\$pdir\" ] || continue
  dir_owner=\$(stat -c \"%u:%g\" \"\$pdir\" 2>/dev/null || stat -c \"%u:%g\" \"\$(dirname \"\$pdir\")\")
  sdir=\"\$pdir/$target\"
  if [ ! -d \"\$sdir\" ]; then
    mkdir -p \"\$sdir\" 2>/dev/null
    chown \"\$dir_owner\" \"\$sdir\" 2>/dev/null || true
    chmod 755 \"\$sdir\" 2>/dev/null || true
  fi
done
/system/bin/am broadcast -a android.appwidget.action.APPWIDGET_UPDATE -n com.ery.ziggy/com.myrefucek.FufuFu.MyDataProfileWidget >/dev/null 2>&1 || true
"
    run_sh "$SCRIPT"
    echo "✔ Slot berhasil dibuat: $target"
}

create_auto_next() {
    count="${1:-1}"
    all=$(get_all)
    max=-1
    for s in $all; do
        case "$s" in
            ''|*[!0-9]*) ;;
            *)
                num=$((10#$s))
                if [ $num -gt $max ]; then
                    max=$num
                fi
                ;;
        esac
    done

    next=$((max + 1))
    created=0
    curr=$next
    created_list=""

    while [ $created -lt $count ]; do
        if [ $curr -lt 100 ]; then
            name=$(printf "%02d" $curr)
        else
            name="$curr"
        fi

        # Cek apakah sudah ada
        exists=0
        for s in $all; do
            if [ "$s" = "$name" ]; then
                exists=1
                break
            fi
        done

        if [ $exists -eq 0 ]; then
            create_single_slot "$name" >/dev/null 2>&1
            created=$((created + 1))
            [ -z "$created_list" ] && created_list="$name" || created_list="$created_list, $name"
        fi
        curr=$((curr + 1))
    done

    echo "✔ Berhasil membuat $created slot baru: $created_list"
}

CLEAR_CACHE_OPT=0
while [ $# -gt 0 ]; do
    case "$1" in
        --clear-cache|--clean|-c)
            CLEAR_CACHE_OPT=1
            shift
            ;;
        *)
            break
            ;;
    esac
done

CMD="${1:-get}"
case "$CMD" in
    get|current|status)
        get_current
        ;;
    list|all)
        get_all
        ;;
    set|switch)
        switch_to "$2"
        ;;
    prev|previous)
        prev_slot
        ;;
    next)
        next_slot
        ;;
    add)
        create_auto_next "${2:-1}"
        ;;
    batch)
        create_auto_next "${2:-10}"
        ;;
    create)
        if [ -z "$2" ]; then
            echo "Usage: termux-backup-slot create <nama_slot>" >&2
            exit 1
        fi
        create_single_slot "$2"
        ;;
    picker|pick)
        if ! check_root; then
            echo "Error: Akses root (su) diperlukan untuk membuka .backup" >&2
            exit 1
        fi
        run_sh "/system/bin/am start -a ACTION_SELECT_DATA_PROFILE -n com.ery.ziggy/o.ḟ >/dev/null 2>&1"
        ;;
    *)
        if [ -n "$CMD" ]; then
            switch_to "$CMD"
        else
            echo "Usage: termux-backup-slot [--clear-cache] [get|list|set <slot>|prev|next|add [1|10|20]|batch [10|20]|create <slot>|picker]"
        fi
        ;;
esac

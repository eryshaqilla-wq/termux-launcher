        toolResult = 'Seluruh cookies dan web storage telah dibersihkan.';
    } else if (lower.includes('tweet') || lower.includes('post x') || lower.includes('posting')) {
        const tweetMatch = prompt.match(/["']([^"']+)["']/);
        if (tweetMatch) {
            postToX(tweetMatch[1], 'shaqilla');
            directTool = `Posting X: "${tweetMatch[1]}"`;
            toolResult = 'Tweet telah terkirim via akun shaqilla.';

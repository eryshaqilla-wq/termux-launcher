            const twText = toolArgs.text || 'Web3 updates';
            const targetProf = toolArgs.profile || 'shaqilla';
            postToX(twText, targetProf);
            directTool = `Tweet X (${targetProf}): "${twText}"`;
            reply = reply.replace(/<tool_call>[\s\S]*?<\/tool_call>/gi, '').trim();
            reply = `Tweet berhasil diposting via akun [${targetProf}].` + (reply ? `\n\n${reply}` : '');
        } else if (toolName.includes('alpha') || toolName.includes('telegram')) {
            const alphas = getLatestTelegramAlphas(5);
            directTool = `Scan Telegram Alphas (${alphas.length} ditemukan)`;
            reply = reply.replace(/<tool_call>[\s\S]*?<\/tool_call>/gi, '').trim();
            const listText = alphas.map((a, i) => `${i + 1}. ${a.channel || 'Channel'}: ${a.urls.join(', ') || a.content.substring(0, 60)}`).join('\n');
            reply = (listText || 'Belum ada sinyal baru.') + (reply ? `\n\n${reply}` : '');

            const e = (toolArgs.env || toolArgs.system || '').toLowerCase();
            if (e.includes('native') || e.includes('termux')) envOpt = '--native';
            else if (e.includes('chroot') || e.includes('kali') || e.includes('nethunter')) envOpt = '--chroot';
            else if (e.includes('proot')) envOpt = '--proot';
            const res = runCmd(`/usr/local/bin/termux-ipc tab new "${tabName}" ${envOpt} ${tabCmd}`.trim());
            directTool = `Buka Tab: ${tabName} (${envOpt || 'auto'})`;
            reply = reply.replace(/<tool_call>[\s\S]*?<\/tool_call>/gi, '').trim();
            reply = `Tab [${tabName}] dibuka di lingkungan [${envOpt || 'auto-detect'}].` + (reply ? `\n\n${reply}` : '');
        } else if (toolName.includes('close_tab') || toolName.includes('kill_tab') || toolName.includes('tab_close')) {

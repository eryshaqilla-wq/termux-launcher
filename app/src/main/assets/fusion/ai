        directTool = `Buka Tab: ${tabName} (${envOpt || 'auto'})`;
        toolResult = res || `Tab [${tabName}] berhasil dibuka.`;
    } else if (lower.includes('tutup tab') || lower.includes('close tab')) {
        const tabMatch = prompt.match(/tutup\s+tab\s+["']?([a-zA-Z0-9_-]+)["']?/i);
        const target = tabMatch ? tabMatch[1] : 'current';
        const res = runCmd(`/usr/local/bin/termux-ipc tab close "${target}"`);

function startGeminiServer(port = UI_PORT, launchWebview = true) {
    // Check if already running
    const check = runCmd(`curl -s http://127.0.0.1:${port}/api/status 2>/dev/null || echo "DEAD"`);
    if (!check.includes('DEAD') && check.includes('wallets')) {
        console.log(`Server Gemini UI sudah aktif di http://127.0.0.1:${port}`);
        if (launchWebview) {
            runCmd(`termux-ipc webview http://127.0.0.1:${port}`);
        }
        return;
    }

    const server = http.createServer(async (req, res) => {
        const url = req.url.split('?')[0];

        // CORS
        res.setHeader('Access-Control-Allow-Origin', '*');
        res.setHeader('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
        res.setHeader('Access-Control-Allow-Headers', 'Content-Type');

        if (req.method === 'OPTIONS') {
            res.writeHead(200);
            res.end();
            return;
        }

        // GET / (Serves index.html)
        if (url === '/' || url === '/index.html') {
            if (fs.existsSync(UI_INDEX_FILE)) {
                res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
                res.end(fs.readFileSync(UI_INDEX_FILE, 'utf8'));
            } else {
                res.writeHead(404, { 'Content-Type': 'text/plain' });
                res.end('UI file not found');
            }
            return;
        }

        // GET /api/status
        if (url === '/api/status' && req.method === 'GET') {
            const wInfo = getAllWallets();
            const tAccounts = getAllTelegramAccounts();
            const daemonStatus = runCmd('netstat -tlpn 2>/dev/null | grep :3333 || ss -tlpn 2>/dev/null | grep :3333').includes('3333');

            res.writeHead(200, { 'Content-Type': 'application/json' });
            res.end(JSON.stringify({
                wallets: wInfo.wallets,
                master_wallet_index: wInfo.master_index,
                telegram_accounts: tAccounts,
                daemon_running: daemonStatus
            }));
            return;
        }

        // POST /api/switch-engine
        if (url === '/api/switch-engine' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', () => {
                try {
                    const data = JSON.parse(body);
                    log(`[Engine] Switched preferred engine to: ${data.engine}`);
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: true, engine: data.engine }));
                } catch (_) {
                    res.writeHead(400); res.end('Invalid JSON');
                }
            });
            return;
        }

        // POST /api/switch-wallet
        if (url === '/api/switch-wallet' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', () => {
                try {
                    const data = JSON.parse(body);
                    const ok = switchMasterWallet(data.index);
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ ok: ok, master_index: data.index }));
                } catch (_) {
                    res.writeHead(400); res.end('Invalid JSON');
                }
            });
            return;
        }

        // POST /api/chat
        if (url === '/api/chat' && req.method === 'POST') {
            let body = '';
            req.on('data', chunk => body += chunk);
            req.on('end', async () => {
                try {
                    const data = JSON.parse(body);
                    const result = await handleChatApi(data.prompt, data.engine, data.wallet_index);
                    res.writeHead(200, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify(result));
                } catch (e) {
                    res.writeHead(500, { 'Content-Type': 'application/json' });
                    res.end(JSON.stringify({ error: e.message }));
                }
            });
            return;
        }

        res.writeHead(404);
        res.end('Not Found');
    });

    server.listen(port, '127.0.0.1', () => {
        console.log(`Server Gemini UI aktif di http://127.0.0.1:${port}`);
        if (launchWebview) {
            runCmd(`termux-ipc webview http://127.0.0.1:${port}`);
        }
    });
}


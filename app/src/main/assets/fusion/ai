// 1A. DeepSeek / Custom AI
async function queryDeepSeek(promptText, systemPrompt = 'You are an autonomous Web3 task agent. Reply strictly in concise JSON.') {
    const cfg = loadAiConfig();
    if (!cfg || !cfg.apiKey) return null;

    let base = (cfg.baseUrl || 'https://api.deepseek.com').replace(/\/+$/, '');
    let url = base.endsWith('/chat/completions') ? base : `${base}/chat/completions`;

    try {
        const payload = JSON.stringify({
            model: cfg.model || 'deepseek-flash',
            messages: [
                { role: 'system', content: systemPrompt },
                { role: 'user', content: promptText }
            ],
            stream: false
        });

        const res = await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${cfg.apiKey}`
            },
            body: payload,
            signal: AbortSignal.timeout(15000)
        });

        if (!res.ok) return null;
        const data = await res.json();
        return data.choices?.[0]?.message?.content?.trim() || null;
    } catch (_) {
        return null;
    }
}

// 1B. 9Router (Port 20128)
async function query9Router(promptText, systemPrompt = 'You are an autonomous Web3 task agent. Reply strictly in concise JSON.') {
    return new Promise((resolve) => {
        const postData = JSON.stringify({
            model: 'antigravity',
            messages: [
                { role: 'system', content: systemPrompt },
                { role: 'user', content: promptText }
            ],
            temperature: 0.2
        });

        const req = http.request({
            hostname: '127.0.0.1',
            port: 20128,
            path: '/v1/chat/completions',
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Content-Length': Buffer.byteLength(postData)
            },
            timeout: 10000
        }, (res) => {
            let data = '';
            res.on('data', chunk => data += chunk);
            res.on('end', () => {
                try {
                    const parsed = JSON.parse(data);
                    resolve(parsed.choices?.[0]?.message?.content?.trim() || null);
                } catch (_) {
                    resolve(null);
                }
            });
        });

        req.on('error', () => resolve(null));
        req.on('timeout', () => { req.destroy(); resolve(null); });
        req.write(postData);
        req.end();
    });
}

// 1C. AGY Ephemeral & Multi-Account Pool Resolver
function getAgyTokenFromPool(preferWorker = true) {
    const baseHome = process.env.HOME || '/root';
    const accDirs = [
        path.join(baseHome, '.agy-accounts'),
        '/root/.agy-accounts',
        '/data/data/com.termux/files/home/.agy-accounts'
    ];
    const accountsDir = accDirs.find(d => fs.existsSync(d));
    if (accountsDir) {
        try {
            const files = fs.readdirSync(accountsDir).filter(f => f.endsWith('.json'));
            if (files.length > 0) {
                const activePath = path.join(accountsDir, '.active');
                const activeName = fs.existsSync(activePath) ? fs.readFileSync(activePath, 'utf8').trim() : '';

                // Jika preferWorker, utamakan akun standby selain akun aktif Tuan di terminal
                if (preferWorker && files.length > 1 && activeName) {
                    const workerFiles = files.filter(f => !f.startsWith(activeName));
                    if (workerFiles.length > 0) {
                        return path.join(accountsDir, workerFiles[0]);
                    }
                }
                const targetFile = activeName && fs.existsSync(path.join(accountsDir, `${activeName}.json`))
                    ? path.join(accountsDir, `${activeName}.json`)
                    : path.join(accountsDir, files[0]);
                return targetFile;
            }
        } catch (_) {}
    }

    const legacyPaths = [
        path.join(baseHome, '.gemini/antigravity-cli/antigravity-oauth-token'),
        '/root/.gemini/antigravity-cli/antigravity-oauth-token',
        '/data/data/com.termux/files/home/.gemini/antigravity-cli/antigravity-oauth-token'
    ];
    return legacyPaths.find(p => fs.existsSync(p)) || null;
}

function getAgyAccountsCount() {

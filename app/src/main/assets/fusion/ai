// --- UTILITIES ---
function log(msg) {
    const line = `[${new Date().toISOString()}] ${msg}`;
    try { fs.appendFileSync(LOG_FILE, line + '\n'); } catch (_) {}
}

function runCmd(cmd) {
    try {
        return execSync(cmd, { encoding: 'utf8' }).trim();
    } catch (e) {
        return e.stdout ? e.stdout.trim() : `Error: ${e.message}`;
    }
}


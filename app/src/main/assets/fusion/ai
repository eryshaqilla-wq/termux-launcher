}

async function queryAgyEphemeral(promptText, systemPrompt = 'You are an autonomous Web3 task agent. Reply strictly in concise JSON.') {
    return new Promise((resolve) => {
        const tokenSource = getAgyTokenFromPool(true);
        if (!tokenSource || !fs.existsSync(tokenSource)) {
            return resolve(null);
        }

        const tmpDir = path.join('/tmp', `agy_auto_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`);
        const cliDir = path.join(tmpDir, '.gemini', 'antigravity-cli');
        try {
            fs.mkdirSync(cliDir, { recursive: true });
            fs.copyFileSync(tokenSource, path.join(cliDir, 'antigravity-oauth-token'));
            fs.chmodSync(path.join(cliDir, 'antigravity-oauth-token'), 0o600);

            const settingsCandidates = [
                path.join(process.env.HOME || '/root', '.gemini/antigravity-cli/settings.json'),
                '/root/.gemini/antigravity-cli/settings.json',
                '/data/data/com.termux/files/home/.gemini/antigravity-cli/settings.json'
            ];
            const foundSettings = settingsCandidates.find(s => fs.existsSync(s));
            if (foundSettings) {
                try { fs.symlinkSync(foundSettings, path.join(cliDir, 'settings.json')); } catch (_) {}
            }
        } catch (_) {
            return resolve(null);
        }

        const fullPrompt = systemPrompt ? `[SYSTEM: ${systemPrompt}]\n\n${promptText}` : promptText;
        const agyCandidates = [
            process.env.AGY_BIN,
            '/usr/local/bin/agy',
            '/root/.local/bin/agy',
            path.join(process.env.HOME || '/root', '.local/bin/agy'),
            '/data/data/com.termux/files/usr/bin/agy'
        ];
        const agyBin = agyCandidates.find(b => b && fs.existsSync(b)) || 'agy';

        const child = spawn(agyBin, ['-p', fullPrompt, '--effort', 'low', '--disable-slash-commands'], {
            env: { ...process.env, HOME: tmpDir, AGY_EPHEMERAL: '1' },
            timeout: 20000
        });

        let out = '';
        child.stdout.on('data', chunk => out += chunk);
        child.on('close', () => {
            try { fs.rmSync(tmpDir, { recursive: true, force: true }); } catch (_) {}
            const cleaned = out.replace(/\x1B\[[0-9;]*[a-zA-Z]/g, '').trim();
            resolve(cleaned || null);
        });
        child.on('error', () => {
            try { fs.rmSync(tmpDir, { recursive: true, force: true }); } catch (_) {}
            resolve(null);
        });
    });
}

// Tri-Engine Cascade Dispatcher with Auto-Fallback
async function queryTriEngineAi(promptText, systemPrompt, preferredEngine) {
    // 1. Preferred if specified
    if (preferredEngine === 'deepseek') {
        const res = await queryDeepSeek(promptText, systemPrompt);
        if (res) return { text: res, engine: 'DeepSeek' };
    } else if (preferredEngine === '9router') {
        const res = await query9Router(promptText, systemPrompt);
        if (res) return { text: res, engine: '9Router' };
    } else if (preferredEngine === 'agy') {
        const res = await queryAgyEphemeral(promptText, systemPrompt);
        if (res) return { text: res, engine: 'AGY Ephemeral' };
    }

    // 2. Cascade Fallback: DeepSeek -> 9Router -> AGY Ephemeral
    let ans = await queryDeepSeek(promptText, systemPrompt);
    if (ans) return { text: ans, engine: 'DeepSeek' };

    ans = await query9Router(promptText, systemPrompt);
    if (ans) return { text: ans, engine: '9Router (Fallback)' };

    ans = await queryAgyEphemeral(promptText, systemPrompt);
    if (ans) return { text: ans, engine: 'AGY Ephemeral (Fallback)' };

    return { text: null, engine: 'None (All Failed)' };
}


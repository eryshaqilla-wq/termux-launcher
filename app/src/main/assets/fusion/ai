    if (cmd === 'serve' || cmd === 'server') {
        startGeminiServer(UI_PORT, false);
        return;
    }

    if (cmd === 'status') {
        const status = {
            timestamp: new Date().toISOString(),
            system_env: detectSystemEnvironment(),
            engines: {
                ai: {
                    deepseek: Boolean(loadAiConfig().apiKey),
                    nine_router: runCmd('curl -s http://127.0.0.1:20128/v1/models 2>/dev/null || echo "DEAD"').includes('antigravity'),
                    agy_ephemeral: Boolean(getAgyTokenFromPool()),
                    agy_accounts: getAgyAccountsCount()
                },
                field: {
                    telegram: fs.existsSync(TELE_DB_PATH),
                    agent_web: fs.existsSync('/usr/local/bin/agent-web'),
                    wallet: getWalletInfo()
                }
            }
        };

        if (args.includes('--json')) {
            console.log(JSON.stringify(status, null, 2));
        } else {
            console.log('TRI-ENGINE AUTONOMOUS FUSION STATUS');
            console.log(`  Environment : ${status.system_env.name} [${status.system_env.runner}] (${status.system_env.device})`);
            console.log(`  AI Engines  : DeepSeek [${status.engines.ai.deepseek ? 'READY' : 'OFF'}] | 9Router [${status.engines.ai.nine_router ? 'READY' : 'OFF'}] | AGY Pool [${status.engines.ai.agy_accounts} ACCOUNTS READY]`);
            console.log(`  Field Radar : Telegram [${status.engines.field.telegram ? 'ONLINE' : 'OFF'}] | X/Web [${status.engines.field.agent_web ? 'READY' : 'OFF'}] | Wallet [${status.engines.field.wallet.daemon_running ? 'DAEMON_ACTIVE' : 'READY'}]`);
            console.log(`  Active Wal  : ${status.engines.field.wallet.master_wallet ? status.engines.field.wallet.master_wallet.name + ' (' + status.engines.field.wallet.master_wallet.address.substring(0, 10) + '...)' : 'None'}`);
        }
        return;
    }

    if (cmd === 'env' || cmd === 'sys') {
        const envInfo = detectSystemEnvironment();
        if (args.includes('--json')) {
            console.log(JSON.stringify(envInfo, null, 2));
        } else {
            console.log('SYSTEM ENVIRONMENT RECOGNITION:');
            console.log(`  Environment : ${envInfo.name}`);
            console.log(`  Runner Type : ${envInfo.runner}`);
            console.log(`  Device      : ${envInfo.device}`);
            console.log(`  Isolation   : ${envInfo.isChroot ? 'Chroot / Container (Root)' : 'PRoot / Native Host'}`);
            console.log(`  Shell       : ${envInfo.shell}`);
            if (envInfo.rootfs) console.log(`  RootFS Path : ${envInfo.rootfs}`);
        }
        return;
    }

    if (cmd === 'ai' || cmd === 'query') {
        const promptText = args.slice(1).join(' ').trim();
        if (!promptText) {
            console.error('Error: Masukkan prompt AI. Contoh: auto-engine ai "Analisa link airdrop ini"');
            process.exit(1);
        }
        const res = await queryTriEngineAi(promptText);
        if (args.includes('--json')) {
            console.log(JSON.stringify(res, null, 2));
        } else {
            console.log(`[${res.engine}]`);
            console.log(res.text || 'Gagal mendapatkan respon dari AI engines.');
        }
        return;
    }

    if (cmd === 'alphas' || cmd === 'scan-alpha') {
        const alphas = getLatestTelegramAlphas(10);
        if (args.includes('--json')) {
            console.log(JSON.stringify(alphas, null, 2));
        } else {
            console.log(`Ditemukan ${alphas.length} sinyal alpha terbaru dari Telegram:`);
            alphas.forEach((a, i) => {
                console.log(`  [${i + 1}] Channel: ${a.channel || 'Unknown'}`);
                if (a.urls.length > 0) console.log(`      URLs: ${a.urls.join(', ')}`);
                if (a.contract_addresses.length > 0) console.log(`      CAs : ${a.contract_addresses.join(', ')}`);
            });
        }
        return;
    }

    if (cmd === 'quest' || cmd === 'alpha' || cmd === 'auto-quest' || cmd === 'whitelist') {
        const questInput = args.slice(1).join(' ').trim();
        if (!questInput) {
            console.error('Error: Masukkan teks pengumuman alpha/whitelist.');
            console.error('Contoh: ai quest "New Whitelist : ELYMPUS\\nRegister: https://..."');
            process.exit(1);
        }
        await executeDynamicAlphaQuest(questInput);
        return;
    }

    if (cmd === 'task' || cmd === 'run') {
        const url = args[1];
        if (!url) {
            console.error('Error: Masukkan URL target. Contoh: auto-engine run https://faucet.base.org --profile shaqilla');
            process.exit(1);
        }
        let profile = 'shaqilla';
        let chain = 'base';
        for (let i = 2; i < args.length; i++) {
            if (args[i] === '--profile' && args[i + 1]) { profile = args[i + 1]; i++; }
            if (args[i] === '--chain' && args[i + 1]) { chain = args[i + 1]; i++; }
        }

        const res = await executeAutonomousTask(url, profile, chain);
        if (args.includes('--json')) {
            console.log(JSON.stringify(res, null, 2));
        } else {
            console.log(`Tugas berhasil dieksekusi:`);
            console.log(`  Target Web : ${res.target_url}`);
            console.log(`  Profil X   : ${res.profile}`);
            console.log(`  AI Engine  : ${res.ai_engine_used}`);
            console.log(`  Wallet     : ${res.wallet}`);
        }
        return;
    }

    if (cmd === 'tab') {
        const sub = args[1] || 'list';
        if (sub === 'list' || sub === 'ls') {
            const isJson = args.includes('--json');
            const res = runCmd(`/usr/local/bin/termux-ipc tab list ${isJson ? '--json' : ''}`);
            console.log(res);
            return;
        }
        if (sub === 'env') {
            const envInfo = detectSystemEnvironment();
            if (args.includes('--json')) {
                console.log(JSON.stringify(envInfo, null, 2));
            } else {
                console.log(`Active System: ${envInfo.name} (${envInfo.runner})`);
            }
            return;
        }
        if (sub === 'open' || sub === 'new') {
            const name = args[2];
            if (!name) {
                console.error('Error: Masukkan nama tab. Contoh: ai tab open worker --chroot "python3 worker.py"');
                process.exit(1);
            }
            let envOpt = '';
            const remaining = [];
            for (let i = 3; i < args.length; i++) {
                if (args[i] === '--chroot' || args[i] === '-c') envOpt = '--chroot';
                else if (args[i] === '--proot' || args[i] === '-p') envOpt = '--proot';
                else if (args[i] === '--native' || args[i] === '--termux' || args[i] === '-n') envOpt = '--native';
                else if (args[i] === '--env' && args[i + 1]) { envOpt = `--env ${args[i + 1]}`; i++; }
                else remaining.push(args[i]);
            }
            const command = remaining.join(' ');
            if (command.startsWith('http://') || command.startsWith('https://')) {
                const res = runCmd(`/usr/local/bin/termux-ipc webview new-tab ${command}`);
                console.log(`Tab web dibuka: ${command}`);
            } else {
                const res = runCmd(`/usr/local/bin/termux-ipc tab new "${name}" ${envOpt} ${command}`.trim());
                console.log(res);
            }
            return;
        }
        if (sub === 'close' || sub === 'kill') {
            const target = args[2] || 'current';
            const res = runCmd(`/usr/local/bin/termux-ipc tab close "${target}"`);
            console.log(res);
            return;
        }
        if (sub === 'focus' || sub === 'switch') {
            const target = args[2];
            if (!target) {
                console.error('Error: Masukkan target tab (nama, ID, atau index). Contoh: ai tab focus worker');
                process.exit(1);
            }
            const res = runCmd(`/usr/local/bin/termux-ipc tab focus "${target}"`);
            console.log(res);
            return;
        }
        if (sub === 'rename') {
            const target = args[2];
            const newName = args[3];
            if (!target || !newName) {
                console.error('Penggunaan: ai tab rename <target> <nama-baru>');
                process.exit(1);
            }
            const res = runCmd(`/usr/local/bin/termux-ipc tab rename "${target}" "${newName}"`);
            console.log(res);
            return;
        }
        console.log(`Usage: ai tab [list|open|close|focus|rename]`);
        return;
    }

    if (cmd === 'x-post' || cmd === 'tweet') {
        const text = args.slice(1).join(' ').trim();
        if (!text) {
            console.error('Error: Masukkan teks tweet.');
            process.exit(1);
        }
        const res = postToX(text, 'shaqilla');
        console.log(res || 'Tweet diproses.');
        return;
    }

    if (cmd === '--help' || cmd === 'help') {
        console.log(`AUTONOMOUS TRI-ENGINE FUSION (Command: ai)
Usage:
  ai [status] [--json]                 (Cek status 3 AI engines & 3 mesin lapangan)
  ai "<pertanyaan / prompt>"           (Tanya langsung ke Tri-Engine AI)
  ai tab list [--json]                 (Daftar seluruh tab terminal aktif)
  ai tab open <nama> [cmd|url]         (Buka tab baru dengan nama khusus)
  ai tab close <nama|id|current>       (Tutup tab secara akurat berdasarkan nama)
  ai tab focus <nama|id>               (Pindah fokus ke tab target)
  ai scan-alpha [--json]               (Ekstrak sinyal airdrop & CA terbaru dari Telegram)
  ai quest "<teks postingan>"          (Eksekusi tugas whitelist/airdrop dinamis untuk 3 wallet)
  ai run <url> [--profile <name>]      (Otomasi tugas Web3: Web + Wallet + X + AI)
  ai x-post "<text>"                   (Posting tweet via profil aktif)
`);
        return;
    }

    // Smart fallback: Jika input mengandung kata kunci airdrop/whitelist & link, otomatis jalankan Dynamic Alpha Quest!
    const fullQuery = args.join(' ').trim();
    if (fullQuery) {
        if (fullQuery.match(/whitelist|airdrop|register:|🪂|faucet/i) && fullQuery.includes('http')) {
            console.log('[AI Auto-Detector] Terdeteksi postingan tugas airdrop/whitelist! Menjalankan Dynamic Alpha Quest...');
            await executeDynamicAlphaQuest(fullQuery);
            return;
        }
        const res = await queryTriEngineAi(fullQuery);
        if (args.includes('--json')) {
            console.log(JSON.stringify(res, null, 2));
        } else {
            console.log(`[${res.engine}]`);
            console.log(res.text || 'Gagal mendapatkan respon dari AI engines.');
        }
        return;
    }

    console.log(`AUTONOMOUS TRI-ENGINE FUSION (Command: ai)
Usage:
  ai [status] [--json]                 (Cek status 3 AI engines & 3 mesin lapangan)
  ai "<pertanyaan / prompt>"           (Tanya langsung ke Tri-Engine AI)
  ai quest "<teks postingan>"          (Eksekusi tugas whitelist/airdrop dinamis untuk 3 wallet)
  ai tab list [--json]                 (Daftar seluruh tab terminal aktif)
  ai tab open <nama> [cmd|url]         (Buka tab baru dengan nama khusus)
  ai tab close <nama|id|current>       (Tutup tab secara akurat berdasarkan nama)
  ai tab focus <nama|id>               (Pindah fokus ke tab target)
  ai scan-alpha [--json]               (Ekstrak sinyal airdrop & CA terbaru dari Telegram)
  ai run <url> [--profile <name>]      (Otomasi tugas Web3: Web + Wallet + X + AI)
  ai x-post "<text>"                   (Posting tweet via profil aktif)
`);
}

module.exports = {
    queryTriEngineAi,
    executeAutonomousTask,
    executeDynamicAlphaQuest,
    getWalletInfo
};

if (require.main === module) {
    main().catch(err => {
        console.error(`Error: ${err.message}`);
        process.exit(1);
    });
}

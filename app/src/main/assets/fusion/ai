// 2A. Telegram Sniper Query
function getLatestTelegramAlphas(limit = 5) {
    const results = [];
    if (!fs.existsSync(TELE_DB_PATH)) return results;

    try {
        const cmd = `sqlite3 -json "${TELE_DB_PATH}" "SELECT content_hash, extracted_item, channel_id, created_at FROM history ORDER BY created_at DESC LIMIT ${limit};"`;
        const raw = runCmd(cmd);
        if (raw && raw.startsWith('[')) {
            const parsed = JSON.parse(raw);
            for (const item of parsed) {
                let ext = item.extracted_item;
                let links = [];
                let cas = [];
                if (typeof ext === 'string') {
                    const urlMatches = ext.match(/https?:\/\/[^\s"'<>]+/g);
                    if (urlMatches) links = urlMatches;
                    const caMatches = ext.match(/0x[a-fA-F0-9]{40}/g);
                    if (caMatches) cas = caMatches;
                }
                results.push({
                    id: item.content_hash,
                    channel: item.channel_id,
                    content: ext,
                    urls: links,
                    contract_addresses: cas,
                    created_at: item.created_at
                });
            }
        }
    } catch (_) {}
    return results;
}

// 2B. Wallet Daemon Bridge (Port 3333)
function getWalletInfo() {
    let master = null;
    let totalWallets = 0;
    try {
        if (fs.existsSync(WALLETS_DB_FILE)) {
            const w = JSON.parse(fs.readFileSync(WALLETS_DB_FILE, 'utf8'));
            totalWallets = w.wallets ? w.wallets.length : 0;
            const idx = w.master_index || 0;
            master = w.wallets && w.wallets[idx] ? { name: w.wallets[idx].name, address: w.wallets[idx].address } : null;
        }
    } catch (_) {}

    // Check daemon port 3333
    const isDaemonAlive = runCmd('curl -s http://127.0.0.1:3333/status 2>/dev/null || echo "DEAD"').includes('OK') || 
                          runCmd('netstat -tlpn 2>/dev/null | grep :3333 || ss -tlpn 2>/dev/null | grep :3333').includes('3333');

    return {
        master_wallet: master,
        total_wallets: totalWallets,
        daemon_port: 3333,
        daemon_running: Boolean(isDaemonAlive)
    };
}


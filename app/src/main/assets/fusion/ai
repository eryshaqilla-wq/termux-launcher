                        shell: '/bin/bash'
                    };
                }
            }
        } catch (_) {}
    }
    if (process.env.PREFIX && process.env.PREFIX.includes('com.termux')) {
        return {
            type: 'native',
            runner: 'RunnerType.NATIVE_TERMUX',
            name: 'Native Android Termux',

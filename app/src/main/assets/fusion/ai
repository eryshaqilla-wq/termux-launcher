    }
    if (fs.existsSync('/data/local/nhsystem/kali-arm64')) {
        return {
            type: 'chroot',
            runner: 'RunnerType.NETHUNTER',
            name: 'Kali NetHunter Chroot',
            device: 'Infinix Note 30 VIP',
            isChroot: true,
            isRoot: true,
            shell: '/bin/zsh',
            rootfs: '/data/local/nhsystem/kali-arm64'
        };
    }
    return {
        type: 'native',
        runner: 'RunnerType.NATIVE_TERMUX',
        name: 'Native Android Termux',
        device: 'Android Host',
        isChroot: false,
        isRoot: false,
        shell: '/data/data/com.termux/files/usr/bin/bash'
    };
}

// 2C. X & Web Controller (Native HTTP & Agent Web Fallback)
function openWebPage(url, profile = 'shaqilla', tabName = null) {
    const normUrl = (url.startsWith('http://') || url.startsWith('https://') || url.startsWith('file://')) ? url : `https://${url}`;
    const targetTab = tabName || `web-${profile}`;
    const ipcBin = fs.existsSync('/usr/local/bin/termux-ipc') ? '/usr/local/bin/termux-ipc' : 'termux-ipc';
    // ATURAN BAKU: Jangan buka WebView di tab AGY aktif. Selalu buka di tab baru mandiri!
    return runCmd(`${ipcBin} tab new "${targetTab}" "termux-ipc webview --profile ${profile} ${normUrl}"`);
}

function postToX(text, profile = 'shaqilla') {
    // Utamakan X Native Engine (Zero-Browser, 100% Akurat)
    const xNativePath = path.join(WALLET_DIR, 'x_native.cjs');
    if (fs.existsSync(xNativePath)) {
        try {
            const out = runCmd(`node "${xNativePath}" tweet "${text.replace(/"/g, '\\"')}" --profile "${profile}"`);
            return out;
        } catch (_) {}
    }
    const agentWebBin = fs.existsSync('/usr/local/bin/agent-web') ? '/usr/local/bin/agent-web' : path.join(WALLET_DIR, 'agent-web');
    return runCmd(`${agentWebBin} x-post "${text.replace(/"/g, '\\"')}" --profile "${profile}"`);
}

function getWebSnapshot() {
    const agentWebBin = fs.existsSync('/usr/local/bin/agent-web') ? '/usr/local/bin/agent-web' : path.join(WALLET_DIR, 'agent-web');
    return runCmd(`${agentWebBin} snapshot`);
}


function getAllWallets() {
    try {
        if (fs.existsSync(WALLETS_DB_FILE)) {
            const data = JSON.parse(fs.readFileSync(WALLETS_DB_FILE, 'utf8'));
            const list = (data.wallets || []).map((w, idx) => ({
                index: idx,
                name: w.name || `Wallet ${idx + 1}`,
                address: w.address,
                is_master: idx === (data.master_index || 0)
            }));
            return {
                master_index: data.master_index || 0,
                wallets: list
            };
        }
    } catch (_) {}
    return { master_index: 0, wallets: [] };
}

function switchMasterWallet(index) {
    try {
        if (fs.existsSync(WALLETS_DB_FILE)) {
            const data = JSON.parse(fs.readFileSync(WALLETS_DB_FILE, 'utf8'));
            data.master_index = parseInt(index, 10);
            fs.writeFileSync(WALLETS_DB_FILE, JSON.stringify(data, null, 2), 'utf8');
            log(`[Wallet] Master wallet switched to index ${index}`);
            return true;
        }
    } catch (_) {}
    return false;
}

function getAllTelegramAccounts() {
    const list = [];
    if (!fs.existsSync(TELE_DB_PATH)) return list;
    try {
        const raw = runCmd(`sqlite3 -json "${TELE_DB_PATH}" "SELECT id, phone, name, role, status FROM accounts;"`);
        if (raw && raw.startsWith('[')) {
            return JSON.parse(raw);
        }
    } catch (_) {}
    return list;
}


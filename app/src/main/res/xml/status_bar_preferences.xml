<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/settings_status_clock_header">
        <SwitchPreferenceCompat
            app:key="top_pane_clock_am_pm"
            app:title="@string/settings_use_12_hour_title"
            app:summary="@string/settings_use_12_hour_summary"
            app:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_status_expanded_header">
        <ListPreference
            app:key="status_bar_expanded_mode"
            app:title="@string/settings_status_expanded_mode_title"
            app:entries="@array/settings_status_expanded_mode_entries"
            app:entryValues="@array/settings_status_expanded_mode_values"
            app:defaultValue="clock"
            app:useSimpleSummaryProvider="true" />
        <Preference
            app:key="edit_status_bar_extra_keys"
            app:persistent="false"
            app:fragment="com.termux.app.fragments.settings.termux.ExtraKeysEditorFragment"
            app:title="@string/settings_edit_status_bar_extra_keys_title"
            app:summary="@string/settings_edit_status_bar_extra_keys_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_status_gestures_header">
        <ListPreference
            app:key="status_bar_horizontal_swipe_action"
            app:title="@string/settings_status_bar_horizontal_swipe_title"
            app:entries="@array/settings_status_bar_horizontal_swipe_entries"
            app:entryValues="@array/settings_status_bar_horizontal_swipe_values"
            app:defaultValue="wall"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_status_indicators_header">
        <SwitchPreferenceCompat
            app:key="status_widget_cpu"
            app:title="@string/settings_cpu_usage_title"
            app:summary="@string/termux_status_widget_cpu_summary"
            app:defaultValue="false" />
        <SwitchPreferenceCompat
            app:key="status_widget_ram"
            app:title="@string/settings_memory_usage_title"
            app:summary="@string/settings_memory_usage_summary"
            app:defaultValue="false" />
        <SwitchPreferenceCompat
            app:key="status_widget_battery"
            app:title="@string/settings_battery_temp_title"
            app:summary="@string/settings_battery_temp_summary"
            app:defaultValue="true" />
        <SwitchPreferenceCompat
            app:key="status_widget_media"
            app:title="@string/settings_status_media_title"
            app:summary="@string/settings_status_media_summary"
            app:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_status_weather_header">
        <SwitchPreferenceCompat
            app:key="status_widget_weather"
            app:title="@string/settings_weather_title"
            app:summary="@string/settings_weather_summary"
            app:defaultValue="true" />
        <SwitchPreferenceCompat
            app:key="status_widget_weather_fahrenheit"
            app:title="@string/settings_weather_fahrenheit_title"
            app:summary="@string/settings_weather_fahrenheit_summary"
            app:defaultValue="false"
            app:dependency="status_widget_weather" />
        <Preference
            app:key="status_widget_weather_location"
            app:persistent="false"
            app:title="@string/settings_weather_location_title"
            app:summary="@string/settings_weather_location_summary_device"
            app:dependency="status_widget_weather" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_status_more_header">
        <Preference
            app:key="status_bar_notifications_link"
            app:persistent="false"
            app:title="@string/settings_destination_notifications"
            app:summary="@string/settings_status_bar_notifications_link_summary"
            app:fragment="com.termux.app.fragments.settings.termux.NotificationsPreferencesFragment" />
    </PreferenceCategory>

</PreferenceScreen>
